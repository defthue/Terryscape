@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@inherits PanelComponent

<root>
	@foreach ( var boss in GetVisibleBosses() )
	{
		@if ( IsInFrontOfCamera( boss ) )
		{
			var screenPos = GetScreenPosition( boss );
			bool protectedNow = HasProtectedPillar( boss );
			<div class="boss-plate" style="left: @(screenPos.x.ToString("0.##"))%; top: @(screenPos.y.ToString("0.##"))%;">
				<div class="boss-crown">♛</div>
				<div class="boss-name">@(boss.BossName)</div>
				<div class="boss-bar-frame">
					<div class="boss-bar-cap left"></div>
					<div class="boss-bar-bg">
						<div class="boss-bar-fill @(protectedNow ? "protected-fill" : "")" style="width: @(GetHealthPercent( boss ))%;"></div>
						<div class="boss-bar-text">@(boss.CurrentHealth) / @(boss.MaxHealth)</div>
					</div>
					<div class="boss-bar-cap right"></div>
				</div>
				@if ( protectedNow )
				{
					<div class="boss-protected">✦ PROTECTED ✦</div>
				}
			</div>
		}
	}
</root>

@code
{
	const float VisibilityRange = 1500f;

	System.Collections.Generic.List<Boss> GetVisibleBosses()
	{
		var player = PlayerHelper.GetLocalPlayer();
		if ( player == null )
			return new();

		var playerPos = player.WorldPosition;
		var bosses = Scene?.GetAllComponents<Boss>().ToList() ?? new();

		return bosses.FindAll( b =>
			b != null &&
			!b.IsDead &&
			Vector3.DistanceBetween( b.WorldPosition, playerPos ) <= VisibilityRange
		);
	}

	Vector2 GetScreenPosition( Boss boss )
	{
		var worldPos = boss.WorldPosition + Vector3.Up * 160f;
		var normal = Scene.Camera.PointToScreenNormal( worldPos );
		return new Vector2( normal.x * 100f, normal.y * 100f );
	}

	bool IsInFrontOfCamera( Boss boss )
	{
		var toBoss = boss.WorldPosition - Scene.Camera.WorldPosition;
		return Vector3.Dot( Scene.Camera.WorldRotation.Forward, toBoss ) > 0;
	}

	int GetHealthPercent( Boss boss )
	{
		if ( boss.MaxHealth <= 0 ) return 0;
		return (int)( ( (float)boss.CurrentHealth / boss.MaxHealth ) * 100f );
	}

	bool HasProtectedPillar( Boss boss )
	{
		if ( boss.Pillars == null )
			return false;

		foreach ( var pillar in boss.Pillars )
		{
			if ( pillar != null && pillar.IsAlive )
				return true;
		}
		return false;
	}

	protected override void OnUpdate()
	{
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		int hash = 0;
		foreach ( var b in GetVisibleBosses() )
		{
			var pos = GetScreenPosition( b );
			hash = ( hash, b.CurrentHealth, b.MaxHealth, b.IsDead, HasProtectedPillar( b ), (int)pos.x, (int)pos.y ).GetHashCode();
		}
		return hash;
	}
}
