@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="wel-backdrop"></div>
		<div class="wel-popup">
			<div class="wel-header">
				<div class="wel-title">Welcome to Terry's Quest</div>
				<div class="wel-close" onclick="@(() => CloseHud())">✕</div>
			</div>

			<div class="wel-body">
				<div class="wel-rail">
					<div class="wel-rail-label">GUIDE</div>

					@for ( int i = 0; i < ChapterNames.Length; i++ )
					{
						int chapterLocal = i;
						<div class="wel-chapter @(Chapter == chapterLocal ? "selected" : "")" onclick="@(() => SelectChapter( chapterLocal ))">@ChapterNames[chapterLocal]</div>
					}

					<div class="wel-rail-spacer"></div>

					<div class="wel-start" onclick="@(() => CloseHud())">Start playing</div>
					<div class="wel-start-hint">Press H to reopen anytime</div>
				</div>

				<div class="wel-content">
					@if ( Chapter == 0 )
					{
						<div class="wel-heading">Welcome, adventurer</div>
						<div class="wel-text">Thank you for playing our game! Terry's Quest is a multiplayer RPG where you'll gather, craft, fight, and explore a fantasy world with friends.</div>

						<div class="wel-section-label">CONTROLS</div>
						<div class="wel-controls">
							<div class="wel-controls-col">
								@for ( int i = 0; i < ControlsHalf; i++ )
								{
									<div class="wel-control">
										<div class="wel-key">@Controls[i].Key</div>
										<div class="wel-action">@Controls[i].Action</div>
									</div>
								}
							</div>
							<div class="wel-controls-col">
								@for ( int i = ControlsHalf; i < Controls.Length; i++ )
								{
									<div class="wel-control">
										<div class="wel-key">@Controls[i].Key</div>
										<div class="wel-action">@Controls[i].Action</div>
									</div>
								}
							</div>
						</div>
					}

					@if ( Chapter == 1 )
					{
						<div class="wel-heading">Gather & Craft</div>
						<div class="wel-text">Walk up to a resource node — trees, rocks, ore veins, herbs — and left click to start gathering. Items are added to your inventory automatically.</div>

						<div class="wel-tip-block">
							<div class="wel-tip-title">Quests unlock new recipes</div>
							<div class="wel-tip">Look for NPCs with a glowing marker above them.</div>
							<div class="wel-tip">Completing quests is how you unlock new crafting recipes — without quests, you can't progress your crafting!</div>
						</div>

						<div class="wel-section-label">CRAFTING STATIONS</div>
						<div class="wel-text">Once you've unlocked a recipe, head to the matching station to craft it:</div>

						@foreach ( var station in Stations )
						{
							<div class="wel-row">
								<div class="wel-row-name">@station.Name</div>
								<div class="wel-row-desc">@station.Desc</div>
							</div>
						}
					}

					@if ( Chapter == 2 )
					{
						<div class="wel-heading">World & Travel</div>

						<div class="wel-section-label">TELEPORT STONES</div>
						<div class="wel-text">Discover teleport stones scattered across the world. Walk up to one and press E to activate it.</div>
						<div class="wel-text">Once activated, you can fast-travel between any stones you've found. Stay alert — finding new ones unlocks faster routes through the map.</div>

						<div class="wel-tip-block">
							<div class="wel-tip-title">Your progress is saved</div>
							<div class="wel-tip">Your inventory, skills, completed quests, unlocked recipes, and discovered teleport stones follow you across any Terry's Quest server.</div>
							<div class="wel-tip">Log out anytime — your stuff comes with you.</div>
						</div>
					}

					@if ( Chapter == 3 )
					{
						<div class="wel-heading">Join the Community</div>
						<div class="wel-text">Terry's Quest has an active Discord community. Join us to chat with other players, get help, share builds and screenshots, find people to play with, report bugs, and stay up to date on what's coming next.</div>

						<div class="wel-discord" onclick="@(() => OnDiscordClick())">
							<div class="wel-discord-icon">💬</div>
							<div class="wel-discord-text">
								<div class="wel-discord-title">@DiscordButtonText</div>
								<div class="wel-discord-url">discord.gg/DvtnhwQpMY</div>
							</div>
						</div>

						<div class="wel-tip-block">
							<div class="wel-tip-title">Why join?</div>
							<div class="wel-tip">Get help from experienced players when you're stuck</div>
							<div class="wel-tip">Find groups for quests, dungeons, and bosses</div>
							<div class="wel-tip">Report bugs directly to the developers</div>
							<div class="wel-tip">See what's coming in the next update</div>
						</div>

						<div class="wel-final">Have fun, adventurer.</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	const string DiscordUrl = "https://discord.gg/DvtnhwQpMY";

	static readonly string[] ChapterNames = { "Welcome & Controls", "Gather & Craft", "World & Travel", "Community" };

	static int ControlsHalf => ( Controls.Length + 1 ) / 2;

	static readonly (string Key, string Action)[] Controls =
	{
		( "WASD", "Move" ),
		( "LEFT CLICK", "Attack / Gather" ),
		( "RIGHT CLICK", "Secondary / Cast spell" ),
		( "SPACE", "Jump" ),
		( "SHIFT", "Run" ),
		( "E", "Interact / Mount" ),
		( "Q", "Inventory / Close menus" ),
		( "F", "Cycle hotbar" ),
		( "1 – 5", "Hotbar slots" ),
		( "T", "Chat" ),
		( "M", "World map" ),
		( "J", "Guidebook" ),
		( "B", "Spellbook" ),
		( "P", "Pets" ),
		( "L", "Leaderboard" ),
		( "R", "Recall to spawn" ),
		( "C", "First / Third person" ),
		( "H", "This guide" )
	};

	static readonly (string Name, string Desc)[] Stations =
	{
		( "🔥 Furnace", "Smelt raw ores into bars" ),
		( "⚒ Anvil", "Forge weapons, armor, and tools" ),
		( "🧪 Alchemy Table", "Brew potions" ),
		( "🧵 Workbench", "Craft rings, amulets, and accessories" ),
		( "🔮 Enchanting Altar", "Enchant rings and amulets" )
	};

	int Chapter { get; set; } = 0;

	bool IsOpen
	{
		get => WelcomeHudState.IsOpen;
		set => WelcomeHudState.IsOpen = value;
	}

	bool CopiedToClipboard { get; set; } = false;

	string DiscordButtonText => CopiedToClipboard ? "Copied! Paste in your browser" : "Click to copy invite link";

	protected override void OnStart()
	{
		IsOpen = true;
		Mouse.Visibility = MouseVisibility.Visible;
	}

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Help" ) )
		{
			if ( IsOpen )
			{
				CloseHud();
			}
			else
			{
				IsOpen = true;
				Mouse.Visibility = MouseVisibility.Visible;
			}
		}
	}

	void SelectChapter( int chapter )
	{
		Chapter = chapter;
	}

	void CloseHud()
	{
		IsOpen = false;
		Mouse.Visibility = MouseVisibility.Hidden;

		PlayerGatherResource.ForceCloseUI();
	}

	void OnDiscordClick()
	{
		Clipboard.SetText( DiscordUrl );
		CopiedToClipboard = true;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine( IsOpen, Chapter, CopiedToClipboard );
	}
}
