@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="gb-backdrop" onclick="@(() => CloseJournal())"></div>
		<div class="gb-popup">
			<div class="gb-header">
				<div class="gb-title">Guidebook</div>
				<div class="gb-close" onclick="@(() => CloseJournal())">✕</div>
			</div>

			<div class="gb-body">
				<div class="gb-sidebar">
					<div class="gb-section-label">QUESTS</div>
					<div class="gb-nav @(Page == 0 ? "active" : "")" onclick="@(() => SetPage( 0 ))">
						<div class="gb-nav-icon">📜</div>
						<div class="gb-nav-name">Journal</div>
						<div class="gb-nav-level">@($"{AvailableQuests.Count} active")</div>
					</div>

					<div class="gb-section-label skills">SKILLS</div>
					@foreach ( var s in SidebarSkills )
					{
						var sLocal = s;
						<div class="gb-nav skill @(Page == (int)sLocal.Skill ? "active" : "")" onclick="@(() => SetPage( (int)sLocal.Skill ))">
							<div class="gb-nav-icon">@sLocal.Icon</div>
							<div class="gb-nav-mid">
								<div class="gb-nav-toprow">
									<div class="gb-nav-name">@sLocal.Name</div>
									<div class="gb-nav-level">@sLocal.Level</div>
								</div>
								<div class="gb-nav-xp">
									<div class="gb-nav-xp-fill" style="width: @sLocal.XpPercent%;"></div>
								</div>
							</div>
						</div>
					}
				</div>

				<div class="gb-content">
					@if ( Page == 0 )
					{
						@if ( !string.IsNullOrEmpty( QuestTracker.TrackedQuestId ) )
						{
							<div class="gb-tracking">
								<div class="gb-tracking-label">Tracking: @GetTrackingLabel()</div>
								<div class="gb-tracking-clear" onclick="@(() => UntrackQuest())">✕</div>
							</div>
						}

						<div class="gb-tab-row">
							<div class="gb-tab @(Tab == 0 ? "active" : "")" onclick="@(() => SetTab( 0 ))">@($"Available: {AvailableQuests.Count}")</div>
							<div class="gb-tab @(Tab == 1 ? "active" : "")" onclick="@(() => SetTab( 1 ))">@($"Completed: {CompletedQuests.Count}")</div>
							<div class="gb-tab-spacer"></div>
							<TextEntry class="gb-search" Value:bind="@Search" Placeholder="Search quests"></TextEntry>
						</div>

						@if ( CategoryList.Count > 0 )
						{
							<div class="gb-cat-row">
								@foreach ( var cat in CategoryList )
								{
									var catLocal = cat;
									int count = CountInCategory( catLocal );
									<div class="gb-cat @(SelectedCategory == catLocal ? "active" : "")" onclick="@(() => SelectCategory( catLocal ))">@($"{catLocal}: {count}")</div>
								}
							</div>
						}

						<div class="gb-quest-scroll">
							@{ var visible = GetVisibleQuests(); }
							@if ( visible.Count == 0 )
							{
								<div class="gb-empty">
									@if ( Tab == 0 )
									{
										<text>No active quests match here.</text>
									}
									else
									{
										<text>No completed quests match here.</text>
									}
								</div>
							}

							@foreach ( var quest in visible )
							{
								var questLocal = quest;
								bool expanded = ExpandedQuestId == questLocal.QuestId;
								bool tracked = QuestTracker.IsTracking( questLocal.QuestId );
								string chain = Tab == 0 ? ChainHint( questLocal ) : null;

								<div class="gb-card @(tracked ? "tracked" : "") @(Tab == 1 ? "done" : "")">
									<div class="gb-card-head">
										@if ( Tab == 1 )
										{
											<div class="gb-star complete">✓</div>
										}
										else if ( tracked )
										{
											<div class="gb-star on" onclick="@(() => UntrackQuest())">⭐</div>
										}
										else
										{
											<div class="gb-star" onclick="@(() => TrackQuest( questLocal.QuestId ))">☆</div>
										}

										<div class="gb-card-titles" onclick="@(() => ToggleExpanded( questLocal.QuestId ))">
											<div class="gb-card-title">@questLocal.GetJournalTitle()</div>
											<div class="gb-card-cat">@(string.IsNullOrEmpty( GetCategoryFor( questLocal ) ) ? questLocal.NpcName : $"{GetCategoryFor( questLocal )} · {questLocal.NpcName}")</div>
										</div>

										@if ( Tab == 0 )
										{
											@if ( tracked )
											{
												<div class="gb-locate tracking" onclick="@(() => UntrackQuest())">Tracking ✓</div>
											}
											else
											{
												<div class="gb-locate" onclick="@(() => TrackQuest( questLocal.QuestId ))">Track</div>
											}
										}
									</div>

									@if ( chain != null )
									{
										<div class="gb-chain">@($"Locked behind: {chain}")</div>
									}

									@if ( expanded )
									{
										<div class="gb-card-body">
											@if ( !string.IsNullOrEmpty( questLocal.DialogueOffer ) )
											{
												<div class="gb-quest-text">@questLocal.DialogueOffer</div>
											}

											@{
												var requiredItems = questLocal.GetRequiredItems();
												var requiredKills = questLocal.GetRequiredKills();
											}
											@if ( requiredItems.Count > 0 || requiredKills.Count > 0 )
											{
												<div class="gb-detail-label">REQUIREMENTS</div>
												<div class="gb-chip-row">
													@foreach ( var req in requiredItems )
													{
														var name = GetItemName( req.Item );
														var have = GetPlayerItemCount( req.Item );
														bool met = Tab == 1 || have >= req.Amount;
														<div class="gb-chip @(met ? "met" : "unmet")">@ChipText( name, have, req.Amount, met )</div>
													}
													@foreach ( var req in requiredKills )
													{
														var have = GetPlayerKillCount( req.MonsterType );
														bool met = Tab == 1 || have >= req.Amount;
														<div class="gb-chip @(met ? "met" : "unmet")">@ChipText( req.MonsterType, have, req.Amount, met )</div>
													}
												</div>
											}

											@{
												var rewardItems = questLocal.GetRewardItems();
												var recipeNames = questLocal.GetUnlockedRecipeNames();
											}
											@if ( rewardItems.Count > 0 || recipeNames.Count > 0 )
											{
												<div class="gb-detail-label">REWARDS</div>

												@if ( rewardItems.Count > 0 )
												{
													<div class="gb-reward-row">
														@foreach ( var reward in rewardItems )
														{
															var name = GetItemName( reward.Item );
															var label = reward.Amount > 1 ? $"{name} x{reward.Amount}" : name;
															<div class="gb-reward-chip">
																<img class="gb-reward-img" src="@GetIconPath( reward.Item )" />
																<div class="gb-reward-name">@label</div>
															</div>
														}
													</div>
												}

												@foreach ( var recipeName in recipeNames )
												{
													<div class="gb-recipe-line">@($"📜 Recipe: {recipeName}")</div>
												}
											}
										</div>
									}
								</div>
							}
						</div>
					}
					else
					{
						<div class="gb-skill-header">
							<div class="gb-skill-icon">@GetSkillIcon( CurrentSkill )</div>
							<div class="gb-skill-info">
								<div class="gb-skill-toprow">
									<div class="gb-skill-name">@CurrentSkill.ToString()</div>
									<div class="gb-skill-level">@($"Level {SkillHeaderLevel}")</div>
								</div>
								<div class="gb-skill-xp-row">
									<div class="gb-skill-xp-bar">
										<div class="gb-skill-xp-fill" style="width: @SkillXpPercent%;"></div>
									</div>
									<div class="gb-skill-xp-text">@($"{SkillXp} / {SkillXpRequired} XP")</div>
								</div>
							</div>
						</div>

						<div class="gb-skill-scroll">
							@if ( SkillRows.Count == 0 )
							{
								<div class="gb-empty">No unlocks to show for this skill yet.</div>
							}

							@foreach ( var row in SkillRows )
							{
								var rowLocal = row;
								<div class="gb-unlock-row @UnlockRowClass( rowLocal )">
									<div class="gb-unlock-lvchip @(rowLocal.CurrentLevel >= rowLocal.Level ? "" : "low")">@rowLocal.Level</div>
									<div class="gb-unlock-mid">
										<div class="gb-unlock-name">@rowLocal.Name</div>
										@if ( !string.IsNullOrEmpty( rowLocal.Detail ) )
										{
											<div class="gb-unlock-detail">@rowLocal.Detail</div>
										}
									</div>
									<div class="gb-unlock-right">
										@if ( rowLocal.RowKind == 2 )
										{
											@if ( QuestTracker.IsTracking( rowLocal.QuestId ) )
											{
												<div class="gb-locate tracking" onclick="@(() => UntrackQuest())">Tracking ✓</div>
											}
											else
											{
												<div class="gb-locate" onclick="@(() => TrackQuest( rowLocal.QuestId ))">Locate</div>
											}
											<div class="gb-locate-quest">@rowLocal.QuestLabel</div>
										}
										else if ( rowLocal.RowKind == 1 )
										{
											<div class="gb-unlock-lock">@($"Lv {rowLocal.CurrentLevel}/{rowLocal.Level}")</div>
										}
										else
										{
											<div class="gb-unlock-check">✓</div>
										}
									</div>
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	static readonly SkillType[] SkillOrder =
	{
		SkillType.Woodcutting, SkillType.Mining, SkillType.Enchanting,
		SkillType.Smithing, SkillType.Crafting, SkillType.Attack,
		SkillType.Defence, SkillType.Archery, SkillType.Magic
	};

	bool IsOpen => JournalStation.IsOpen;
	int Page => JournalStation.PageIndex;

	int Tab { get; set; } = 0;
	string SelectedCategory { get; set; } = "";
	string ExpandedQuestId { get; set; } = "";
	string Search { get; set; } = "";

	Inventory PlayerInventory { get; set; }

	List<NpcInteract> AvailableQuests { get; set; } = new();
	List<NpcInteract> CompletedQuests { get; set; } = new();
	List<string> CategoryList { get; set; } = new();

	List<SidebarSkill> SidebarSkills { get; set; } = new();

	SkillType CurrentSkill { get; set; } = SkillType.Woodcutting;
	List<UnlockRow> SkillRows { get; set; } = new();

	int SkillHeaderLevel { get; set; } = 1;
	int SkillXp { get; set; } = 0;
	int SkillXpRequired { get; set; } = 1;
	int SkillXpPercent { get; set; } = 0;

	class SidebarSkill
	{
		public SkillType Skill;
		public string Name;
		public string Icon;
		public int Level;
		public int XpPercent;
	}

	class UnlockRow
	{
		public int Level;
		public string Name;
		public string Detail = "";
		public int RowKind;
		public int CurrentLevel;
		public NpcInteract Quest;
		public string QuestId = "";
		public string QuestLabel = "";
		public EquipSlot Slot = EquipSlot.None;
		public int Tier;
	}

	void SetPage( int page )
	{
		JournalStation.PageIndex = page;
		ExpandedQuestId = "";
	}

	void SetTab( int tab )
	{
		Tab = tab;
		ExpandedQuestId = "";
	}

	void SelectCategory( string cat )
	{
		SelectedCategory = cat;
		ExpandedQuestId = "";
	}

	void ToggleExpanded( string questId )
	{
		if ( ExpandedQuestId == questId )
			ExpandedQuestId = "";
		else
			ExpandedQuestId = questId;
	}

	void CloseJournal()
	{
		JournalStation.Close();
	}

	void TrackQuest( string questId )
	{
		QuestTracker.Track( questId );
	}

	void UntrackQuest()
	{
		QuestTracker.Untrack();
	}

	string GetTrackingLabel()
	{
		return QuestTracker.GetResolvedLabel( Scene );
	}

	string ChipText( string name, int have, int amount, bool met )
	{
		if ( met )
			return $"✓ {name} {amount}/{amount}";

		return $"{name} {have}/{amount}";
	}

	string ChainHint( NpcInteract quest )
	{
		var resolved = QuestTracker.ResolveChain( Scene, quest );
		if ( resolved != null && resolved.QuestId != quest.QuestId )
			return resolved.GetJournalTitle();

		return null;
	}

	string UnlockRowClass( UnlockRow row )
	{
		if ( row.RowKind == 2 )
			return "gated";

		if ( row.RowKind == 1 )
			return "locked";

		return "unlocked";
	}

	int GetPlayerItemCount( ItemId id )
	{
		return PlayerInventory != null ? PlayerInventory.GetItemCount( id ) : 0;
	}

	int GetPlayerKillCount( string monsterType )
	{
		return PlayerInventory != null ? PlayerInventory.GetKillCount( monsterType ) : 0;
	}

	string GetItemName( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null ? def.Name : id.ToString();
	}

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		return $"/ItemIcons/{id}.vtex";
	}

	string GetSkillIcon( SkillType skill )
	{
		switch ( skill )
		{
			case SkillType.Woodcutting: return "🪓";
			case SkillType.Mining: return "⛏";
			case SkillType.Enchanting: return "🔮";
			case SkillType.Smithing: return "🔨";
			case SkillType.Crafting: return "🧵";
			case SkillType.Attack: return "⚔️";
			case SkillType.Defence: return "🛡";
			case SkillType.Archery: return "🏹";
			case SkillType.Magic: return "✨";
			default: return "?";
		}
	}

	string GetCategoryFor( NpcInteract quest )
	{
		if ( quest == null )
			return "";

		return quest.Category ?? "";
	}

	List<NpcInteract> GetCurrentTabList()
	{
		return Tab == 0 ? AvailableQuests : CompletedQuests;
	}

	int CountInCategory( string cat )
	{
		int count = 0;
		foreach ( var q in GetCurrentTabList() )
		{
			if ( GetCategoryFor( q ) == cat )
				count++;
		}
		return count;
	}

	List<NpcInteract> GetVisibleQuests()
	{
		var filtered = new List<NpcInteract>();
		bool searching = !string.IsNullOrWhiteSpace( Search );
		string needle = searching ? Search.ToLower() : "";

		foreach ( var q in GetCurrentTabList() )
		{
			string cat = GetCategoryFor( q );
			if ( !string.IsNullOrEmpty( SelectedCategory ) && !string.IsNullOrEmpty( cat ) && cat != SelectedCategory )
				continue;

			if ( searching && !q.GetJournalTitle().ToLower().Contains( needle ) )
				continue;

			filtered.Add( q );
		}

		return filtered;
	}

	void RefreshLists()
	{
		AvailableQuests.Clear();
		CompletedQuests.Clear();

		PlayerInventory = PlayerHelper.GetLocalInventory();
		if ( PlayerInventory == null )
		{
			RefreshCategories();
			return;
		}

		var discovered = PlayerInventory.GetDiscoveredQuests();
		if ( discovered == null || discovered.Count == 0 )
		{
			RefreshCategories();
			return;
		}

		foreach ( var npc in Scene.GetAllComponents<NpcInteract>() )
		{
			if ( string.IsNullOrEmpty( npc.QuestId ) )
				continue;

			if ( !discovered.Contains( npc.QuestId ) )
				continue;

			if ( PlayerInventory.IsQuestCompleted( npc.QuestId ) )
				CompletedQuests.Add( npc );
			else
				AvailableQuests.Add( npc );
		}

		RefreshCategories();
	}

	void RefreshCategories()
	{
		var allCategories = new HashSet<string>();

		foreach ( var q in AvailableQuests )
		{
			var cat = GetCategoryFor( q );
			if ( !string.IsNullOrEmpty( cat ) )
				allCategories.Add( cat );
		}

		foreach ( var q in CompletedQuests )
		{
			var cat = GetCategoryFor( q );
			if ( !string.IsNullOrEmpty( cat ) )
				allCategories.Add( cat );
		}

		var sorted = new List<string>( allCategories );
		sorted.Sort();

		CategoryList = sorted;

		if ( CategoryList.Count > 0 && string.IsNullOrEmpty( SelectedCategory ) )
		{
			SelectedCategory = CategoryList[0];
		}

		if ( !string.IsNullOrEmpty( SelectedCategory ) && !CategoryList.Contains( SelectedCategory ) )
		{
			SelectedCategory = CategoryList.Count > 0 ? CategoryList[0] : "";
		}
	}

	void RebuildSidebar()
	{
		SidebarSkills.Clear();

		var skills = PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );

		foreach ( var skill in SkillOrder )
		{
			int percent = 0;
			if ( skills != null )
			{
				int xp = skills.GetXp( skill );
				int required = skills.GetXpRequired( skill );
				percent = required > 0 ? (int)( ( (float)xp / required ) * 100f ) : 0;
				percent = Math.Clamp( percent, 0, 100 );
			}

			SidebarSkills.Add( new SidebarSkill
			{
				Skill = skill,
				Name = skill.ToString(),
				Icon = GetSkillIcon( skill ),
				Level = skills != null ? skills.GetLevel( skill ) : 1,
				XpPercent = percent
			} );
		}
	}

	void BuildSkillHeader( SkillType skill )
	{
		var skills = PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );
		if ( skills == null )
		{
			SkillHeaderLevel = 1;
			SkillXp = 0;
			SkillXpRequired = 1;
			SkillXpPercent = 0;
			return;
		}

		SkillHeaderLevel = skills.GetLevel( skill );
		SkillXp = skills.GetXp( skill );
		SkillXpRequired = skills.GetXpRequired( skill );
		SkillXpPercent = SkillXpRequired > 0 ? (int)( ( (float)SkillXp / SkillXpRequired ) * 100f ) : 0;
	}

	Dictionary<string, NpcInteract> BuildQuestGateMap()
	{
		var map = new Dictionary<string, NpcInteract>();

		foreach ( var npc in Scene.GetAllComponents<NpcInteract>() )
		{
			if ( string.IsNullOrEmpty( npc.UnlocksRecipe ) )
				continue;

			foreach ( var raw in npc.UnlocksRecipe.Split( ',' ) )
			{
				var id = raw.Trim();
				if ( string.IsNullOrEmpty( id ) )
					continue;

				if ( !map.ContainsKey( id ) )
					map[id] = npc;
			}
		}

		return map;
	}

	bool IsHatchetItem( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null && def.Type == ItemType.Tool && def.Name.Contains( "Hatchet" );
	}

	bool IsPickaxeItem( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null && def.Type == ItemType.Tool && def.Name.Contains( "Pickaxe" );
	}

	RecipeDefinition FindRecipeByOutput( ItemId id )
	{
		foreach ( var recipe in RecipeDatabase.GetAll() )
		{
			if ( recipe.OutputItem == id )
				return recipe;
		}

		return null;
	}

	bool TryApplyQuestGate( UnlockRow row, RecipeDefinition recipe, Dictionary<string, NpcInteract> questGate )
	{
		if ( recipe == null )
			return false;

		if ( !questGate.TryGetValue( recipe.Id, out var quest ) || quest == null )
			return false;

		if ( PlayerInventory != null && PlayerInventory.IsRecipeUnlocked( recipe.Id ) )
			return false;

		row.RowKind = 2;
		row.Quest = quest;
		row.QuestId = quest.QuestId;

		var resolved = QuestTracker.ResolveChain( Scene, quest );
		if ( resolved != null && resolved.QuestId != quest.QuestId )
			row.QuestLabel = $"First: {resolved.GetJournalTitle()}";
		else
			row.QuestLabel = quest.GetJournalTitle();

		return true;
	}

	UnlockRow BuildRecipeRow( RecipeDefinition recipe, Dictionary<string, NpcInteract> questGate, int currentLevel )
	{
		var row = new UnlockRow
		{
			Level = recipe.LevelRequired,
			Name = recipe.Name,
			CurrentLevel = currentLevel
		};

		if ( !TryApplyQuestGate( row, recipe, questGate ) )
			row.RowKind = currentLevel >= recipe.LevelRequired ? 0 : 1;

		return row;
	}

	List<UnlockRow> BuildSkillRows( SkillType skill )
	{
		var rows = new List<UnlockRow>();

		var skills = PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );
		int currentLevel = skills != null ? skills.GetLevel( skill ) : 1;

		var questGate = BuildQuestGateMap();

		bool isGathering = skill == SkillType.Woodcutting || skill == SkillType.Mining || skill == SkillType.Enchanting;
		bool hasRecipes = skill == SkillType.Smithing || skill == SkillType.Crafting || skill == SkillType.Enchanting;
		bool isEquipmentSkill = skill == SkillType.Attack || skill == SkillType.Defence || skill == SkillType.Archery || skill == SkillType.Magic;

		if ( isGathering )
		{
			var byItem = new Dictionary<ItemId, ResourceNode>();
			foreach ( var node in Scene.GetAllComponents<ResourceNode>() )
			{
				if ( node.GetSkillType() != skill )
					continue;

				if ( byItem.TryGetValue( node.ResourceItem, out var existing ) )
				{
					if ( node.RequiredLevel < existing.RequiredLevel )
						byItem[node.ResourceItem] = node;
				}
				else
				{
					byItem[node.ResourceItem] = node;
				}
			}

			foreach ( var kv in byItem )
			{
				var node = kv.Value;
				rows.Add( new UnlockRow
				{
					Level = node.RequiredLevel,
					Name = node.GetDisplayName(),
					Detail = node.Tier - 1 > 0 ? $"needs tier {node.Tier - 1}+ tool" : "",
					CurrentLevel = currentLevel,
					RowKind = currentLevel >= node.RequiredLevel ? 0 : 1
				} );
			}

			if ( skill == SkillType.Woodcutting || skill == SkillType.Mining )
			{
				foreach ( var recipe in RecipeDatabase.GetAll() )
				{
					bool matches = skill == SkillType.Woodcutting
						? IsHatchetItem( recipe.OutputItem )
						: IsPickaxeItem( recipe.OutputItem );

					if ( !matches )
						continue;

					rows.Add( BuildRecipeRow( recipe, questGate, currentLevel ) );
				}
			}
		}

		if ( hasRecipes )
		{
			foreach ( var recipe in RecipeDatabase.GetAll() )
			{
				if ( recipe.SkillRequired != skill )
					continue;

				rows.Add( BuildRecipeRow( recipe, questGate, currentLevel ) );
			}
		}

		if ( isEquipmentSkill )
		{
			foreach ( var def in ItemDatabase.GetAll() )
			{
				if ( def.SkillRequired != skill )
					continue;

				if ( def.Slot == EquipSlot.None )
					continue;

				var row = new UnlockRow
				{
					Level = def.LevelRequired,
					Name = def.Name,
					CurrentLevel = currentLevel,
					Slot = def.Slot,
					Tier = def.Tier
				};

				var recipe = FindRecipeByOutput( def.Id );
				if ( TryApplyQuestGate( row, recipe, questGate ) )
				{
					if ( currentLevel < def.LevelRequired )
						row.Detail = $"Lv {currentLevel}/{def.LevelRequired}";
				}
				else
				{
					row.RowKind = currentLevel >= def.LevelRequired ? 0 : 1;
				}

				rows.Add( row );
			}

			if ( skill == SkillType.Magic )
			{
				foreach ( var spell in SpellDatabase.GetAll() )
				{
					rows.Add( new UnlockRow
					{
						Level = spell.RequiredLevel,
						Name = spell.Name,
						Detail = "Spell",
						CurrentLevel = currentLevel,
						RowKind = currentLevel >= spell.RequiredLevel ? 0 : 1
					} );
				}
			}
		}

		rows = GroupRows( rows, skill, currentLevel );

		rows.Sort( ( a, b ) =>
		{
			int cmp = a.Level.CompareTo( b.Level );
			if ( cmp != 0 )
				return cmp;

			return string.Compare( a.Name, b.Name, System.StringComparison.OrdinalIgnoreCase );
		} );
		return rows;
	}

	List<UnlockRow> GroupRows( List<UnlockRow> rows, SkillType skill, int currentLevel )
	{
		var result = new List<UnlockRow>();
		var questBuckets = new Dictionary<string, List<UnlockRow>>();
		var armorBuckets = new Dictionary<(int, int), List<UnlockRow>>();

		foreach ( var row in rows )
		{
			if ( row.RowKind == 2 && !string.IsNullOrEmpty( row.QuestId ) )
			{
				if ( !questBuckets.TryGetValue( row.QuestId, out var questList ) )
				{
					questList = new List<UnlockRow>();
					questBuckets[row.QuestId] = questList;
				}
				questList.Add( row );
				continue;
			}

			if ( IsArmorSlot( row.Slot ) )
			{
				var key = (row.Level, row.Tier);
				if ( !armorBuckets.TryGetValue( key, out var armorList ) )
				{
					armorList = new List<UnlockRow>();
					armorBuckets[key] = armorList;
				}
				armorList.Add( row );
				continue;
			}

			result.Add( row );
		}

		foreach ( var bucket in questBuckets.Values )
		{
			if ( bucket.Count < 2 )
			{
				result.AddRange( bucket );
				continue;
			}

			var first = bucket[0];
			int minLevel = int.MaxValue;
			var names = new List<string>();
			foreach ( var r in bucket )
			{
				minLevel = Math.Min( minLevel, r.Level );
				names.Add( r.Name );
			}

			result.Add( new UnlockRow
			{
				Level = minLevel,
				Name = string.Join( ", ", names ),
				RowKind = 2,
				CurrentLevel = first.CurrentLevel,
				Quest = first.Quest,
				QuestId = first.QuestId,
				QuestLabel = first.QuestLabel
			} );
		}

		foreach ( var bucket in armorBuckets.Values )
		{
			if ( bucket.Count < 2 )
			{
				result.AddRange( bucket );
				continue;
			}

			var names = new List<string>();
			foreach ( var r in bucket )
				names.Add( r.Name );

			string prefix = SharedNamePrefix( names );
			int level = bucket[0].Level;

			result.Add( new UnlockRow
			{
				Level = level,
				Name = string.IsNullOrEmpty( prefix ) ? $"{skill} Armor Set (Lv {level})" : $"{prefix} Armor Set",
				Detail = string.Join( ", ", names ),
				RowKind = currentLevel >= level ? 0 : 1,
				CurrentLevel = currentLevel
			} );
		}

		return result;
	}

	static bool IsArmorSlot( EquipSlot slot )
	{
		return slot == EquipSlot.Shield || slot == EquipSlot.Head || slot == EquipSlot.Chest || slot == EquipSlot.Legs;
	}

	static string SharedNamePrefix( List<string> names )
	{
		var firstWords = names[0].Split( ' ' );
		int common = firstWords.Length;

		for ( int i = 1; i < names.Count; i++ )
		{
			var words = names[i].Split( ' ' );
			int j = 0;
			while ( j < common && j < words.Length && string.Equals( words[j], firstWords[j], StringComparison.OrdinalIgnoreCase ) )
				j++;
			common = j;
			if ( common == 0 )
				return "";
		}

		return string.Join( " ", firstWords, 0, common );
	}

	protected override void OnUpdate()
	{
		if ( IsOpen )
			StateHasChanged();
	}

	protected override int BuildHash()
	{
		if ( IsOpen )
		{
			RefreshLists();
			RebuildSidebar();

			if ( Page >= 1 && Page <= 9 )
			{
				CurrentSkill = (SkillType)Page;
				SkillRows = BuildSkillRows( CurrentSkill );
				BuildSkillHeader( CurrentSkill );
			}
			else
			{
				SkillRows.Clear();
			}
		}

		int reqHash = 0;
		if ( PlayerInventory != null )
		{
			foreach ( var npc in AvailableQuests )
			{
				foreach ( var req in npc.GetRequiredItems() )
					reqHash += PlayerInventory.GetItemCount( req.Item ) * (int)req.Item;

				foreach ( var req in npc.GetRequiredKills() )
					reqHash += PlayerInventory.GetKillCount( req.MonsterType ) * 1000;
			}
		}

		int rowHash = 0;
		foreach ( var r in SkillRows )
			rowHash = HashCode.Combine( rowHash, r.Level, r.Name, r.RowKind, r.CurrentLevel, r.QuestId, QuestTracker.IsTracking( r.QuestId ) );

		int sidebarHash = 0;
		foreach ( var s in SidebarSkills )
			sidebarHash = HashCode.Combine( sidebarHash, (int)s.Skill, s.Level, s.XpPercent );

		int a = HashCode.Combine( IsOpen, Page, Tab, SelectedCategory, ExpandedQuestId, reqHash, rowHash, sidebarHash );
		int b = HashCode.Combine( AvailableQuests.Count, CompletedQuests.Count, CategoryList.Count, QuestTracker.TrackedQuestId ?? "", SkillHeaderLevel, SkillXp, SkillXpRequired );
		return HashCode.Combine( a, b, Search ?? "" );
	}
}
