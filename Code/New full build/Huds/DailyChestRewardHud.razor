@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="reward-backdrop" onclick="@(() => CloseReward())"></div>
		<div class="reward-overlay">
			<div class="reward-popup">
				<div class="reward-header">
					<div class="reward-title">You found a loot chest!</div>
					<div class="reward-close" onclick="@(() => CloseReward())">✕</div>
				</div>

				<div class="reward-subtitle">@ChestName</div>
				<div class="reward-divider"></div>

				<div class="reward-body">
					@if ( GoldAmount > 0 )
					{
						<div class="gold-banner">
							<div class="gold-coin"></div>
							<div class="gold-text">+@GoldText Gold</div>
						</div>
					}

					@if ( ItemRewards.Count > 0 )
					{
						<div class="reward-grid">
							@foreach ( var entry in ItemRewards )
							{
								<div class="reward-slot">
									<div class="reward-icon">
										<img class="reward-icon-img" src="@GetIconPath( entry.Item )" />
										@if ( entry.Amount > 1 )
										{
											<div class="reward-count">@entry.Amount</div>
										}
									</div>
									<div class="reward-name">@GetItemName( entry.Item )</div>
								</div>
							}
						</div>
					}

					@if ( ItemRewards.Count == 0 && GoldAmount == 0 )
					{
						<div class="reward-empty">No items received.</div>
					}
				</div>

				<div class="reward-footer">
					<div class="reward-button" onclick="@(() => CloseReward())">Continue</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	bool IsOpen => DailyChest.RewardHudOpen;
	string ChestName => DailyChest.LastRewardChestName ?? "";
	List<DailyChestRewardEntry> Rewards => DailyChest.LastRewards ?? new List<DailyChestRewardEntry>();

	int GoldAmount => Rewards.Where( r => r.Item == ItemId.GoldCoin ).Sum( r => r.Amount );
	string GoldText => GoldAmount.ToString( "N0" );
	List<DailyChestRewardEntry> ItemRewards => Rewards.Where( r => r.Item != ItemId.GoldCoin ).ToList();

	void CloseReward() => DailyChest.CloseRewardHud();

	string GetItemName( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null ? def.Name : id.ToString();
	}

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None ) return "";
		if ( id == ItemId.Gem ) return "/ItemIcons/FineGem.vtex";
		if ( id == ItemId.Ring ) return "/ItemIcons/FineRing.vtex";
		if ( id == ItemId.Amulet ) return "/ItemIcons/FineAmulet.vtex";
		return $"/ItemIcons/{id}.vtex";
	}

	protected override int BuildHash()
	{
		return ( IsOpen, ChestName, Rewards.Count, GoldAmount ).GetHashCode();
	}
}
