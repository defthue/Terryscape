@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="sidebar-buttons @(InventoryHud.GearTabExpanded ? "gear-shift" : "")">
		<div class="sidebar-button" onclick="@(() => OpenJournal())">
			<div class="sidebar-icon">📜</div>
			<div class="sidebar-tooltip">Quest Journal</div>
		</div>
		<div class="sidebar-button" onclick="@(() => OpenSpellbook())">
			<div class="sidebar-icon">📖</div>
			<div class="sidebar-tooltip">Spellbook</div>
		</div>
		<div class="sidebar-button" onclick="@(() => OpenLeaderboard())">
			<div class="sidebar-icon">🏆</div>
			<div class="sidebar-tooltip">Leaderboard</div>
		</div>
	</div>
</root>

@code
{
	bool _warnedMissingBinding = false;

	protected override void OnUpdate()
	{
		if ( Input.Pressed( "Journal" ) )
		{
			if ( JournalStation.IsOpen )
				JournalStation.Close();
			else
				OpenJournal();
		}

		if ( TryReadSpellbookInput() )
		{
			if ( SpellbookStation.IsOpen )
				SpellbookStation.Close();
			else
				OpenSpellbook();
		}
	}

	bool TryReadSpellbookInput()
	{
		try
		{
			return Input.Pressed( "Spellbook" );
		}
		catch
		{
			if ( !_warnedMissingBinding )
			{
				Log.Info( "[SidebarButtons] No 'Spellbook' input binding found. Add it in project settings (suggested key: B)." );
				_warnedMissingBinding = true;
			}
			return false;
		}
	}

	void OpenJournal()
	{
		CloseAllOtherHuds();
		JournalStation.Open();
	}

	void OpenLeaderboard()
	{
		CloseAllOtherHuds();
		LeaderboardStation.Open();
	}

	void OpenSpellbook()
	{
		CloseAllOtherHuds();
		SpellbookStation.Open();
	}

	void CloseAllOtherHuds()
	{
		if ( NpcInteract.ActiveNpc != null )
			NpcInteract.ActiveNpc.CloseDialogue();

		if ( CraftingStation.ActiveStation != null )
			CraftingStation.Close();

		if ( ShopStation.ActiveShop != null )
			ShopStation.CloseShop();

		if ( BankStation.ActiveBank != null )
			BankStation.Close();

		if ( EnchantingStation.ActiveStation != null )
			EnchantingStation.Close();

		if ( TeleportStone.ActiveStone != null )
			TeleportStone.Close();

		JournalStation.Close();
		LeaderboardStation.Close();
		SpellbookStation.Close();
	}

	protected override int BuildHash()
	{
		return ( JournalStation.IsOpen, LeaderboardStation.IsOpen, SpellbookStation.IsOpen, InventoryHud.GearTabExpanded ).GetHashCode();
	}
}
