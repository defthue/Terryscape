@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent

<root>
	<div class="sidebar-buttons @(InventoryHud.GearTabExpanded ? "gear-shift" : "") @(HudState.InventoryCollapsed ? "collapsed" : "")">
		<div class="sidebar-button" onclick="@(() => OpenJournal())">
			<div class="sidebar-icon">📜</div>
			<div class="sidebar-tooltip">Quest Journal</div>
		</div>
		<div class="sidebar-button" onclick="@(() => OpenSpellbook())">
			<div class="sidebar-icon">📖</div>
			<div class="sidebar-tooltip">Spellbook</div>
		</div>
		<div class="sidebar-button" onclick="@(() => OpenLeaderboard())">
			<div class="sidebar-icon">🏆</div>
			<div class="sidebar-tooltip">Leaderboard</div>
		</div>
		<div class="sidebar-button" onclick="@(() => OpenPets())">
			<div class="sidebar-icon">🐾</div>
			<div class="sidebar-tooltip">Pets</div>
		</div>
		<div class="sidebar-button @RecallButtonClass()" onclick="@(() => DoRecall())">
			<div class="sidebar-icon">@RecallIcon()</div>
			<div class="sidebar-tooltip">Recall to Spawn</div>
		</div>
	</div>
</root>

@code
{
	bool _warnedMissingBinding = false;
	bool _warnedMissingPets = false;
	bool _warnedMissingRecall = false;

	protected override void OnUpdate()
	{
		EnsureRecallSystem();

		if ( Input.Pressed( "Journal" ) )
		{
			if ( JournalStation.IsOpen )
				JournalStation.Close();
			else
				OpenJournal();
		}

		if ( TryReadSpellbookInput() )
		{
			if ( SpellbookStation.IsOpen )
				SpellbookStation.Close();
			else
				OpenSpellbook();
		}

		if ( TryReadPetsInput() )
		{
			if ( PetsStation.IsOpen )
				PetsStation.Close();
			else
				OpenPets();
		}

		if ( TryReadRecallInput() )
			DoRecall();
	}

	bool TryReadSpellbookInput()
	{
		try
		{
			return Input.Pressed( "Spellbook" );
		}
		catch
		{
			if ( !_warnedMissingBinding )
			{
				Log.Info( "[SidebarButtons] No 'Spellbook' input binding found. Add it in project settings (suggested key: B)." );
				_warnedMissingBinding = true;
			}
			return false;
		}
	}

	bool TryReadPetsInput()
	{
		try
		{
			return Input.Pressed( "Pets" );
		}
		catch
		{
			if ( !_warnedMissingPets )
			{
				Log.Info( "[SidebarButtons] No 'Pets' input binding found. Add it in project settings (suggested key: P)." );
				_warnedMissingPets = true;
			}
			return false;
		}
	}

	bool TryReadRecallInput()
	{
		try
		{
			return Input.Pressed( "Recall" );
		}
		catch
		{
			if ( !_warnedMissingRecall )
			{
				Log.Info( "[SidebarButtons] No 'Recall' input binding found. Add it in project settings (suggested key: H)." );
				_warnedMissingRecall = true;
			}
			return false;
		}
	}

	void EnsureRecallSystem()
	{
		PlayerHelper.GetLocalPlayer()?.Components.GetOrCreate<RecallSystem>();
	}

	void DoRecall()
	{
		var player = PlayerHelper.GetLocalPlayer();
		if ( player == null )
			return;

		var recall = player.Components.GetOrCreate<RecallSystem>();
		if ( RecallSystem.IsChanneling )
			recall.CancelChannel();
		else
			recall.StartRecall();
	}

	string RecallIcon()
	{
		if ( RecallSystem.CooldownRemaining > 0f )
			return MathF.Ceiling( RecallSystem.CooldownRemaining ).ToString( "0" );

		return "🌀";
	}

	string RecallButtonClass()
	{
		if ( RecallSystem.IsChanneling )
			return "recall-channeling";

		if ( RecallSystem.CooldownRemaining > 0f )
			return "recall-cooldown";

		return "";
	}

	void OpenJournal()
	{
		CloseAllOtherHuds();
		JournalStation.Open();
	}

	void OpenLeaderboard()
	{
		CloseAllOtherHuds();
		LeaderboardStation.Open();
	}

	void OpenSpellbook()
	{
		CloseAllOtherHuds();
		SpellbookStation.Open();
	}

	void OpenPets()
	{
		CloseAllOtherHuds();
		PetsStation.Open();
	}

	void CloseAllOtherHuds()
	{
		if ( NpcInteract.ActiveNpc != null )
			NpcInteract.ActiveNpc.CloseDialogue();

		if ( CraftingStation.ActiveStation != null )
			CraftingStation.Close();

		if ( ShopStation.ActiveShop != null )
			ShopStation.CloseShop();

		if ( BankStation.ActiveBank != null )
			BankStation.Close();

		if ( EnchantingStation.ActiveStation != null )
			EnchantingStation.Close();

		if ( TeleportStone.ActiveStone != null )
			TeleportStone.Close();

		JournalStation.Close();
		LeaderboardStation.Close();
		SpellbookStation.Close();
		PetsStation.Close();
	}

	protected override int BuildHash()
	{
		int recallSeconds = (int)MathF.Ceiling( RecallSystem.CooldownRemaining );
		return ( JournalStation.IsOpen, LeaderboardStation.IsOpen, SpellbookStation.IsOpen, PetsStation.IsOpen, InventoryHud.GearTabExpanded, recallSeconds, RecallSystem.IsChanneling, HudState.InventoryCollapsed ).GetHashCode();
	}
}
