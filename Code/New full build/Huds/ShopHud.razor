@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="shop-backdrop" onclick="@(() => CloseShop())"></div>
		<div class="shop-popup">
			<div class="shop-header">
				<div class="shop-title">@ShopName</div>
				<div class="shop-header-right">
					<div class="shop-gold">@($"⛃ {PlayerGold} gold")</div>
					<div class="shop-close" onclick="@(() => CloseShop())">✕</div>
				</div>
			</div>

			<div class="shop-toolbar">
				<div class="shop-tab @(IsBuyMode ? "active" : "")" onclick="@(() => SelectTab( true ))">Buy</div>
				<div class="shop-tab @(!IsBuyMode ? "active" : "")" onclick="@(() => SelectTab( false ))">Sell</div>
				<div class="shop-toolbar-spacer"></div>
				<TextEntry class="shop-search" Value:bind="@Search" Placeholder="Search items"></TextEntry>
			</div>

			<div class="shop-body">
				@if ( IsBuyMode )
				{
					<div class="shop-rail">
						@foreach ( var cat in Categories )
						{
							var catLocal = cat;
							<div class="shop-cat @(CurrentCategory == catLocal.Label ? "selected" : "")" onclick="@(() => SelectCategory( catLocal.Label ))">
								<div class="shop-cat-name">@catLocal.Label</div>
								<div class="shop-cat-count">@catLocal.Count</div>
							</div>
						}
					</div>

					<div class="shop-center">
						<div class="shop-grid">
							@for ( int row = 0; row < GridRows; row++ )
							{
								<div class="shop-grid-row">
									@for ( int col = 0; col < GridColumns; col++ )
									{
										var entryLocal = PageEntries[row * GridColumns + col];
										@if ( entryLocal == null )
										{
											<div class="shop-cell placeholder"></div>
										}
										else
										{
											<div class="shop-cell @(IsSelected( entryLocal ) ? "selected" : "") @(SearchDim( entryLocal ) ? "searchdim" : "")" onclick="@(() => SelectEntry( entryLocal ))">
												<div class="shop-cell-iconwrap">
													<div class="shop-icon-glyph">❖</div>
													<img class="shop-cell-img" src="@GetIconPath( entryLocal.Item )" />
												</div>
												<div class="shop-price-tag buy">@($"{entryLocal.Price}g")</div>
												<div class="shop-tip">
													<div class="shop-tip-name">@entryLocal.Name</div>
													<div class="shop-tip-sub">@($"{entryLocal.Price} gold each")</div>
												</div>
											</div>
										}
									}
								</div>
							}
						</div>
						<div class="shop-pager">
							<div class="shop-pager-btn @(Page <= 0 ? "disabled" : "")" onclick="@(() => StepPage( -1 ))">◀</div>
							<div class="shop-pager-label">Page @(Page + 1) / @PageCount</div>
							<div class="shop-pager-btn @(Page >= PageCount - 1 ? "disabled" : "")" onclick="@(() => StepPage( 1 ))">▶</div>
						</div>
					</div>

					<div class="shop-detail">
						@if ( SelectedBuy == null )
						{
							<div class="shop-detail-empty">Select an item to buy.</div>
						}
						else
						{
							<div class="shop-detail-iconbox">
								<div class="shop-icon-glyph big">❖</div>
								<img class="shop-detail-img" src="@GetIconPath( SelectedBuy.Item )" />
							</div>
							<div class="shop-detail-name">@SelectedBuy.Name</div>
							<div class="shop-detail-context">@ContextLine( SelectedBuy.Item )</div>

							<div class="shop-detail-divider"></div>

							<div class="shop-detail-line">@($"Price {SelectedBuy.Price}g each")</div>
							<div class="shop-detail-line sub">@($"You own {OwnedCount( SelectedBuy.Item )}")</div>

							<div class="shop-section-label">QUANTITY</div>
							<div class="shop-qty-row">
								@foreach ( var qty in QuantityOptions )
								{
									var qtyLocal = qty;
									<div class="shop-qty @(BuyQuantity == qtyLocal ? "selected" : "")" onclick="@(() => SetBuyQuantity( qtyLocal ))">@qtyLocal</div>
								}
							</div>

							<div class="shop-detail-line total">@($"Total: {SelectedBuy.Price * BuyQuantity}g")</div>

							<div class="shop-spacer"></div>

							<div class="shop-action @(CanAffordSelected ? "" : "disabled")" onclick="@(() => DoBuyAction())">Buy</div>
							@if ( !CanAffordSelected )
							{
								<div class="shop-note">Not enough gold</div>
							}
						}
					</div>
				}
				else
				{
					<div class="shop-rail">
						@foreach ( var cat in Categories )
						{
							var catLocal = cat;
							<div class="shop-cat @(CurrentCategory == catLocal.Label ? "selected" : "")" onclick="@(() => SelectCategory( catLocal.Label ))">
								<div class="shop-cat-name">@catLocal.Label</div>
								<div class="shop-cat-count">@catLocal.Count</div>
							</div>
						}
					</div>

					<div class="shop-detail">
						@if ( SelectedSell == null )
						{
							<div class="shop-detail-empty">Select an item to sell.</div>
						}
						else
						{
							<div class="shop-detail-iconbox">
								<div class="shop-icon-glyph big">❖</div>
								<img class="shop-detail-img" src="@GetIconPath( SelectedSell.Item )" />
							</div>
							<div class="shop-detail-name @(SelectedSell.HasCustomName ? "named" : "")">@SelectedSell.Name</div>
							<div class="shop-detail-context">@ContextLine( SelectedSell.Item )</div>

							@if ( SelectedSell.IsUnique )
							{
								@foreach ( var line in UniqueStatusLines( SelectedSell ) )
								{
									<div class="shop-detail-socket" style="color: @line.Color;">@line.Text</div>
								}
							}

							<div class="shop-detail-divider"></div>

							@if ( SelectedSell.Unsellable )
							{
								<div class="shop-note">@SelectedSell.UnsellableReason</div>
							}
							else
							{
								<div class="shop-detail-line">@($"+{SelectedSell.Price}g each")</div>
								<div class="shop-detail-line sub">@($"You have {SelectedSell.Owned}")</div>

								<div class="shop-spacer"></div>

								@if ( SelectedSell.IsUnique )
								{
									<div class="shop-action sell" onclick="@(() => DoSellUnique())">Sell</div>
								}
								else
								{
									<div class="shop-action sell @(SelectedSell.Owned > 0 ? "" : "disabled")" onclick="@(() => DoSell())">Sell</div>
									<div class="shop-action sell all @(SelectedSell.Owned > 0 ? "" : "disabled")" onclick="@(() => DoSellAllRequest())">Sell All</div>
								}
							}
						}
					</div>

					<div class="shop-center">
						<div class="shop-grid">
							@for ( int row = 0; row < GridRows; row++ )
							{
								<div class="shop-grid-row">
									@for ( int col = 0; col < GridColumns; col++ )
									{
										var entryLocal = PageEntries[row * GridColumns + col];
										@if ( entryLocal == null )
										{
											<div class="shop-cell placeholder"></div>
										}
										else
										{
											<div class="shop-cell @(IsSelected( entryLocal ) ? "selected" : "") @(entryLocal.Unsellable ? "unsellable" : "") @(SearchDim( entryLocal ) ? "searchdim" : "")" onclick="@(() => SelectEntry( entryLocal ))">
												<div class="shop-cell-iconwrap">
													<div class="shop-icon-glyph">❖</div>
													<img class="shop-cell-img" src="@GetIconPath( entryLocal.Item )" />
												</div>
												@if ( !entryLocal.Unsellable )
												{
													<div class="shop-price-tag sell">@($"+{entryLocal.Price}g")</div>
												}
												<div class="shop-tip">
													<div class="shop-tip-name">@entryLocal.Name</div>
													@if ( entryLocal.Unsellable )
													{
														<div class="shop-tip-sub bad">@entryLocal.UnsellableReason</div>
													}
													else
													{
														<div class="shop-tip-sub">@($"+{entryLocal.Price} gold each · own {entryLocal.Owned}")</div>
													}
												</div>
											</div>
										}
									}
								</div>
							}
						</div>
						<div class="shop-pager">
							<div class="shop-pager-btn @(Page <= 0 ? "disabled" : "")" onclick="@(() => StepPage( -1 ))">◀</div>
							<div class="shop-pager-label">Page @(Page + 1) / @PageCount</div>
							<div class="shop-pager-btn @(Page >= PageCount - 1 ? "disabled" : "")" onclick="@(() => StepPage( 1 ))">▶</div>
						</div>
					</div>
				}
			</div>
		</div>

		@if ( ShopStation.PendingSellAllItem != ItemId.None )
		{
			<div class="shop-backdrop confirm" onclick="@(() => CancelSellAll())"></div>
			<div class="shop-confirm">
				<div class="shop-confirm-title">Sell All?</div>

				<div class="shop-confirm-row">
					<div class="shop-confirm-iconwrap">
						<div class="shop-icon-glyph">❖</div>
						<img class="shop-confirm-img" src="@GetIconPath( ShopStation.PendingSellAllItem )" />
					</div>
					<div class="shop-confirm-info">
						<div class="shop-confirm-name">@GetItemName( ShopStation.PendingSellAllItem )</div>
						<div class="shop-confirm-qty">x@(ShopStation.PendingSellAllAmount)</div>
					</div>
				</div>

				<div class="shop-confirm-receive">You receive <span class="shop-confirm-gold">@($"{ShopStation.PendingSellAllTotalGold} gold")</span></div>

				<div class="shop-confirm-buttons">
					<div class="shop-action cancel" onclick="@(() => CancelSellAll())">Cancel</div>
					<div class="shop-action sell" onclick="@(() => ConfirmSellAll())">Sell All</div>
				</div>
			</div>
		}
	}
</root>

@code
{
	bool IsOpen => ShopStation.ActiveShop != null;
	string ShopName => ShopStation.ActiveShop?.DisplayName ?? "Shop";

	Inventory PlayerInventory { get; set; }
	int PlayerGold => PlayerInventory != null ? PlayerInventory.GetItemCount( ItemId.GoldCoin ) : 0;

	PotionSystem Potions => PlayerHelper.GetLocalPlayer()?.Components.Get<PotionSystem>();

	const int GridColumns = 6;
	const int GridRows = 6;
	const int PageSize = GridColumns * GridRows;

	static readonly int[] QuantityOptions = { 1, 5, 10, 50 };

	bool IsBuyMode { get; set; } = true;
	string Search { get; set; } = "";
	int BuyQuantity { get; set; } = 1;

	string BuyCategory { get; set; } = "All";
	string SellCategory { get; set; } = "All";
	int BuyPage { get; set; } = 0;
	int SellPage { get; set; } = 0;

	ItemId BuySelectedId { get; set; } = ItemId.None;
	ItemId SellSelectedId { get; set; } = ItemId.None;
	bool SellSelectedIsUnique { get; set; }
	int SellSelectedUniqueIndex { get; set; } = -1;

	string CurrentCategory => IsBuyMode ? BuyCategory : SellCategory;

	int Page
	{
		get => IsBuyMode ? BuyPage : SellPage;
		set
		{
			if ( IsBuyMode ) BuyPage = value;
			else SellPage = value;
		}
	}

	public class GridEntry
	{
		public ItemId Item;
		public string Name;
		public int Price;
		public int Owned;
		public bool IsUnique;
		public int UniqueIndex;
		public bool Unsellable;
		public string UnsellableReason;
		public bool HasCustomName;
		public ItemType Type;
	}

	public class CategoryVm
	{
		public string Label;
		public int Count;
	}

	static readonly (string Label, ItemType[] Types)[] CategoryDefs =
	{
		( "Potions", new[] { ItemType.Potion } ),
		( "Herbs", new[] { ItemType.Herb } ),
		( "Bars", new[] { ItemType.Bar } ),
		( "Resources", new[] { ItemType.Resource } ),
		( "Weapons", new[] { ItemType.MeleeWeapon, ItemType.RangedWeapon, ItemType.MagicWeapon } ),
		( "Armor", new[] { ItemType.HeavyArmor, ItemType.MediumArmor, ItemType.LightArmor } ),
		( "Shields", new[] { ItemType.Shield } ),
		( "Tools", new[] { ItemType.Tool } ),
		( "Ammo", new[] { ItemType.Arrow } ),
		( "Accessories", new[] { ItemType.Ring, ItemType.Amulet } ),
		( "Misc", new[] { ItemType.Misc, ItemType.Rune } )
	};

	List<GridEntry> TabEntries { get; set; } = new();
	List<CategoryVm> Categories { get; set; } = new();
	List<GridEntry> PageEntries { get; set; } = new();
	int PageCount { get; set; } = 1;

	GridEntry SelectedBuy { get; set; }
	GridEntry SelectedSell { get; set; }

	bool CanAffordSelected => SelectedBuy != null && PlayerGold >= SelectedBuy.Price * BuyQuantity;

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		if ( id == ItemId.Gem ) return "/ItemIcons/FineGem.vtex";
		if ( id == ItemId.Ring ) return "/ItemIcons/FineRing.vtex";
		if ( id == ItemId.Amulet ) return "/ItemIcons/FineAmulet.vtex";

		return $"/ItemIcons/{id}.vtex";
	}

	string GetItemName( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null ? def.Name : id.ToString();
	}

	static string Num( float value )
	{
		return value.ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture );
	}

	static string CategoryLabelFor( ItemType type )
	{
		foreach ( var def in CategoryDefs )
		{
			foreach ( var t in def.Types )
			{
				if ( t == type )
					return def.Label;
			}
		}
		return "Misc";
	}

	string ContextLine( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		if ( def == null )
			return "";

		if ( def.Type == ItemType.Potion )
			return PotionEffectText( id );

		string label = CategoryLabelFor( def.Type );
		return def.Tier > 0 ? $"{label} · Tier {def.Tier}" : label;
	}

	string PotionEffectText( ItemId id )
	{
		var potions = Potions;
		float healTick = potions?.HealTickDuration ?? 2f;
		float buffDur = potions?.BuffDuration ?? 60f;
		float elixirDur = potions?.ElixirDuration ?? 60f;

		switch ( id )
		{
			case ItemId.LesserHealingPotion:
				return $"Heals {potions?.MinorHealAmount ?? 15} HP over {Num( healTick )}s";
			case ItemId.HealingPotion:
				return $"Heals {potions?.HealAmount ?? 30} HP over {Num( healTick )}s";
			case ItemId.GreaterHealingPotion:
				return $"Heals {potions?.GreaterHealAmount ?? 60} HP over {Num( healTick )}s";
			case ItemId.LesserManaPotion:
				return "Restores 25 mana";
			case ItemId.ManaPotion:
				return "Restores 60 mana";
			case ItemId.GreaterManaPotion:
				return "Restores 120 mana";
			case ItemId.AttackPotion:
				return $"+{Num( potions?.AttackBuffPercent ?? 15f )}% melee damage for {Num( buffDur )}s";
			case ItemId.DefencePotion:
				return $"+{Num( potions?.DefenceBuffPercent ?? 15f )}% armor for {Num( buffDur )}s";
			case ItemId.ArcheryPotion:
				return $"+{Num( potions?.ArcheryBuffPercent ?? 15f )}% ranged damage for {Num( buffDur )}s";
			case ItemId.MagicPotion:
				return $"+{Num( potions?.MagicBuffPercent ?? 15f )}% magic damage for {Num( buffDur )}s";
			case ItemId.ElixirOfPower:
				return $"+{Num( potions?.ElixirBuffPercent ?? 20f )}% all damage for {Num( elixirDur )}s";
			default:
				return "Potion";
		}
	}

	public class StatusLine
	{
		public string Text;
		public string Color;
	}

	List<StatusLine> UniqueStatusLines( GridEntry entry )
	{
		var lines = new List<StatusLine>();
		var items = PlayerInventory?.GetUniqueItems();
		if ( items == null || entry.UniqueIndex < 0 || entry.UniqueIndex >= items.Count )
			return lines;

		var instance = items[entry.UniqueIndex];

		if ( instance.HasCustomName )
			lines.Add( new StatusLine { Text = instance.GetBaseName(), Color = "#c9bc9c" } );

		if ( instance.IsEnchanted )
			lines.Add( new StatusLine { Text = $"+{instance.EnchantmentPercent:F1}% {instance.Enchantment}", Color = EnchantmentTypes.GetColor( instance.Enchantment ) } );

		if ( instance.IsSocketable )
		{
			for ( int si = 0; si < instance.MaxSockets; si++ )
			{
				var rune = instance.GetSocket( si );
				if ( rune != null && rune.IsEnchanted )
					lines.Add( new StatusLine { Text = $"+{rune.EnchantmentPercent:F1}% {rune.Enchantment}", Color = EnchantmentTypes.GetColor( rune.Enchantment ) } );
			}
		}

		return lines;
	}

	int OwnedCount( ItemId id )
	{
		return PlayerInventory?.GetItemCount( id ) ?? 0;
	}

	bool SearchDim( GridEntry entry )
	{
		if ( string.IsNullOrWhiteSpace( Search ) )
			return false;

		return !entry.Name.ToLower().Contains( Search.ToLower() );
	}

	bool IsSelected( GridEntry entry )
	{
		if ( IsBuyMode )
			return BuySelectedId == entry.Item && !entry.IsUnique;

		if ( entry.IsUnique )
			return SellSelectedIsUnique && SellSelectedUniqueIndex == entry.UniqueIndex;

		return !SellSelectedIsUnique && SellSelectedId == entry.Item;
	}

	void SelectTab( bool buy )
	{
		IsBuyMode = buy;
	}

	void SelectCategory( string label )
	{
		if ( IsBuyMode )
			BuyCategory = label;
		else
			SellCategory = label;

		Page = 0;
	}

	void StepPage( int delta )
	{
		int next = Page + delta;
		if ( next < 0 ) next = 0;
		if ( next > PageCount - 1 ) next = PageCount - 1;
		Page = next;
	}

	void SelectEntry( GridEntry entry )
	{
		if ( IsBuyMode )
		{
			BuySelectedId = entry.Item;
			BuyQuantity = 1;
			return;
		}

		if ( entry.IsUnique )
		{
			SellSelectedIsUnique = true;
			SellSelectedUniqueIndex = entry.UniqueIndex;
			SellSelectedId = ItemId.None;
		}
		else
		{
			SellSelectedIsUnique = false;
			SellSelectedUniqueIndex = -1;
			SellSelectedId = entry.Item;
		}
	}

	void SetBuyQuantity( int qty )
	{
		BuyQuantity = qty;
	}

	void DoBuyAction()
	{
		if ( ShopStation.ActiveShop == null || SelectedBuy == null || !CanAffordSelected )
			return;

		if ( BuyQuantity <= 1 )
			ShopStation.ActiveShop.TryBuy( SelectedBuy.Item );
		else
			ShopStation.ActiveShop.TryBuyMany( SelectedBuy.Item, BuyQuantity );
	}

	void DoSell()
	{
		if ( ShopStation.ActiveShop == null || SelectedSell == null || SelectedSell.IsUnique )
			return;

		ShopStation.ActiveShop.TrySell( SelectedSell.Item );
	}

	void DoSellAllRequest()
	{
		if ( ShopStation.ActiveShop == null || SelectedSell == null || SelectedSell.IsUnique )
			return;

		ShopStation.ActiveShop.RequestSellAll( SelectedSell.Item );
	}

	void ConfirmSellAll()
	{
		ShopStation.ActiveShop?.ConfirmSellAll();
	}

	void CancelSellAll()
	{
		ShopStation.ClearPendingSellAll();
	}

	void DoSellUnique()
	{
		if ( ShopStation.ActiveShop == null || SelectedSell == null || !SelectedSell.IsUnique )
			return;

		ShopStation.ActiveShop.TrySellUnique( SelectedSell.UniqueIndex );
		SellSelectedIsUnique = false;
		SellSelectedUniqueIndex = -1;
	}

	void CloseShop()
	{
		BuySelectedId = ItemId.None;
		SellSelectedId = ItemId.None;
		SellSelectedIsUnique = false;
		SellSelectedUniqueIndex = -1;
		BuyCategory = "All";
		SellCategory = "All";
		BuyPage = 0;
		SellPage = 0;
		Search = "";
		BuyQuantity = 1;
		IsBuyMode = true;
		ShopStation.CloseShop();
	}

	List<GridEntry> BuildTabEntries()
	{
		var entries = new List<GridEntry>();
		var shop = ShopStation.ActiveShop;
		if ( shop == null )
			return entries;

		if ( IsBuyMode )
		{
			foreach ( var (item, price) in shop.GetEffectiveItemsForSale() )
			{
				if ( price <= 0 )
					continue;

				var def = ItemDatabase.Get( item );
				entries.Add( new GridEntry
				{
					Item = item,
					Name = def != null ? def.Name : item.ToString(),
					Price = price,
					Owned = OwnedCount( item ),
					Type = def != null ? def.Type : ItemType.Misc
				} );
			}

			return entries;
		}

		if ( PlayerInventory == null )
			return entries;

		var seen = new HashSet<ItemId>();
		foreach ( var kv in PlayerInventory.GetAllItems() )
		{
			if ( kv.Value <= 0 || seen.Contains( kv.Key ) )
				continue;

			int price = ShopPricing.GetSellPrice( kv.Key );
			if ( price <= 0 )
				continue;

			var def = ItemDatabase.Get( kv.Key );
			entries.Add( new GridEntry
			{
				Item = kv.Key,
				Name = def != null ? def.Name : kv.Key.ToString(),
				Price = price,
				Owned = kv.Value,
				Type = def != null ? def.Type : ItemType.Misc
			} );
			seen.Add( kv.Key );
		}

		var uniqueItems = PlayerInventory.GetUniqueItems();
		for ( int i = 0; i < uniqueItems.Count; i++ )
		{
			var instance = uniqueItems[i];
			int price = ShopPricing.GetSellPrice( instance.ItemId );
			var def = ItemDatabase.Get( instance.ItemId );

			string reason = null;
			if ( instance.IsEnchanted )
				reason = "Enchanted — the shop won't buy this";
			else if ( instance.IsSocketable && instance.SocketsUsed > 0 )
				reason = "Socketed — the shop won't buy this";
			else if ( price <= 0 )
				reason = "The shop won't buy this";

			entries.Add( new GridEntry
			{
				Item = instance.ItemId,
				Name = instance.GetDisplayName(),
				Price = price,
				Owned = 1,
				IsUnique = true,
				UniqueIndex = i,
				Unsellable = reason != null,
				UnsellableReason = reason,
				HasCustomName = instance.HasCustomName,
				Type = def != null ? def.Type : ItemType.Misc
			} );
		}

		return entries;
	}

	void RebuildLists()
	{
		TabEntries = BuildTabEntries();

		Categories = new List<CategoryVm> { new CategoryVm { Label = "All", Count = TabEntries.Count } };
		foreach ( var def in CategoryDefs )
		{
			int count = 0;
			foreach ( var entry in TabEntries )
			{
				if ( CategoryLabelFor( entry.Type ) == def.Label )
					count++;
			}
			if ( count > 0 )
				Categories.Add( new CategoryVm { Label = def.Label, Count = count } );
		}

		bool categoryExists = CurrentCategory == "All";
		foreach ( var cat in Categories )
		{
			if ( cat.Label == CurrentCategory )
				categoryExists = true;
		}
		if ( !categoryExists )
			SelectCategory( "All" );

		var filtered = new List<GridEntry>();
		foreach ( var entry in TabEntries )
		{
			if ( CurrentCategory != "All" && CategoryLabelFor( entry.Type ) != CurrentCategory )
				continue;
			filtered.Add( entry );
		}

		PageCount = Math.Max( 1, ( filtered.Count + PageSize - 1 ) / PageSize );
		if ( Page > PageCount - 1 )
			Page = PageCount - 1;
		if ( Page < 0 )
			Page = 0;

		PageEntries = new List<GridEntry>();
		int start = Page * PageSize;
		for ( int i = 0; i < PageSize; i++ )
		{
			int idx = start + i;
			PageEntries.Add( idx < filtered.Count ? filtered[idx] : null );
		}

		SelectedBuy = null;
		SelectedSell = null;

		foreach ( var entry in TabEntries )
		{
			if ( IsBuyMode && !entry.IsUnique && entry.Item == BuySelectedId )
				SelectedBuy = entry;

			if ( !IsBuyMode )
			{
				if ( SellSelectedIsUnique && entry.IsUnique && entry.UniqueIndex == SellSelectedUniqueIndex )
					SelectedSell = entry;
				else if ( !SellSelectedIsUnique && !entry.IsUnique && entry.Item == SellSelectedId )
					SelectedSell = entry;
			}
		}

		if ( IsBuyMode && SelectedBuy == null )
			BuySelectedId = ItemId.None;

		if ( !IsBuyMode && SelectedSell == null )
		{
			SellSelectedId = ItemId.None;
			SellSelectedIsUnique = false;
			SellSelectedUniqueIndex = -1;
		}
	}

	protected override int BuildHash()
	{
		if ( !IsOpen )
		{
			TabEntries.Clear();
			PageEntries.Clear();
			SelectedBuy = null;
			SelectedSell = null;
			return 0;
		}

		PlayerInventory = PlayerHelper.GetLocalInventory();
		RebuildLists();

		int entriesHash = 0;
		foreach ( var entry in TabEntries )
			entriesHash = HashCode.Combine( entriesHash, entry.Item, entry.Owned, entry.Price, entry.Unsellable );

		return HashCode.Combine(
			HashCode.Combine( IsOpen, ShopName, IsBuyMode, CurrentCategory, Page, Search ?? "" ),
			HashCode.Combine( BuySelectedId, SellSelectedId, SellSelectedIsUnique, SellSelectedUniqueIndex, BuyQuantity ),
			HashCode.Combine( PlayerGold, entriesHash ),
			HashCode.Combine( ShopStation.PendingSellAllItem, ShopStation.PendingSellAllAmount )
		);
	}
}
