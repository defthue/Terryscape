@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="shop-backdrop" onclick="@(() => CloseShop())"></div>
		<div class="crafting-overlay">
			<div class="crafting-popup">
				<div class="crafting-header">
					<div class="crafting-title">@ShopName</div>
					<div class="crafting-close" onclick="@(() => CloseShop())">✕</div>
				</div>

				<div class="crafting-body">
					<div class="recipe-list">
						<div class="detail-section-label" style="padding: 8px 12px;">Shop</div>
						@foreach ( var entry in BuyEntries )
						{
							var def = ItemDatabase.Get( entry.Item );
							string name = def != null ? def.Name : entry.Item.ToString();

							<div class="recipe-row @(SelectedItem == entry.Item && IsBuyMode && !SelectedIsUnique ? "selected" : "") @(CanBuy( entry ) ? "craftable" : "locked")"
								 onclick="@(() => SelectBuy( entry ))">
								<div class="recipe-icon" style="background: @GetItemColor( def );">
									<img class="recipe-icon-img" src="@GetIconPath( entry.Item )" />
								</div>
								<div class="recipe-name">@name</div>
								<div class="recipe-amount gold">@entry.Price g</div>
							</div>
						}

						<div class="detail-section-label" style="padding: 8px 12px; margin-top: 8px;">Your Items</div>
						@if ( SellEntries.Count == 0 && SellableUnique.Count == 0 )
						{
							<div class="no-recipes">Nothing to sell here.</div>
						}
						@foreach ( var entry in SellEntries )
						{
							var def = ItemDatabase.Get( entry.Item );
							string name = def != null ? def.Name : entry.Item.ToString();
							int count = PlayerInventory != null ? PlayerInventory.GetItemCount( entry.Item ) : 0;

							<div class="recipe-row @(SelectedItem == entry.Item && !IsBuyMode && !SelectedIsUnique ? "selected" : "") @(count > 0 ? "craftable" : "locked")"
								 onclick="@(() => SelectSell( entry ))">
								<div class="recipe-icon" style="background: @GetItemColor( def );">
									<img class="recipe-icon-img" src="@GetIconPath( entry.Item )" />
								</div>
								<div class="recipe-name">@name</div>
								<div class="recipe-amount">@count</div>
							</div>
						}
						@foreach ( var entry in SellableUnique )
						{
							var def = ItemDatabase.Get( entry.Instance.ItemId );
							string color = GetItemColor( def );

							<div class="recipe-row @(SelectedIsUnique && SelectedUniqueIndex == entry.OriginalIndex ? "selected" : "") craftable"
								 onclick="@(() => SelectUnique( entry.OriginalIndex ))">
								<div class="recipe-icon" style="background: @color;">
									<img class="recipe-icon-img" src="@GetIconPath( entry.Instance.ItemId )" />
								</div>
								<div class="recipe-name" style="@(entry.Instance.HasCustomName ? "color: #a080d0;" : "")">@entry.Instance.GetDisplayName()</div>
								<div class="recipe-amount">1</div>
							</div>
						}
					</div>

					<div class="recipe-detail">
						@if ( SelectedIsUnique && SelectedUniqueIndex >= 0 )
						{
							var items = PlayerInventory?.GetUniqueItems();
							@if ( items != null && SelectedUniqueIndex < items.Count )
							{
								var instance = items[SelectedUniqueIndex];
								var shop = ShopStation.ActiveShop;
								int sellPrice = shop != null ? shop.GetBuyPriceFromPlayer( instance.ItemId ) : 0;

								<div class="detail-header" style="@(instance.HasCustomName ? "color: #a080d0;" : "")">@instance.GetDisplayName()</div>

								@if ( instance.HasCustomName )
								{
									<div style="color: #c9bc9c; font-size: 14px;">@instance.GetBaseName()</div>
								}

								@if ( instance.IsSocketable && instance.SocketsUsed > 0 )
								{
									@for ( int si = 0; si < instance.MaxSockets; si++ )
									{
										var rune = instance.GetSocket( si );
										@if ( rune != null && rune.IsEnchanted )
										{
											<div style="color: @EnchantmentTypes.GetColor( rune.Enchantment ); font-size: 14px;">@($"+{rune.EnchantmentPercent:F1}% {rune.Enchantment}")</div>
										}
										else
										{
											<div style="color: #8a7a5c; font-size: 14px;">Empty socket</div>
										}
									}
								}

								@if ( sellPrice > 0 )
								{
									<div class="detail-section-label">Sell Value</div>
									<div class="ingredient-row have">
										<div class="ingredient-name">You receive</div>
										<div class="ingredient-count">@sellPrice gold</div>
									</div>

									<div class="craft-button-area">
										<div class="craft-button" onclick="@(() => DoSellUnique())">Sell</div>
									</div>
								}
							}
						}
						else if ( SelectedItem != ItemId.None )
						{
							var def = ItemDatabase.Get( SelectedItem );
							string name = def != null ? def.Name : SelectedItem.ToString();

							<div class="detail-header">@name</div>

							@if ( def != null )
							{
								<div class="detail-section-label">Info</div>
								<div class="requirement-row met">Type: @def.Type</div>
								@if ( def.Tier > 0 )
								{
									<div class="requirement-row met">Tier: @def.Tier</div>
								}
							}

							@if ( IsBuyMode && SelectedPrice > 0 )
							{
								int totalCost = SelectedPrice * BuyQuantity;
								bool canAfford = HasEnoughGold( totalCost );

								int invCount = PlayerInventory != null ? PlayerInventory.GetItemCount( SelectedItem ) : 0;

								<div class="detail-section-label">Cost</div>
								<div class="cost-row">
									<div class="cost-amount">Have: <span class="cost-gold">@PlayerGold g</span></div>
									<div class="cost-amount">Cost: <span class="@(canAfford ? "cost-gold" : "cost-low")">@totalCost g</span></div>
								</div>
								<div class="cost-row">
									<div class="cost-amount">Inventory: <span class="cost-gold">@invCount</span></div>
								</div>

								<div class="quantity-selector">
									<div class="quantity-button @(BuyQuantity == 1 ? "selected" : "")" onclick="@(() => SetBuyQuantity( 1 ))">1</div>
									<div class="quantity-button @(BuyQuantity == 10 ? "selected" : "")" onclick="@(() => SetBuyQuantity( 10 ))">10</div>
									<div class="quantity-button @(BuyQuantity == 100 ? "selected" : "")" onclick="@(() => SetBuyQuantity( 100 ))">100</div>
								</div>

								<div class="craft-button-area">
									<div class="craft-button @(canAfford ? "" : "disabled")"
										 onclick="@(() => DoBuyAction())">
										Buy
									</div>
								</div>
							}

							@if ( !IsBuyMode && SelectedPrice > 0 )
							{
								var sellCount = PlayerInventory != null ? PlayerInventory.GetItemCount( SelectedItem ) : 0;

								<div class="detail-section-label">Sell Value</div>
								<div class="ingredient-row have">
									<div class="ingredient-name">You receive</div>
									<div class="ingredient-count">@SelectedPrice gold</div>
								</div>
								<div class="ingredient-row @(sellCount > 0 ? "have" : "need")">
									<div class="ingredient-name">In inventory</div>
									<div class="ingredient-count">@sellCount</div>
								</div>

								<div class="craft-button-area" style="gap: 10px;">
									<div class="craft-button @(sellCount > 0 ? "" : "disabled")"
										 onclick="@(() => DoSell())">
										Sell
									</div>
									<div class="craft-button @(sellCount > 0 ? "" : "disabled")"
										 onclick="@(() => DoSellAllRequest())">
										Sell All
									</div>
								</div>
							}
						}
						else
						{
							<div class="detail-empty">Select an item to buy or sell.</div>
						}
					</div>
				</div>
			</div>

				</div>
			</div>

			@if ( ShopStation.PendingSellAllItem != ItemId.None )
		{
			var pendingDef = ItemDatabase.Get( ShopStation.PendingSellAllItem );

			<div class="shop-backdrop confirm" onclick="@(() => CancelSellAll())"></div>
			<div class="confirm-overlay">
				<div class="confirm-popup">
					<div class="confirm-title">Sell All?</div>

					<div class="confirm-item-row">
						<div class="confirm-icon" style="background: @GetItemColor( pendingDef );">
							<img class="confirm-icon-img" src="@GetIconPath( ShopStation.PendingSellAllItem )" />
						</div>
						<div class="confirm-item-info">
							<div class="confirm-item-name">@GetItemName( ShopStation.PendingSellAllItem )</div>
							<div class="confirm-item-qty">x@(ShopStation.PendingSellAllAmount)</div>
						</div>
					</div>

					<div class="confirm-receive-row">
						<div class="confirm-receive-label">You receive</div>
						<div class="confirm-receive-gold">@ShopStation.PendingSellAllTotalGold gold</div>
					</div>

					<div class="confirm-buttons">
						<div class="craft-button" onclick="@(() => CancelSellAll())">Cancel</div>
						<div class="craft-button confirm-yes" onclick="@(() => ConfirmSellAll())">Sell All</div>
					</div>
				</div>
			</div>
		}
		}
	</root>

@code
{
	bool IsOpen => ShopStation.ActiveShop != null;
	string ShopName => ShopStation.ActiveShop?.DisplayName ?? "Shop";

	ItemId SelectedItem { get; set; } = ItemId.None;
	int SelectedPrice { get; set; }
	bool IsBuyMode { get; set; }
	int BuyQuantity { get; set; } = 1;

	bool SelectedIsUnique { get; set; }
	int SelectedUniqueIndex { get; set; } = -1;

	Inventory PlayerInventory { get; set; }

	public class BuyListEntry
	{
		public ItemId Item;
		public int Price;
	}
	public class SellListEntry
	{
		public ItemId Item;
		public int Price;
	}

	List<BuyListEntry> BuyEntries { get; set; } = new();
	List<SellListEntry> SellEntries { get; set; } = new();

	public class SellableUniqueEntry
	{
		public ItemInstance Instance;
		public int OriginalIndex;
	}

	List<SellableUniqueEntry> SellableUnique { get; set; } = new();

	int PlayerGold => PlayerInventory != null ? PlayerInventory.GetItemCount( ItemId.GoldCoin ) : 0;

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		if ( id == ItemId.Gem ) return "/ItemIcons/FineGem.vtex";
		if ( id == ItemId.Ring ) return "/ItemIcons/FineRing.vtex";
		if ( id == ItemId.Amulet ) return "/ItemIcons/FineAmulet.vtex";

		return $"/ItemIcons/{id}.vtex";
	}

	string GetItemName( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		return def != null ? def.Name : id.ToString();
	}

	bool HasEnoughGold( int price )
	{
		return PlayerGold >= price;
	}

	bool CanBuy( BuyListEntry entry )
	{
		if ( entry == null || entry.Price <= 0 )
			return false;

		return HasEnoughGold( entry.Price );
	}

	void SelectBuy( BuyListEntry entry )
	{
		SelectedItem = entry.Item;
		SelectedPrice = entry.Price;
		IsBuyMode = true;
		BuyQuantity = 1;
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
	}

	void SelectSell( SellListEntry entry )
	{
		SelectedItem = entry.Item;
		SelectedPrice = entry.Price;
		IsBuyMode = false;
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
	}

	void SelectUnique( int index )
	{
		SelectedItem = ItemId.None;
		SelectedPrice = 0;
		IsBuyMode = false;
		SelectedIsUnique = true;
		SelectedUniqueIndex = index;
	}

	void SetBuyQuantity( int qty )
	{
		BuyQuantity = qty;
	}

	void DoBuyAction()
	{
		if ( ShopStation.ActiveShop == null || SelectedItem == ItemId.None )
			return;

		if ( BuyQuantity <= 1 )
			ShopStation.ActiveShop.TryBuy( SelectedItem );
		else
			ShopStation.ActiveShop.TryBuyMany( SelectedItem, BuyQuantity );
	}

	void DoSell()
	{
		if ( ShopStation.ActiveShop == null || SelectedItem == ItemId.None )
			return;

		ShopStation.ActiveShop.TrySell( SelectedItem );
	}

	void DoSellAllRequest()
	{
		if ( ShopStation.ActiveShop == null || SelectedItem == ItemId.None )
			return;

		ShopStation.ActiveShop.RequestSellAll( SelectedItem );
	}

	void ConfirmSellAll()
	{
		if ( ShopStation.ActiveShop == null )
			return;

		ShopStation.ActiveShop.ConfirmSellAll();
	}

	void CancelSellAll()
	{
		ShopStation.ClearPendingSellAll();
	}

	void DoSellUnique()
	{
		if ( ShopStation.ActiveShop == null || SelectedUniqueIndex < 0 )
			return;

		ShopStation.ActiveShop.TrySellUnique( SelectedUniqueIndex );
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
	}

	void CloseShop()
	{
		SelectedItem = ItemId.None;
		SelectedPrice = 0;
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
		ShopStation.CloseShop();
	}

	string GetItemColor( ItemDefinition def )
	{
		if ( def == null ) return "#888";

		switch ( def.Type )
		{
			case ItemType.Tool: return "#8B6914";
			case ItemType.MeleeWeapon: return "#c0c0c0";
			case ItemType.RangedWeapon: return "#7a5230";
			case ItemType.MagicWeapon: return "#7a5aaa";
			case ItemType.Arrow: return "#9a7a5a";
			case ItemType.Shield: return "#6a7a8a";
			case ItemType.HeavyArmor: return "#8a8a9a";
			case ItemType.MediumArmor: return "#7a8a6a";
			case ItemType.LightArmor: return "#6a6a8a";
			case ItemType.Bar: return "#d4a030";
			case ItemType.Herb: return "#4a8a4a";
			case ItemType.Potion: return "#d44a4a";
			case ItemType.Resource: return "#6a8a6a";
			case ItemType.Ring: return "#d4aa40";
			case ItemType.Amulet: return "#40aad4";
			case ItemType.Misc: return "#8a8a6a";
			default: return "#888";
		}
	}

	protected override void OnUpdate()
	{
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		var shop = ShopStation.ActiveShop;

		if ( shop != null )
		{
			PlayerInventory = PlayerHelper.GetLocalInventory();

			BuyEntries.Clear();
			SellEntries.Clear();
			SellableUnique.Clear();

			// Buy list = what the shop sells to the player
			foreach ( var (item, price) in shop.GetEffectiveItemsForSale() )
			{
				if ( price <= 0 )
					continue;

				BuyEntries.Add( new BuyListEntry { Item = item, Price = price } );
			}

			// Sell list = items in player's stackable inventory that have a sell price.
			// Pulls prices from ShopPricing.GetSellPrice directly — no dependency on
			// ItemDefinition.BaseSellPrice or shop config.
			if ( PlayerInventory != null )
			{
				var seen = new HashSet<ItemId>();
				foreach ( var kv in PlayerInventory.GetAllItems() )
				{
					if ( kv.Value <= 0 )
						continue;
					if ( seen.Contains( kv.Key ) )
						continue;

					int price = ShopPricing.GetSellPrice( kv.Key );
					if ( price <= 0 )
						continue;

					SellEntries.Add( new SellListEntry { Item = kv.Key, Price = price } );
					seen.Add( kv.Key );
				}
			}

			// Sellable unique items: any non-enchanted unique with a sell price
			if ( PlayerInventory != null )
			{
				var uniqueItems = PlayerInventory.GetUniqueItems();
				for ( int i = 0; i < uniqueItems.Count; i++ )
				{
					var instance = uniqueItems[i];
					if ( instance.IsEnchanted )
						continue;
					if ( instance.IsSocketable && instance.SocketsUsed > 0 )
						continue;

					int price = ShopPricing.GetSellPrice( instance.ItemId );
					if ( price <= 0 )
						continue;

					SellableUnique.Add( new SellableUniqueEntry { Instance = instance, OriginalIndex = i } );
				}
			}

			if ( SelectedItem != ItemId.None && !SelectedIsUnique )
			{
				if ( IsBuyMode )
				{
					SelectedPrice = shop.GetSellPriceForPlayer( SelectedItem );
					if ( SelectedPrice <= 0 )
						SelectedItem = ItemId.None;
				}
				else
				{
					SelectedPrice = ShopPricing.GetSellPrice( SelectedItem );
					if ( SelectedPrice <= 0 )
						SelectedItem = ItemId.None;
				}
			}
		}
		else
		{
			BuyEntries.Clear();
			SellEntries.Clear();
			SellableUnique.Clear();
			SelectedItem = ItemId.None;
			SelectedPrice = 0;
			SelectedIsUnique = false;
			SelectedUniqueIndex = -1;
		}

		int invHash = 0;
		if ( PlayerInventory != null )
		{
			invHash = PlayerGold;
			if ( SelectedItem != ItemId.None )
				invHash += PlayerInventory.GetItemCount( SelectedItem ) * 1000;
			invHash += PlayerInventory.GetUniqueItemCount() * 10000;
		}

		return (
			IsOpen,
			ShopName,
			BuyEntries.Count,
			SellEntries.Count,
			SellableUnique.Count,
			SelectedItem,
			SelectedPrice,
			IsBuyMode,
			BuyQuantity,
			SelectedIsUnique,
			SelectedUniqueIndex,
			invHash,
			ShopStation.PendingSellAllItem,
			ShopStation.PendingSellAllAmount
		).GetHashCode();
	}
}
