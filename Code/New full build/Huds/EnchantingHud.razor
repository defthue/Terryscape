@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="ench-backdrop" onclick="@OnBackdropClick"></div>
		<div class="ench-popup">
			<div class="ench-header">
				<div class="ench-title">@StationName</div>
				<div class="ench-close" onclick="@OnCloseClick">✕</div>
			</div>

			<div class="ench-tabs">
				<div class="ench-tab @(Mode == 0 ? "active" : "")" onclick="@(() => SetMode(0))">Craft</div>
				<div class="ench-tab @(Mode == 1 ? "active" : "")" onclick="@(() => SetMode(1))">Enchant</div>
				<div class="ench-tab @(Mode == 2 ? "active" : "")" onclick="@(() => SetMode(2))">Combine</div>
				<div class="ench-tab @(Mode == 3 ? "active" : "")" onclick="@(() => SetMode(3))">Socket</div>
				<div class="ench-tab @(Mode == 4 ? "active" : "")" onclick="@(() => SetMode(4))">Extract</div>
			</div>

			<div class="ench-status">Arcane Dust: @DustCount  |  Stone: @StoneCount  |  Enchanting Lvl: @Level</div>

			<div class="ench-body">
				@if ( Mode == 0 )
				{
					<div class="ench-label">Craft a blank Rune.</div>
					@if ( !HasRuneRecipe )
					{
						<div class="ench-empty">You haven't learned how to craft runes yet.</div>
					}
					@if ( HasRuneRecipe )
					{
						<div class="ench-row">
							<div class="ench-row-info">
								<div class="ench-row-title">Rune</div>
								<div class="ench-row-sub">@CraftStone Stone + @CraftDust Dust</div>
							</div>
							<div class="ench-btn @CraftBtnClass" onclick="@OnCraftClick">Craft</div>
						</div>
					}
				}

				@if ( Mode == 1 )
				{
					<div class="ench-label">Roll range at level @Level: +@MinRoll% to +@MaxRoll%</div>
					<div class="ench-label">Random costs @RandomDust dust. Targeted costs @TargetedDust dust.</div>

					@if ( BlankRunes.Count == 0 )
					{
						<div class="ench-empty">No blank runes in your inventory.</div>
					}
					@foreach ( var entry in BlankRunes )
					{
						int slot = entry.SlotIndex;
						bool isSelected = SelectedBlankSlot == slot;
						string rowClass = isSelected ? "selected" : "";

						<div class="ench-row @rowClass" onclick="@(() => SelectBlank(slot))">
							<div class="ench-row-info">
								<div class="ench-row-title">Blank Rune x@(entry.Count)</div>
								<div class="ench-row-sub">Click to pick a targeted type, or roll random</div>
							</div>
							<div class="ench-btn @(CanAffordRandom ? "" : "disabled")" onclick="@(() => EnchantRandom(slot))">Random</div>
						</div>
					}

					@if ( SelectedBlankSlot >= 0 )
					{
						<div class="ench-label">Targeted — pick a type:</div>
						<div class="ench-button-row">
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Sharpness))">Sharpness</div>
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Piercing))">Piercing</div>
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Power))">Power</div>
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Toughness))">Toughness</div>
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Vitality))">Vitality</div>
							<div class="ench-btn @(CanAffordTargeted ? "" : "disabled")" onclick="@(() => EnchantTargeted(EnchantmentType.Focus))">Focus</div>
						</div>
					}
				}

				@if ( Mode == 2 )
				{
					@if ( CombineLocked )
					{
						<div class="ench-empty">Combine unlocks at Enchanting level @CombineUnlock.</div>
					}
					@if ( !CombineLocked )
					{
						<div class="ench-label">@CombineCapText</div>
						<div class="ench-label">Pick two enchanted runes with the same enchantment.</div>

						@if ( EnchantedRunes.Count < 2 )
						{
							<div class="ench-empty">You need at least two enchanted runes to combine.</div>
						}
						@foreach ( var entry in EnchantedRunes )
						{
							int slot = entry.SlotIndex;
							bool isA = CombineA == slot;
							bool isB = CombineB == slot;
							bool atCap = entry.Rune.EnchantmentPercent >= CombineCap - 0.0001f;
							string rowClass = atCap ? "disabled" : ( ( isA || isB ) ? "selected" : "" );
							string tag = isA ? "[A]" : ( isB ? "[B]" : "" );

							<div class="ench-row @rowClass" onclick="@(() => SelectCombine(slot))">
								<div class="ench-row-info">
									<div class="ench-row-title">@tag @entry.Rune.GetDisplayName()</div>
									<div class="ench-row-sub">@(atCap ? "at cap" : "")</div>
								</div>
							</div>
						}

						@if ( CombineA >= 0 && CombineB >= 0 )
						{
							<div class="ench-button-row">
								<div class="ench-btn" onclick="@OnCombineClick">Combine (@CombineDust dust)</div>
							</div>
						}
					}
				}

				@if ( Mode == 3 )
				{
					@if ( SecondSocketLocked )
					{
						<div class="ench-label">2nd socket unlocks at Enchanting level @SecondSocketUnlock.</div>
					}
					<div class="ench-label">Pick a ring or amulet:</div>

					@if ( Socketables.Count == 0 )
					{
						<div class="ench-empty">No rings or amulets in your inventory.</div>
					}
					@foreach ( var entry in Socketables )
					{
						int slot = entry.SlotIndex;
						bool isSelected = SelectedJewelrySlot == slot;
						string rowClass = isSelected ? "selected" : "";

						<div class="ench-row @rowClass" onclick="@(() => SelectJewelry(slot))">
							<div class="ench-row-info">
								<div class="ench-row-title">@entry.Item.GetDisplayName()</div>
								<div class="ench-row-sub">@entry.Item.GetShortStat()</div>
							</div>
						</div>
					}

					@if ( SelectedJewelryItem != null )
					{
						<div class="ench-label">Pick a socket:</div>
						<div class="ench-button-row">
							@foreach ( var info in SocketSlotInfos )
							{
								int sIdx = info.Index;
								bool isSel = SelectedSocketIndex == sIdx;
								string sClass = isSel ? "selected" : "";
								string dClass = ( info.IsFilled || info.IsLocked ) ? "disabled" : "";

								<div class="ench-btn @sClass @dClass" onclick="@(() => SelectSocket(sIdx))">@info.Label</div>
							}
						</div>

						@if ( SelectedSocketIndex >= 0 )
						{
							<div class="ench-label">Pick a rune to socket:</div>
							@if ( EnchantedRunes.Count == 0 )
							{
								<div class="ench-empty">No enchanted runes available.</div>
							}
							@foreach ( var rEntry in EnchantedRunes )
							{
								int rSlot = rEntry.SlotIndex;
								bool blocked = SelectedJewelryItem.HasEnchantmentInSocket( rEntry.Rune.Enchantment );
								string rowClass = blocked ? "disabled" : "";

								<div class="ench-row @rowClass">
									<div class="ench-row-info">
										<div class="ench-row-title">@rEntry.Rune.GetDisplayName()</div>
										<div class="ench-row-sub">@(blocked ? "duplicate enchant" : "ready")</div>
									</div>
									<div class="ench-btn @(blocked ? "disabled" : "")" onclick="@(() => DoSocket(rSlot))">Socket</div>
								</div>
							}
						}
					}
				}

				@if ( Mode == 4 )
				{
					<div class="ench-label">Pick a socketed item:</div>
					@if ( SocketedItems.Count == 0 )
					{
						<div class="ench-empty">No socketed items in your inventory.</div>
					}
					@foreach ( var entry in SocketedItems )
					{
						int slot = entry.SlotIndex;
						bool isSelected = SelectedJewelrySlot == slot;
						string rowClass = isSelected ? "selected" : "";

						<div class="ench-row @rowClass" onclick="@(() => SelectJewelry(slot))">
							<div class="ench-row-info">
								<div class="ench-row-title">@entry.Item.GetDisplayName()</div>
								<div class="ench-row-sub">@entry.Item.GetShortStat()</div>
							</div>
						</div>
					}

					@if ( SelectedJewelryItem != null )
					{
						<div class="ench-label">Extract (@ExtractDust dust each):</div>
						<div class="ench-button-row">
							@foreach ( var info in ExtractSlotInfos )
							{
								int sIdx = info.Index;
								string dClass = info.IsFilled ? "" : "disabled";

								<div class="ench-btn @dClass" onclick="@(() => DoExtract(sIdx))">@info.Label</div>
							}
						</div>
					}
				}
			</div>
		</div>
	}
</root>

@code
{
	bool IsOpen => EnchantingStation.ActiveStation != null;
	string StationName => EnchantingStation.ActiveStation?.StationName ?? "Enchanting Altar";
	EnchantingStation Station => EnchantingStation.ActiveStation;

	int Mode { get; set; } = 0;
	int CombineA { get; set; } = -1;
	int CombineB { get; set; } = -1;
	int SelectedJewelrySlot { get; set; } = -1;
	int SelectedSocketIndex { get; set; } = -1;
	int SelectedBlankSlot { get; set; } = -1;

	Inventory PlayerInventory { get; set; }
	Skills PlayerSkills { get; set; }

	int DustCount => PlayerInventory?.GetItemCount( ItemId.ArcaneDust ) ?? 0;
	int StoneCount => PlayerInventory?.GetItemCount( ItemId.Rock ) ?? 0;
	int Level => PlayerSkills?.GetLevel( SkillType.Enchanting ) ?? 1;

	bool HasRuneRecipe => PlayerInventory?.IsRecipeUnlocked( EnchantingStation.RuneRecipeId ) ?? false;
	int CraftStone => Station?.CraftStoneCost ?? 0;
	int CraftDust => Station?.CraftDustCost ?? 0;
	bool CanCraft => HasRuneRecipe && StoneCount >= CraftStone && DustCount >= CraftDust;
	string CraftBtnClass => CanCraft ? "" : "disabled";

	int RandomDust => Station?.EnchantRandomDustCost ?? 0;
	int TargetedDust => Station?.EnchantTargetedDustCost ?? 0;
	bool CanAffordRandom => DustCount >= RandomDust;
	bool CanAffordTargeted => DustCount >= TargetedDust;

	string MinRoll => Station != null ? Station.GetMinRollPercent( Level ).ToString( "F1" ) : "1.0";
	string MaxRoll => Station != null ? Station.GetMaxRollPercent( Level ).ToString( "F1" ) : "2.0";

	int CombineUnlock => Station?.CombineUnlockLevel ?? 20;
	bool CombineLocked => Station != null && Level < Station.CombineUnlockLevel;
	float CombineCap => Station?.GetCombineCap( Level ) ?? 0f;
	int CombineDust => Station?.CombineDustCost ?? 0;

	string CombineCapText
	{
		get
		{
			if ( Station == null ) return "";
			int nextLevel = Station.GetNextCombineCapLevel( Level );
			float nextVal = Station.GetNextCombineCapValue( Level );
			if ( nextLevel > 0 )
				return $"Cap: +{CombineCap:F0}%  —  Next: +{nextVal:F0}% at Lvl {nextLevel}";
			return $"Cap: +{CombineCap:F0}%  —  MAX";
		}
	}

	int SecondSocketUnlock => Station?.SecondSocketUnlockLevel ?? 40;
	bool SecondSocketLocked => Station != null && Level < Station.SecondSocketUnlockLevel;
	int MaxSocketsForLevel => Station?.GetMaxSocketsForLevel( Level ) ?? 1;

	int ExtractDust => Station?.ExtractDustCost ?? 0;

	public class RuneEntry
	{
		public int SlotIndex;
		public int Count;
		public ItemInstance Rune;
	}

	public class ItemEntry
	{
		public int SlotIndex;
		public ItemInstance Item;
	}

	public class SocketInfo
	{
		public int Index;
		public string Label;
		public bool IsFilled;
		public bool IsLocked;
	}

	List<RuneEntry> BlankRunes { get; set; } = new();
	List<RuneEntry> EnchantedRunes { get; set; } = new();
	List<ItemEntry> Socketables { get; set; } = new();
	List<ItemEntry> SocketedItems { get; set; } = new();
	List<SocketInfo> SocketSlotInfos { get; set; } = new();
	List<SocketInfo> ExtractSlotInfos { get; set; } = new();

	ItemInstance SelectedJewelryItem
	{
		get
		{
			if ( PlayerInventory == null || SelectedJewelrySlot < 0 ) return null;
			var slot = PlayerInventory.GetSlot( SelectedJewelrySlot );
			return ( slot != null && slot.IsUnique ) ? slot.Unique : null;
		}
	}

	void SetMode( int mode )
	{
		Mode = mode;
		CombineA = -1;
		CombineB = -1;
		SelectedJewelrySlot = -1;
		SelectedSocketIndex = -1;
		SelectedBlankSlot = -1;
	}

	void SelectBlank( int slotIndex )
	{
		SelectedBlankSlot = ( SelectedBlankSlot == slotIndex ) ? -1 : slotIndex;
	}

	void SelectCombine( int slotIndex )
	{
		if ( PlayerInventory != null )
		{
			var slot = PlayerInventory.GetSlot( slotIndex );
			if ( slot != null && slot.IsUnique && slot.Unique.EnchantmentPercent >= CombineCap - 0.0001f )
				return;
		}

		if ( CombineA == slotIndex ) { CombineA = -1; return; }
		if ( CombineB == slotIndex ) { CombineB = -1; return; }
		if ( CombineA < 0 ) { CombineA = slotIndex; return; }
		if ( CombineB < 0 ) { CombineB = slotIndex; return; }
		CombineA = slotIndex;
		CombineB = -1;
	}

	void SelectJewelry( int slotIndex )
	{
		if ( SelectedJewelrySlot == slotIndex )
		{
			SelectedJewelrySlot = -1;
			SelectedSocketIndex = -1;
		}
		else
		{
			SelectedJewelrySlot = slotIndex;
			SelectedSocketIndex = -1;
		}
	}

	void SelectSocket( int socketIndex )
	{
		var jewelry = SelectedJewelryItem;
		if ( jewelry == null ) return;
		if ( jewelry.GetSocket( socketIndex ) != null ) return;
		if ( socketIndex >= MaxSocketsForLevel ) return;
		SelectedSocketIndex = socketIndex;
	}

	void OnCraftClick()
	{
		Station?.TryCraftRune();
	}

	void EnchantRandom( int slotIndex )
	{
		Station?.TryEnchantRandom( slotIndex );
		SelectedBlankSlot = -1;
	}

	void EnchantTargeted( EnchantmentType type )
	{
		if ( SelectedBlankSlot < 0 ) return;
		Station?.TryEnchantTargeted( SelectedBlankSlot, type );
		SelectedBlankSlot = -1;
	}

	void OnCombineClick()
	{
		if ( CombineA < 0 || CombineB < 0 ) return;
		Station?.TryCombine( CombineA, CombineB );
		CombineA = -1;
		CombineB = -1;
	}

	void DoSocket( int runeSlotIndex )
	{
		if ( SelectedJewelrySlot < 0 || SelectedSocketIndex < 0 ) return;
		Station?.TrySocket( SelectedJewelrySlot, SelectedSocketIndex, runeSlotIndex );
		SelectedSocketIndex = -1;
	}

	void DoExtract( int socketIndex )
	{
		if ( SelectedJewelrySlot < 0 ) return;
		Station?.TryExtract( SelectedJewelrySlot, socketIndex );
	}

	void OnBackdropClick()
	{
		Close();
	}

	void OnCloseClick()
	{
		Close();
	}

	void Close()
	{
		Mode = 0;
		CombineA = -1;
		CombineB = -1;
		SelectedJewelrySlot = -1;
		SelectedSocketIndex = -1;
		SelectedBlankSlot = -1;
		EnchantingStation.Close();
	}

	protected override int BuildHash()
	{
		if ( EnchantingStation.ActiveStation != null )
		{
			var player = PlayerHelper.GetLocalPlayer();
			PlayerInventory = player?.Components.Get<Inventory>();
			PlayerSkills = player?.Components.Get<Skills>();
		}
		else
		{
			PlayerInventory = null;
			PlayerSkills = null;
		}

		BlankRunes.Clear();
		EnchantedRunes.Clear();
		Socketables.Clear();
		SocketedItems.Clear();
		SocketSlotInfos.Clear();
		ExtractSlotInfos.Clear();

		if ( PlayerInventory != null )
		{
			int blankCount = 0;
			int blankSlot = -1;

			for ( int i = 0; i < PlayerInventory.MaxSlots; i++ )
			{
				var slot = PlayerInventory.GetSlot( i );
				if ( slot == null ) continue;

				if ( slot.IsStack && slot.ItemId == ItemId.Rune )
				{
					blankCount += slot.Count;
					if ( blankSlot < 0 ) blankSlot = i;
					continue;
				}

				if ( slot.IsUnique )
				{
					var inst = slot.Unique;
					if ( inst.IsRune && inst.IsEnchanted )
					{
						EnchantedRunes.Add( new RuneEntry { Rune = inst, SlotIndex = i } );
					}
					else if ( inst.IsSocketable )
					{
						var entry = new ItemEntry { Item = inst, SlotIndex = i };
						Socketables.Add( entry );
						if ( inst.SocketsUsed > 0 )
							SocketedItems.Add( entry );
					}
				}
			}

			if ( blankCount > 0 )
				BlankRunes.Add( new RuneEntry { SlotIndex = blankSlot, Count = blankCount } );
		}

		var sj = SelectedJewelryItem;
		if ( sj != null )
		{
			int maxForLevel = MaxSocketsForLevel;
			for ( int s = 0; s < sj.MaxSockets; s++ )
			{
				var rune = sj.GetSocket( s );
				bool locked = s >= maxForLevel;
				bool filled = rune != null;

				string label;
				if ( locked ) label = $"Socket {s + 1}: locked";
				else if ( filled ) label = $"Socket {s + 1}: {rune.Enchantment} +{rune.EnchantmentPercent:F1}%";
				else label = $"Socket {s + 1}: empty";

				SocketSlotInfos.Add( new SocketInfo { Index = s, Label = label, IsFilled = filled, IsLocked = locked } );

				string exLabel = filled
					? $"Socket {s + 1}: {rune.Enchantment} +{rune.EnchantmentPercent:F1}%"
					: $"Socket {s + 1}: empty";
				ExtractSlotInfos.Add( new SocketInfo { Index = s, Label = exLabel, IsFilled = filled, IsLocked = locked } );
			}
		}

		int runeHash = 0;
		foreach ( var e in EnchantedRunes )
			runeHash = HashCode.Combine( runeHash, (int)e.Rune.Enchantment, (int)( e.Rune.EnchantmentPercent * 10 ), e.SlotIndex );

		int jewelHash = 0;
		foreach ( var s in Socketables )
			jewelHash = HashCode.Combine( jewelHash, s.SlotIndex, s.Item.SocketsUsed );

		return HashCode.Combine(
			HashCode.Combine( IsOpen, Mode, Level, DustCount, StoneCount ),
			HashCode.Combine( CombineA, CombineB, SelectedJewelrySlot, SelectedSocketIndex, SelectedBlankSlot ),
			HashCode.Combine( BlankRunes.Count, EnchantedRunes.Count, Socketables.Count, SocketedItems.Count ),
			HashCode.Combine( runeHash, jewelHash, HasRuneRecipe )
		);
	}
}
