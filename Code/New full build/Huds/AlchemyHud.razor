@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="alch-backdrop" onclick="@(() => CloseStation())"></div>
		<div class="alch-popup">
			<div class="alch-corner c-tl">✧</div>
			<div class="alch-corner c-tr">✧</div>
			<div class="alch-corner c-bl">✧</div>
			<div class="alch-corner c-br">✧</div>

			<div class="alch-header">
				<div class="alch-title">⚗ @StationName</div>
				<div class="alch-chips">
					<div class="alch-chip level">Crafting Lvl @Level</div>
				</div>
				<div class="alch-close" onclick="@(() => CloseStation())">✕</div>
			</div>

			<div class="alch-body">
				<div class="alch-shelves">
					@foreach ( var shelf in GetShelves() )
					{
						<div class="alch-shelf">
							<div class="alch-shelf-label">@shelf.Label</div>
							<div class="alch-shelf-row">
								@foreach ( var pot in shelf.Potions )
								{
									var potLocal = pot;
									<div class="alch-bottle @(SelectedId == potLocal.RecipeId ? "selected" : "") @(potLocal.LevelLocked ? "locked" : "")" onclick="@(() => SelectPotion( potLocal.RecipeId ))">
										<div class="alch-icon-glyph">❖</div>
										<img class="alch-bottle-img" src="@IconPath( potLocal.Item )" />
										@if ( potLocal.LevelLocked )
										{
											<div class="alch-bottle-lv">Lv @potLocal.LevelRequired</div>
										}
										<div class="alch-bottle-count">@potLocal.OwnedCount</div>
										<div class="alch-tip">
											<div class="alch-tip-name">@potLocal.Name</div>
											<div class="alch-tip-effect">@potLocal.EffectText</div>
										</div>
									</div>
								}
							</div>
							<div class="alch-shelf-strip"></div>
						</div>
					}
				</div>

				<div class="alch-circle-col">
					<div class="alch-ring-area">
						@if ( Selected == null )
						{
							<div class="alch-ring-outer dim"></div>
							<div class="alch-select-hint">Select a potion</div>
						}
						else
						{
							<div class="alch-ring-outer"></div>
							<div class="alch-ring-inner"></div>

							@foreach ( var line in GetLineVms() )
							{
								<div class="alch-line" style="@line.Style">
									@if ( line.Have )
									{
										<div class="alch-line-fill" style="background-color: @line.Color;"></div>
									}
									else
									{
										@for ( int d = 0; d < line.DashCount; d++ )
										{
											<div class="alch-line-dash" style="background-color: @line.Color;"></div>
										}
									}
								</div>
							}

							@foreach ( var node in GetNodeVms() )
							{
								<div class="alch-node @(node.Have ? "have" : "missing")" style="left: @node.LeftPct%; top: @node.TopPct%;">
									<div class="alch-icon-glyph">❖</div>
									<img class="alch-node-img" src="@IconPath( node.Item )" />
									<div class="alch-node-label @(node.LabelAbove ? "above" : "below")">
										<div class="alch-node-name">@node.Name</div>
										<div class="alch-node-count @(node.Have ? "ok" : "bad")">@node.OwnedCount/@node.NeededCount</div>
									</div>
								</div>
							}

							<div class="alch-center" style="@CenterStyle()">
								<div class="alch-icon-glyph big">❖</div>
								<img class="alch-center-img" src="@IconPath( Selected.OutputItem )" />
							</div>
						}
					</div>
				</div>

				<div class="alch-info">
					@if ( Selected == null )
					{
						<div class="alch-info-empty">Pick a bottle from the shelves to see its recipe on the transmutation circle.</div>
					}
					else
					{
						<div class="alch-info-name">@Selected.Name</div>
						<div class="alch-info-effect @EffectClass( Selected.OutputItem )">@EffectText( Selected.OutputItem )</div>

						<div class="alch-info-divider"></div>

						<div class="alch-info-line">
							<div class="alch-il-label">Requires</div>
							<div class="alch-il-value @(MeetsLevel ? "" : "bad")">Crafting Lv @Selected.LevelRequired</div>
						</div>
						<div class="alch-info-line">
							<div class="alch-il-label">In bag</div>
							<div class="alch-il-value">@OwnedOfSelected</div>
						</div>
						<div class="alch-info-line">
							<div class="alch-il-label">Can brew</div>
							<div class="alch-il-value">@MaxBrews</div>
						</div>
						<div class="alch-info-line">
							<div class="alch-il-label">Reward</div>
							<div class="alch-il-value">+@Selected.XpReward XP</div>
						</div>

						@if ( !RecipeLearned )
						{
							<div class="alch-info-missing">Recipe not learned yet.</div>
						}
						else if ( MissingNames.Count > 0 )
						{
							<div class="alch-info-missing">Missing: @(string.Join( ", ", MissingNames ))</div>
						}

						<div class="alch-info-spacer"></div>

						<div class="alch-brew @(CanBrew ? "" : "disabled")" onclick="@(() => OnBrew())">Brew</div>
						<div class="alch-brew all @(CanBrew ? "" : "disabled")" onclick="@(() => OnBrewAll())">Brew all</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	CraftingStation Station
	{
		get
		{
			var s = CraftingStation.ActiveStation;
			if ( s == null || s.Station != StationType.AlchemyTable )
				return null;
			return s;
		}
	}

	bool IsOpen => Station != null;
	string StationName => Station?.StationName ?? "Alchemy Table";

	Inventory PlayerInventory => PlayerHelper.GetLocalInventory();
	Skills PlayerSkills => PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );
	PotionSystem Potions => PlayerHelper.GetLocalPlayer()?.Components.Get<PotionSystem>();

	int Level => PlayerSkills?.GetLevel( SkillType.Crafting ) ?? 1;

	string SelectedId { get; set; }
	RecipeDefinition Selected => SelectedId != null ? RecipeDatabase.GetById( SelectedId ) : null;

	const float FxDuration = 0.6f;
	const float RingSize = 460f;
	const float RingRadius = 170f;
	const float NodeRadius = 35f;
	const float CenterRadius = 50f;

	RealTimeSince _fxSince = 999f;
	bool FxActive => (float)_fxSince < FxDuration;
	float FxPulse => FxActive ? MathF.Sin( MathF.PI * ( (float)_fxSince / FxDuration ) ) : 0f;

	static readonly string[] HealingShelf = { "lesser_healing_potion", "healing_potion", "greater_healing_potion" };
	static readonly string[] ManaShelf = { "lesser_mana_potion", "mana_potion", "greater_mana_potion" };
	static readonly string[] CombatShelf = { "defence_potion", "attack_potion", "archery_potion", "magic_potion" };
	static readonly string[] ElixerShelf = { "elixir_of_power" };

	public class BottleVm
	{
		public string RecipeId;
		public ItemId Item;
		public string Name;
		public int OwnedCount;
		public int LevelRequired;
		public bool LevelLocked;
		public string EffectText;
	}

	public class ShelfVm
	{
		public string Label;
		public List<BottleVm> Potions = new();
	}

	public class NodeVm
	{
		public ItemId Item;
		public string Name;
		public int OwnedCount;
		public int NeededCount;
		public bool Have;
		public bool LabelAbove;
		public string LeftPct;
		public string TopPct;
	}

	public class LineVm
	{
		public bool Have;
		public string Color;
		public string Style;
		public int DashCount;
	}

	static string Num( float value )
	{
		return value.ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture );
	}

	string IconPath( ItemId id )
	{
		return $"/ItemIcons/{id}.vtex";
	}

	List<ShelfVm> GetShelves()
	{
		var shelves = new List<ShelfVm>();
		shelves.Add( BuildShelf( "HEALING", HealingShelf ) );
		shelves.Add( BuildShelf( "MANA", ManaShelf ) );
		shelves.Add( BuildShelf( "COMBAT", CombatShelf ) );
		shelves.Add( BuildShelf( "ELIXERS", ElixerShelf ) );
		return shelves;
	}

	ShelfVm BuildShelf( string label, string[] recipeIds )
	{
		var shelf = new ShelfVm { Label = label };
		var inventory = PlayerInventory;

		foreach ( var id in recipeIds )
		{
			var recipe = RecipeDatabase.GetById( id );
			if ( recipe == null )
				continue;

			shelf.Potions.Add( new BottleVm
			{
				RecipeId = id,
				Item = recipe.OutputItem,
				Name = recipe.Name,
				OwnedCount = inventory?.GetItemCount( recipe.OutputItem ) ?? 0,
				LevelRequired = recipe.LevelRequired,
				LevelLocked = Level < recipe.LevelRequired,
				EffectText = EffectText( recipe.OutputItem )
			} );
		}

		return shelf;
	}

	static float SlotAngle( int index, int count )
	{
		float start = count == 3 ? MathF.PI / 2f : -MathF.PI / 2f;
		return start + index * ( MathF.PI * 2f / count );
	}

	RecipeIngredient[] GetDisplayIngredients( RecipeDefinition recipe )
	{
		var source = recipe.Ingredients;

		int vialIndex = -1;
		for ( int i = 0; i < source.Length; i++ )
		{
			if ( source[i].Item == ItemId.GlassVial || source[i].Item == ItemId.CrystalVial )
			{
				vialIndex = i;
				break;
			}
		}

		if ( vialIndex < 0 || source.Length < 2 )
			return source;

		int bottomIndex = 0;
		float bestSin = -2f;
		for ( int i = 0; i < source.Length; i++ )
		{
			float s = MathF.Sin( SlotAngle( i, source.Length ) );
			if ( s >= bestSin - 0.0001f )
			{
				bestSin = s;
				bottomIndex = i;
			}
		}

		var list = new List<RecipeIngredient>( source );
		var vial = list[vialIndex];
		list.RemoveAt( vialIndex );
		list.Insert( bottomIndex, vial );
		return list.ToArray();
	}

	List<NodeVm> GetNodeVms()
	{
		var nodes = new List<NodeVm>();
		var recipe = Selected;
		if ( recipe == null )
			return nodes;

		var inventory = PlayerInventory;
		var ingredients = GetDisplayIngredients( recipe );
		int count = ingredients.Length;

		for ( int i = 0; i < count; i++ )
		{
			var ing = ingredients[i];
			var def = ItemDatabase.Get( ing.Item );

			float angle = SlotAngle( i, count );
			float ux = MathF.Cos( angle );
			float uy = MathF.Sin( angle );
			float x = RingSize / 2f + RingRadius * ux;
			float y = RingSize / 2f + RingRadius * uy;

			int have = inventory?.GetItemCount( ing.Item ) ?? 0;

			nodes.Add( new NodeVm
			{
				Item = ing.Item,
				Name = def != null ? def.Name : ing.Item.ToString(),
				OwnedCount = have,
				NeededCount = ing.Amount,
				Have = have >= ing.Amount,
				LabelAbove = uy < -0.01f,
				LeftPct = Num( x / RingSize * 100f ),
				TopPct = Num( y / RingSize * 100f )
			} );
		}

		return nodes;
	}

	List<LineVm> GetLineVms()
	{
		var lines = new List<LineVm>();
		var recipe = Selected;
		if ( recipe == null )
			return lines;

		var inventory = PlayerInventory;
		var ingredients = GetDisplayIngredients( recipe );
		int count = ingredients.Length;
		float center = RingSize / 2f;

		for ( int i = 0; i < count; i++ )
		{
			var ing = ingredients[i];
			int have = inventory?.GetItemCount( ing.Item ) ?? 0;
			bool haveEnough = have >= ing.Amount;

			float angle = SlotAngle( i, count );
			float ux = MathF.Cos( angle );
			float uy = MathF.Sin( angle );

			float startDist = CenterRadius;
			float endDist = RingRadius - NodeRadius;
			float length = endDist - startDist;
			float midDist = ( startDist + endDist ) / 2f;

			float midX = center + ux * midDist;
			float midY = center + uy * midDist;
			float degrees = angle * 180f / MathF.PI;

			float height = haveEnough && FxActive ? 2f + FxPulse * 2f : 2f;

			lines.Add( new LineVm
			{
				Have = haveEnough,
				Color = haveEnough ? LerpLineColor( FxPulse ) : "#c86464",
				DashCount = haveEnough ? 0 : 4,
				Style = $"left: {Num( midX - length / 2f )}px; top: {Num( midY - height / 2f )}px; width: {Num( length )}px; height: {Num( height )}px; transform: rotate({Num( degrees )}deg);"
			} );
		}

		return lines;
	}

	static string LerpLineColor( float pulse )
	{
		int r = (int)( 0x4c + ( 0x9c - 0x4c ) * pulse );
		int g = (int)( 0xaf + ( 0xff - 0xaf ) * pulse );
		int b = (int)( 0x78 + ( 0xc8 - 0x78 ) * pulse );
		return $"#{r:x2}{g:x2}{b:x2}";
	}

	string CenterStyle()
	{
		if ( !FxActive )
			return "";

		return $"transform: scale({Num( 1f + 0.12f * FxPulse )});";
	}

	string EffectClass( ItemId id )
	{
		switch ( id )
		{
			case ItemId.LesserHealingPotion:
			case ItemId.HealingPotion:
			case ItemId.GreaterHealingPotion:
				return "eff-heal";
			case ItemId.LesserManaPotion:
			case ItemId.ManaPotion:
			case ItemId.GreaterManaPotion:
				return "eff-mana";
			case ItemId.ElixirOfPower:
				return "eff-elixir";
			default:
				return "eff-buff";
		}
	}

	string EffectText( ItemId id )
	{
		var potions = Potions;
		float healTick = potions?.HealTickDuration ?? 2f;
		float buffDur = potions?.BuffDuration ?? 60f;
		float elixirDur = potions?.ElixirDuration ?? 60f;

		switch ( id )
		{
			case ItemId.LesserHealingPotion:
				return $"Heals {potions?.MinorHealAmount ?? 15} HP over {Num( healTick )}s";
			case ItemId.HealingPotion:
				return $"Heals {potions?.HealAmount ?? 30} HP over {Num( healTick )}s";
			case ItemId.GreaterHealingPotion:
				return $"Heals {potions?.GreaterHealAmount ?? 60} HP over {Num( healTick )}s";
			case ItemId.LesserManaPotion:
				return "Restores 25 mana";
			case ItemId.ManaPotion:
				return "Restores 60 mana";
			case ItemId.GreaterManaPotion:
				return "Restores 120 mana";
			case ItemId.AttackPotion:
				return $"+{Num( potions?.AttackBuffPercent ?? 15f )}% melee damage for {Num( buffDur )}s";
			case ItemId.DefencePotion:
				return $"+{Num( potions?.DefenceBuffPercent ?? 15f )}% armor for {Num( buffDur )}s";
			case ItemId.ArcheryPotion:
				return $"+{Num( potions?.ArcheryBuffPercent ?? 15f )}% ranged damage for {Num( buffDur )}s";
			case ItemId.MagicPotion:
				return $"+{Num( potions?.MagicBuffPercent ?? 15f )}% magic damage for {Num( buffDur )}s";
			case ItemId.ElixirOfPower:
				return $"+{Num( potions?.ElixirBuffPercent ?? 20f )}% all damage for {Num( elixirDur )}s";
			default:
				return "";
		}
	}

	bool MeetsLevel => Selected != null && Level >= Selected.LevelRequired;
	bool RecipeLearned => Selected != null && ( PlayerInventory?.IsRecipeUnlocked( Selected.Id ) ?? false );
	int OwnedOfSelected => Selected != null ? PlayerInventory?.GetItemCount( Selected.OutputItem ) ?? 0 : 0;

	int MaxBrews
	{
		get
		{
			var recipe = Selected;
			var inventory = PlayerInventory;
			if ( recipe == null || inventory == null )
				return 0;

			int min = int.MaxValue;
			foreach ( var ing in recipe.Ingredients )
			{
				if ( ing.Amount <= 0 )
					continue;

				int possible = inventory.GetItemCount( ing.Item ) / ing.Amount;
				if ( possible < min )
					min = possible;
			}

			return min == int.MaxValue ? 0 : min;
		}
	}

	List<string> MissingNames
	{
		get
		{
			var names = new List<string>();
			var recipe = Selected;
			var inventory = PlayerInventory;
			if ( recipe == null || inventory == null )
				return names;

			foreach ( var ing in recipe.Ingredients )
			{
				if ( inventory.GetItemCount( ing.Item ) >= ing.Amount )
					continue;

				var def = ItemDatabase.Get( ing.Item );
				names.Add( def != null ? def.Name : ing.Item.ToString() );
			}

			return names;
		}
	}

	bool CanBrew => Selected != null && RecipeLearned && MeetsLevel && MissingNames.Count == 0;

	void SelectPotion( string recipeId )
	{
		SelectedId = SelectedId == recipeId ? null : recipeId;
	}

	void OnBrew()
	{
		var station = Station;
		if ( station == null || Selected == null || !CanBrew )
			return;

		if ( station.TryCraft( Selected.Id ) )
			PlayBrewFeedback();
	}

	void OnBrewAll()
	{
		var station = Station;
		if ( station == null || Selected == null || !CanBrew )
			return;

		if ( station.TryCraftAll( Selected.Id ) > 0 )
			PlayBrewFeedback();
	}

	void PlayBrewFeedback()
	{
		_fxSince = 0f;
		SoundLibrary.PlayReceiveItem();

		if ( Selected != null )
			ItemPickupEffect.Trigger( Selected.OutputItem );
	}

	void CloseStation()
	{
		SelectedId = null;
		CraftingStation.Close();
	}

	protected override int BuildHash()
	{
		if ( !IsOpen )
		{
			if ( SelectedId != null )
				SelectedId = null;

			return 0;
		}

		var inventory = PlayerInventory;

		int countsHash = 0;
		foreach ( var recipe in RecipeDatabase.GetByStation( StationType.AlchemyTable ) )
		{
			countsHash = HashCode.Combine(
				countsHash,
				inventory?.GetItemCount( recipe.OutputItem ) ?? 0,
				inventory?.IsRecipeUnlocked( recipe.Id ) ?? false );
		}

		int ingredientHash = 0;
		var selected = Selected;
		if ( selected != null && inventory != null )
		{
			foreach ( var ing in selected.Ingredients )
				ingredientHash = HashCode.Combine( ingredientHash, inventory.GetItemCount( ing.Item ) );
		}

		int fxBucket = FxActive ? (int)( (float)_fxSince * 30f ) : -1;

		return HashCode.Combine( IsOpen, SelectedId ?? "", Level, countsHash, ingredientHash, fxBucket );
	}
}
