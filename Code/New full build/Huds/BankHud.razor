@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="bank-backdrop" onclick="@(() => CloseBank())"></div>
		<div class="bank-window">
			<div class="bank-header">
				<div class="bank-title">@StationName</div>
				<div class="bank-stored">@BankRows.Count stored</div>
				<div class="bank-close" onclick="@(() => CloseBank())">✕</div>
			</div>

			<div class="bank-body">

				<div class="bank-col">
					<div class="bank-search">
						<span class="bank-search-icon">🔍</span>
						<TextEntry @ref="BankSearchRef" class="bank-search-input" Value:bind="@BankSearch" Placeholder="Search bank"></TextEntry>
					</div>
					<div class="bank-sort-row">
						<div class="bank-sort-btn @(BankSortMode == SortMode.ByType ? "selected" : "")" onclick="@(() => SetBankSort( SortMode.ByType ))">Type</div>
						<div class="bank-sort-btn @(BankSortMode == SortMode.ByName ? "selected" : "")" onclick="@(() => SetBankSort( SortMode.ByName ))">Name</div>
						<div class="bank-sort-btn @(BankSortMode == SortMode.ByAmount ? "selected" : "")" onclick="@(() => SetBankSort( SortMode.ByAmount ))">Amount</div>
					</div>
					<div class="bank-grid">
						@if ( BankRows.Count == 0 )
						{
							<div class="bank-grid-empty">Bank is empty.</div>
						}
						@foreach ( var row in BankRows )
						{
							if ( row.IsUnique )
							{
								var def = ItemDatabase.Get( row.UniqueInstance.ItemId );
								bool magic = row.UniqueInstance.IsEnchanted || ( row.UniqueInstance.IsSocketable && row.UniqueInstance.SocketsUsed > 0 );
								string color = magic ? "#a080d0" : GetItemColor( def );
								string dn = row.UniqueInstance.GetDisplayName();
								bool sel = SelectedIsBank && SelectedIsUnique && SelectedUniqueIndex == row.BankUniqueIndex;
								bool dim = !string.IsNullOrWhiteSpace( BankSearch ) && !MatchesSearch( dn, BankSearch );
								int bidx = row.BankUniqueIndex;

								<div class="bank-slot @(sel ? "selected" : "") @(dim ? "dimmed" : "")" style="background: @color;" onclick="@(() => SelectUnique( true, bidx ))">
									<img class="bank-icon-img" src="@GetIconPath( row.UniqueInstance.ItemId )" />
								</div>
							}
							else
							{
								var def = ItemDatabase.Get( row.StackId );
								bool sel = SelectedItem == row.StackId && SelectedIsBank && !SelectedIsUnique;
								bool dim = !string.IsNullOrWhiteSpace( BankSearch ) && !MatchesSearch( def != null ? def.Name : row.StackId.ToString(), BankSearch );
								var sid = row.StackId;

								<div class="bank-slot @(sel ? "selected" : "") @(dim ? "dimmed" : "")" style="background: @GetItemColor( def );" onclick="@(() => Select( sid, true, false, -1 ))">
									<img class="bank-icon-img" src="@GetIconPath( row.StackId )" />
									<span class="bank-count">@FmtCount( row.StackCount )</span>
								</div>
							}
						}
					</div>
				</div>

				<div class="bank-hub">
					@if ( SelectedIsUnique && SelectedUniqueIndex >= 0 )
					{
						ItemInstance inst = GetSelectedUnique();
						if ( inst != null )
						{
							var udef = ItemDatabase.Get( inst.ItemId );
							bool magic = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
							string color = magic ? "#a080d0" : GetItemColor( udef );

							<div class="bank-preview">
								<div class="bank-preview-icon" style="background: @color;">
									<img class="bank-preview-img" src="@GetIconPath( inst.ItemId )" />
								</div>
								<div class="bank-preview-name">@inst.GetDisplayName()</div>
								<div class="bank-where">@(SelectedIsBank ? "Selected in bank" : "Selected in inventory")</div>
							</div>

							@if ( SelectedIsBank )
							{
								<div class="bank-action withdraw" onclick="@(() => WithdrawUnique())">Withdraw</div>
							}
							else
							{
								<div class="bank-action deposit" onclick="@(() => DepositUnique())">Deposit</div>
							}
						}
						else
						{
							<div class="bank-empty">Select an item to deposit or withdraw.</div>
						}
					}
					else if ( SelectedItem != ItemId.None )
					{
						var def = ItemDatabase.Get( SelectedItem );
						string name = def != null ? def.Name : SelectedItem.ToString();
						int bankCount = BankStorage != null ? BankStorage.GetItemCount( SelectedItem ) : 0;
						int invCount = PlayerInventory != null ? PlayerInventory.GetItemCount( SelectedItem ) : 0;
						int max = SelectedIsBank ? bankCount : invCount;
						int shownAmount = TransferAmount > max ? max : TransferAmount;
						if ( shownAmount < 1 ) shownAmount = 1;

						<div class="bank-preview">
							<div class="bank-preview-icon" style="background: @GetItemColor( def );">
								<img class="bank-preview-img" src="@GetIconPath( SelectedItem )" />
							</div>
							<div class="bank-preview-name">@name</div>
							<div class="bank-pill-row">
								<span class="bank-pill @(SelectedIsBank ? "on" : "")">Bank @FmtCount( bankCount )</span>
								<span class="bank-pill @(!SelectedIsBank ? "on" : "")">Inv @FmtCount( invCount )</span>
							</div>
						</div>

						<div class="bank-where">@(SelectedIsBank ? "Selected in bank" : "Selected in inventory")</div>

						<div class="bank-amount-row">
							<div class="bank-step" onclick="@(() => StepAmount( -1 ))">−</div>
							<div class="bank-amount-val">@shownAmount</div>
							<div class="bank-step" onclick="@(() => StepAmount( 1 ))">+</div>
						</div>

						<div class="bank-quick-row">
							<div class="bank-quick" onclick="@(() => SetAmount( 1 ))">1</div>
							<div class="bank-quick" onclick="@(() => SetAmount( 10 ))">10</div>
							<div class="bank-quick" onclick="@(() => SetAmount( 100 ))">100</div>
							<div class="bank-quick" onclick="@(() => SetAmount( max ))">All</div>
						</div>

						@if ( SelectedIsBank )
						{
							<div class="bank-action withdraw" onclick="@(() => DoTransfer())">Withdraw</div>
							<div class="bank-all" onclick="@(() => TransferAll())">Withdraw all</div>
						}
						else
						{
							<div class="bank-action deposit" onclick="@(() => DoTransfer())">Deposit</div>
							<div class="bank-all" onclick="@(() => TransferAll())">Deposit all</div>
						}
					}
					else
					{
						<div class="bank-empty">Select an item to deposit or withdraw.</div>
					}
				</div>

				<div class="bank-col">
					<div class="bank-search">
						<span class="bank-search-icon">🔍</span>
						<TextEntry @ref="InvSearchRef" class="bank-search-input" Value:bind="@InvSearch" Placeholder="Search inventory"></TextEntry>
					</div>
					<div class="bank-col-head">
						<span class="bank-col-label">Inventory</span>
					</div>
					<div class="bank-grid bank-inv-grid">
						@foreach ( var view in InventorySlots )
						{
							if ( view.IsEmpty )
							{
								<div class="bank-slot empty"></div>
							}
							else if ( view.IsUnique )
							{
								var def = ItemDatabase.Get( view.ItemId );
								bool magic = view.Unique.IsEnchanted || ( view.Unique.IsSocketable && view.Unique.SocketsUsed > 0 );
								string color = magic ? "#a080d0" : GetItemColor( def );
								string dn = view.Unique.GetDisplayName();
								bool sel = !SelectedIsBank && SelectedIsUnique && SelectedUniqueIndex == view.UniqueListIndex;
								bool dim = !string.IsNullOrWhiteSpace( InvSearch ) && !MatchesSearch( dn, InvSearch );
								int uidx = view.UniqueListIndex;

								<div class="bank-slot @(sel ? "selected" : "") @(dim ? "dimmed" : "")" style="background: @color;" onclick="@(() => SelectUnique( false, uidx ))">
									<img class="bank-icon-img" src="@GetIconPath( view.ItemId )" />
									@if ( view.IsEquipped )
									{
										<div class="bank-equip-badge">@view.EquipBadge</div>
									}
								</div>
							}
							else
							{
								var def = ItemDatabase.Get( view.ItemId );
								bool sel = SelectedItem == view.ItemId && !SelectedIsBank && !SelectedIsUnique;
								bool dim = !string.IsNullOrWhiteSpace( InvSearch ) && !MatchesSearch( def != null ? def.Name : view.ItemId.ToString(), InvSearch );
								var iid = view.ItemId;

								<div class="bank-slot @(sel ? "selected" : "") @(dim ? "dimmed" : "")" style="background: @GetItemColor( def );" onclick="@(() => Select( iid, false, false, -1 ))">
									<img class="bank-icon-img" src="@GetIconPath( view.ItemId )" />
									<span class="bank-count">@FmtCount( view.Count )</span>
									@if ( view.IsEquipped )
									{
										<div class="bank-equip-badge">@view.EquipBadge</div>
									}
								</div>
							}
						}
					</div>
				</div>

			</div>
		</div>
	}
</root>

@code
{
	bool IsOpen => BankStation.ActiveBank != null;
	string StationName => BankStation.ActiveBank?.StationName ?? "Bank";

	ItemId SelectedItem { get; set; } = ItemId.None;
	bool SelectedIsBank { get; set; }
	bool SelectedIsUnique { get; set; }
	int SelectedUniqueIndex { get; set; } = -1;

	int TransferAmount { get; set; } = 1;
	string BankSearch { get; set; } = "";
	string InvSearch { get; set; } = "";

	TextEntry BankSearchRef { get; set; }
	TextEntry InvSearchRef { get; set; }

	Inventory PlayerInventory { get; set; }
	BankStorage BankStorage { get; set; }

	Dictionary<ItemId, int> BankedItems { get; set; } = new();
	SortMode BankSortMode { get; set; } = SortMode.ByType;

	public class BankRow
	{
		public bool IsUnique;
		public ItemId StackId = ItemId.None;
		public int StackCount;
		public ItemInstance UniqueInstance;
		public int BankUniqueIndex = -1;
	}

	List<BankRow> BankRows { get; set; } = new();

	public class UniqueEntry
	{
		public ItemInstance Instance;
		public int BankIndex = -1;
		public int InventoryIndex = -1;
	}

	List<UniqueEntry> BankedUnique { get; set; } = new();

	public class SlotView
	{
		public bool IsEmpty;
		public bool IsStack;
		public bool IsUnique;
		public ItemId ItemId = ItemId.None;
		public int Count;
		public ItemInstance Unique;
		public int UniqueListIndex = -1;
		public int SlotIndex = -1;
		public bool IsEquipped;
		public string EquipBadge = "";
	}

	List<SlotView> InventorySlots { get; set; } = new();

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		if ( id == ItemId.Gem ) return "/ItemIcons/FineGem.vtex";
		if ( id == ItemId.Ring ) return "/ItemIcons/FineRing.vtex";
		if ( id == ItemId.Amulet ) return "/ItemIcons/FineAmulet.vtex";

		return $"/ItemIcons/{id}.vtex";
	}

	string GetEquipBadge( EquipSlot slot )
	{
		switch ( slot )
		{
			case EquipSlot.Weapon: return "⚔";
			case EquipSlot.Shield: return "🛡";
			case EquipSlot.Head: return "⛑";
			case EquipSlot.Chest: return "🎽";
			case EquipSlot.Legs: return "👖";
			case EquipSlot.Ring: return "💍";
			case EquipSlot.Amulet: return "📿";
			case EquipSlot.Ammo: return "🏹";
			default: return "★";
		}
	}

	string FmtCount( int n )
	{
		if ( n >= 1000000 ) return $"{n / 1000000}m";
		if ( n >= 10000 ) return $"{n / 1000}k";
		return n.ToString();
	}

	bool MatchesSearch( string name, string search )
	{
		if ( string.IsNullOrWhiteSpace( search ) )
			return true;

		return name.ToLower().Contains( search.ToLower() );
	}

	void Select( ItemId item, bool isBank, bool isUnique, int uniqueIndex )
	{
		SelectedItem = item;
		SelectedIsBank = isBank;
		SelectedIsUnique = isUnique;
		SelectedUniqueIndex = uniqueIndex;
		TransferAmount = 1;
	}

	void SelectUnique( bool isBank, int index )
	{
		SelectedItem = ItemId.None;
		SelectedIsBank = isBank;
		SelectedIsUnique = true;
		SelectedUniqueIndex = index;
		TransferAmount = 1;
	}

	ItemInstance GetSelectedUnique()
	{
		if ( SelectedUniqueIndex < 0 )
			return null;

		if ( SelectedIsBank )
		{
			if ( BankStorage == null )
				return null;

			var list = BankStorage.GetBankedUnique();
			if ( SelectedUniqueIndex < list.Count )
				return list[SelectedUniqueIndex];

			return null;
		}

		if ( PlayerInventory == null )
			return null;

		var inv = PlayerInventory.GetUniqueItems();
		if ( SelectedUniqueIndex < inv.Count )
			return inv[SelectedUniqueIndex];

		return null;
	}

	int CurrentMax()
	{
		if ( SelectedItem == ItemId.None )
			return 1;

		int n = SelectedIsBank
			? ( BankStorage != null ? BankStorage.GetItemCount( SelectedItem ) : 0 )
			: ( PlayerInventory != null ? PlayerInventory.GetItemCount( SelectedItem ) : 0 );

		return n < 1 ? 1 : n;
	}

	void StepAmount( int delta )
	{
		SetAmount( TransferAmount + delta );
	}

	void SetAmount( int amount )
	{
		int m = CurrentMax();
		int v = amount;
		if ( v < 1 ) v = 1;
		if ( v > m ) v = m;
		TransferAmount = v;
	}

	void DoTransfer()
	{
		if ( SelectedItem == ItemId.None )
			return;

		int amt = TransferAmount;
		int m = CurrentMax();
		if ( amt > m ) amt = m;
		if ( amt < 1 )
			return;

		if ( SelectedIsBank )
			Withdraw( amt );
		else
			Deposit( amt );
	}

	void TransferAll()
	{
		if ( SelectedItem == ItemId.None )
			return;

		if ( SelectedIsBank )
			Withdraw( CurrentMax() );
		else
			Deposit( CurrentMax() );
	}

	void Deposit( int amount )
	{
		if ( BankStation.ActiveBank == null || SelectedItem == ItemId.None )
			return;

		BankStation.ActiveBank.DoDeposit( SelectedItem, amount );
	}

	void Withdraw( int amount )
	{
		if ( BankStation.ActiveBank == null || SelectedItem == ItemId.None )
			return;

		BankStation.ActiveBank.DoWithdraw( SelectedItem, amount );
	}

	void DepositUnique()
	{
		if ( BankStation.ActiveBank == null || SelectedUniqueIndex < 0 )
			return;

		BankStation.ActiveBank.DoDepositUnique( SelectedUniqueIndex );
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
	}

	void WithdrawUnique()
	{
		if ( BankStation.ActiveBank == null || SelectedUniqueIndex < 0 )
			return;

		BankStation.ActiveBank.DoWithdrawUnique( SelectedUniqueIndex );
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
	}

	void CloseBank()
	{
		SelectedItem = ItemId.None;
		SelectedIsUnique = false;
		SelectedUniqueIndex = -1;
		TransferAmount = 1;
		BankSearch = "";
		InvSearch = "";
		BankStation.Close();
	}

	string GetItemColor( ItemDefinition def )
	{
		if ( def == null ) return "#888";

		switch ( def.Type )
		{
			case ItemType.Tool: return "#8B6914";
			case ItemType.MeleeWeapon: return "#c0c0c0";
			case ItemType.RangedWeapon: return "#7a5230";
			case ItemType.MagicWeapon: return "#7a5aaa";
			case ItemType.Arrow: return "#9a7a5a";
			case ItemType.Shield: return "#6a7a8a";
			case ItemType.HeavyArmor: return "#8a8a9a";
			case ItemType.MediumArmor: return "#7a8a6a";
			case ItemType.LightArmor: return "#6a6a8a";
			case ItemType.Bar: return "#d4a030";
			case ItemType.Herb: return "#4a8a4a";
			case ItemType.Potion: return "#d44a4a";
			case ItemType.Resource: return "#6a8a6a";
			case ItemType.Ring: return "#d4aa40";
			case ItemType.Amulet: return "#40aad4";
			case ItemType.Misc: return "#8a8a6a";
			default: return "#888";
		}
	}

	protected override int BuildHash()
	{
		var bank = BankStation.ActiveBank;

		if ( bank != null )
		{
			PlayerInventory = PlayerHelper.GetLocalInventory();
			BankStorage = PlayerHelper.GetLocalPlayer()?.Components.Get<BankStorage>();

			BankedItems = BankStorage != null ? new Dictionary<ItemId, int>( BankStorage.GetAllItems() ) : new();

			BankedUnique.Clear();
			if ( BankStorage != null )
			{
				var bankedU = BankStorage.GetBankedUnique();
				for ( int i = 0; i < bankedU.Count; i++ )
					BankedUnique.Add( new UniqueEntry { Instance = bankedU[i], BankIndex = i } );
			}

			InventorySlots.Clear();
			if ( PlayerInventory != null )
			{
				var slots = PlayerInventory.GetSlots();
				int max = PlayerInventory.MaxSlots;
				int uniqueCounter = 0;

				for ( int i = 0; i < max && i < slots.Count; i++ )
				{
					var s = slots[i];
					var view = new SlotView();
					view.SlotIndex = i;

					if ( PlayerInventory.IsSlotEquipped( i ) )
					{
						view.IsEquipped = true;
						view.EquipBadge = GetEquipBadge( PlayerInventory.GetEquippedSlotTypeAt( i ) );
					}

					if ( s.IsUnique )
					{
						view.IsUnique = true;
						view.Unique = s.Unique;
						view.ItemId = s.Unique.ItemId;
						view.UniqueListIndex = uniqueCounter;
						uniqueCounter++;
					}
					else if ( s.IsStack )
					{
						view.IsStack = true;
						view.ItemId = s.ItemId;
						view.Count = s.Count;
					}
					else
					{
						view.IsEmpty = true;
					}

					InventorySlots.Add( view );
				}
			}
		}
		else
		{
			BankedItems.Clear();
			BankedUnique.Clear();
			InventorySlots.Clear();
			SelectedItem = ItemId.None;
			SelectedIsUnique = false;
			SelectedUniqueIndex = -1;
		}

		BankRows.Clear();
		foreach ( var kv in BankedItems )
			BankRows.Add( new BankRow { IsUnique = false, StackId = kv.Key, StackCount = kv.Value } );

		foreach ( var entry in BankedUnique )
			BankRows.Add( new BankRow { IsUnique = true, UniqueInstance = entry.Instance, BankUniqueIndex = entry.BankIndex } );

		BankRows.Sort( ( a, b ) => CompareBankRows( a, b, BankSortMode ) );

		int bankHash = 0;
		foreach ( var row in BankRows )
		{
			if ( row.IsUnique )
				bankHash += (int)row.UniqueInstance.ItemId * 137 + row.BankUniqueIndex;
			else
				bankHash += (int)row.StackId * 100 + row.StackCount;
		}

		int invHash = 0;
		for ( int i = 0; i < InventorySlots.Count; i++ )
		{
			var v = InventorySlots[i];
			if ( v.IsUnique )
				invHash += ( (int)v.ItemId * 131 + i ) * 7 + ( v.IsEquipped ? 911 : 0 );
			else if ( v.IsStack )
				invHash += ( (int)v.ItemId * 100 + v.Count ) * 3 + i + ( v.IsEquipped ? 911 : 0 );
		}

		return HashCode.Combine(
			HashCode.Combine( IsOpen, StationName, SelectedItem, SelectedIsBank, SelectedIsUnique, SelectedUniqueIndex, (int)BankSortMode, bankHash ),
			HashCode.Combine( invHash, BankedUnique.Count, InventorySlots.Count, BankSearch ?? "", InvSearch ?? "", TransferAmount )
		);
	}

	void SetBankSort( SortMode mode )
	{
		BankSortMode = mode;
	}

	static int CompareBankRows( BankRow a, BankRow b, SortMode mode )
	{
		ItemId idA = a.IsUnique ? a.UniqueInstance.ItemId : a.StackId;
		ItemId idB = b.IsUnique ? b.UniqueInstance.ItemId : b.StackId;

		var defA = ItemDatabase.Get( idA );
		var defB = ItemDatabase.Get( idB );

		string nameA = defA != null ? defA.Name : idA.ToString();
		string nameB = defB != null ? defB.Name : idB.ToString();
		int tierA = defA != null ? defA.Tier : 0;
		int tierB = defB != null ? defB.Tier : 0;
		int typeA = defA != null ? (int)defA.Type : 0;
		int typeB = defB != null ? (int)defB.Type : 0;
		int countA = a.IsUnique ? 1 : a.StackCount;
		int countB = b.IsUnique ? 1 : b.StackCount;

		switch ( mode )
		{
			case SortMode.ByName:
				return string.Compare( nameA, nameB, StringComparison.OrdinalIgnoreCase );

			case SortMode.ByAmount:
			{
				int c = countB.CompareTo( countA );
				return c != 0 ? c : string.Compare( nameA, nameB, StringComparison.OrdinalIgnoreCase );
			}

			case SortMode.ByType:
			default:
			{
				int c = typeA.CompareTo( typeB );
				if ( c != 0 ) return c;

				c = tierA.CompareTo( tierB );
				if ( c != 0 ) return c;

				return string.Compare( nameA, nameB, StringComparison.OrdinalIgnoreCase );
			}
		}
	}
}
