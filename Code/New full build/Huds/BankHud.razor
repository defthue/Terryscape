@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="bank-backdrop" onclick="@(() => CloseBank())"></div>
		<div class="bank-overlay">
			<div class="bank-popup">
				<div class="bank-header">
					<div class="bank-title">@StationName</div>
					<div class="bank-close" onclick="@(() => CloseBank())">✕</div>
				</div>

				<div class="bank-body">
					<div class="bank-toolbar">
						<TextEntry class="bank-search" @ref="SearchRef" Value:bind="@Search" Placeholder="Search items"></TextEntry>
						<div class="bank-btn @(SortMode == 0 ? "active" : "")" onclick="@(() => SetSort( 0 ))">Type</div>
						<div class="bank-btn @(SortMode == 1 ? "active" : "")" onclick="@(() => SetSort( 1 ))">Name</div>
						<div class="bank-btn @(SortMode == 2 ? "active" : "")" onclick="@(() => SetSort( 2 ))">Amount</div>
					</div>

					<div class="bank-zone-label">Bank · @TotalBankRows items</div>

					<div class="bank-grid">
						@foreach ( var row in GetPageRows() )
						{
							@if ( row == null )
							{
								<div class="bank-slot"></div>
							}
							else if ( row.IsUnique )
							{
								var inst = row.Inst;
								var udef = ItemDatabase.Get( inst.ItemId );
								bool magic = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
								string bg = magic ? "#a080d0" : GetItemColor( udef );
								var r = row;

								<div class="bank-slot" style="background: @bg;" onclick="@(() => ClickBankRow( r ))">
									<img class="bank-slot-img" src="@GetIconPath( inst.ItemId )" />
									<div class="bank-tt">
										<div class="bank-tt-name">@inst.GetDisplayName()</div>
										@if ( magic )
										{
											<div class="bank-tt-ench">@inst.GetShortStat()</div>
										}
										@foreach ( var line in InspectorLines( udef, 1 ) )
										{
											<div class="bank-tt-line">@line</div>
										}
										<div class="bank-tt-hint">Click to withdraw</div>
									</div>
								</div>
							}
							else
							{
								var def = ItemDatabase.Get( row.Id );
								bool dim = IsDimmed( def != null ? def.Name : row.Id.ToString() );
								var r = row;

								<div class="bank-slot" style="background: @GetItemColor( def ); @(dim ? "opacity: 0.35;" : "")" onclick="@(() => ClickBankRow( r ))">
									<img class="bank-slot-img" src="@GetIconPath( row.Id )" />
									<div class="bank-count">@FmtCount( row.Count )</div>
									<div class="bank-tt">
										<div class="bank-tt-name">@(def != null ? def.Name : row.Id.ToString())</div>
										@foreach ( var line in InspectorLines( def, row.Count ) )
										{
											<div class="bank-tt-line">@line</div>
										}
										<div class="bank-tt-hint">Click to withdraw @AmountLabel( row.Count )</div>
									</div>
								</div>
							}
						}
					</div>

					@if ( PageCount > 1 )
					{
						<div class="bank-pager">
							<div class="bank-btn" onclick="@(() => StepPage( -1 ))">◀</div>
							<div class="bank-page-label">Page @(Page + 1) / @PageCount</div>
							<div class="bank-btn" onclick="@(() => StepPage( 1 ))">▶</div>
						</div>
					}

					<div class="bank-actionbar">
						<div class="bank-btn @(QuantityIndex == 0 ? "active" : "")" onclick="@(() => QuantityIndex = 0)">1</div>
						<div class="bank-btn @(QuantityIndex == 1 ? "active" : "")" onclick="@(() => QuantityIndex = 1)">10</div>
						<div class="bank-btn @(QuantityIndex == 2 ? "active" : "")" onclick="@(() => QuantityIndex = 2)">100</div>
						<div class="bank-btn @(QuantityIndex == 3 ? "active" : "")" onclick="@(() => QuantityIndex = 3)">1K</div>
						<div class="bank-btn @(QuantityIndex == 4 ? "active" : "")" onclick="@(() => QuantityIndex = 4)">10K</div>
						<div class="bank-btn @(QuantityIndex == 5 ? "active" : "")" onclick="@(() => QuantityIndex = 5)">All</div>
						<div class="bank-spacer"></div>
						<div class="bank-btn @(BulkArmed ? "danger" : "")" onclick="@(() => ClickDepositAll())">@(BulkArmed ? "Sure?" : "Deposit all")</div>
					</div>

					<div class="bank-zone-label">Inventory · @UsedSlots/@TotalSlots slots</div>

					<div class="bank-grid">
						@foreach ( var view in GetInventoryViews() )
						{
							@if ( view.IsEmpty )
							{
								<div class="bank-slot">
									@if ( view.SlotIndex < Inventory.HotbarSize )
									{
										<div class="bank-hotkey">@(view.SlotIndex + 1)</div>
									}
								</div>
							}
							else if ( view.IsUnique )
							{
								var inst = view.Unique;
								var udef = ItemDatabase.Get( inst.ItemId );
								bool magic = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
								string bg = magic ? "#a080d0" : GetItemColor( udef );
								var v = view;

								<div class="bank-slot" style="background: @bg;" onclick="@(() => ClickInvView( v ))">
									<img class="bank-slot-img" src="@GetIconPath( inst.ItemId )" />
									@if ( view.SlotIndex < Inventory.HotbarSize )
									{
										<div class="bank-hotkey">@(view.SlotIndex + 1)</div>
									}
									<div class="bank-tt">
										<div class="bank-tt-name">@inst.GetDisplayName()</div>
										@if ( magic )
										{
											<div class="bank-tt-ench">@inst.GetShortStat()</div>
										}
										@foreach ( var line in InspectorLines( udef, 1 ) )
										{
											<div class="bank-tt-line">@line</div>
										}
										<div class="bank-tt-hint">@(view.IsEquipped ? "Unequip it first" : "Click to deposit")</div>
									</div>
								</div>
							}
							else
							{
								var def = ItemDatabase.Get( view.Id );
								bool dim = IsDimmed( def != null ? def.Name : view.Id.ToString() );
								var v = view;

								<div class="bank-slot" style="background: @GetItemColor( def ); @(dim ? "opacity: 0.35;" : "")" onclick="@(() => ClickInvView( v ))">
									<img class="bank-slot-img" src="@GetIconPath( view.Id )" />
									<div class="bank-count">@FmtCount( view.Count )</div>
									@if ( view.SlotIndex < Inventory.HotbarSize )
									{
										<div class="bank-hotkey">@(view.SlotIndex + 1)</div>
									}
									<div class="bank-tt">
										<div class="bank-tt-name">@(def != null ? def.Name : view.Id.ToString())</div>
										@foreach ( var line in InspectorLines( def, view.Count ) )
										{
											<div class="bank-tt-line">@line</div>
										}
										<div class="bank-tt-hint">@(view.IsEquipped ? "Unequip it first" : $"Click to deposit {AmountLabel( TotalInvCount( view.Id ) )}")</div>
									</div>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	bool IsOpen => BankStation.ActiveBank != null;
	string StationName => BankStation.ActiveBank?.StationName ?? "Bank";

	int QuantityIndex { get; set; } = 0;
	int Page { get; set; } = 0;
	int SortMode { get; set; } = 0;
	string Search { get; set; } = "";
	float BulkDeadline { get; set; } = 0f;

	TextEntry SearchRef { get; set; }

	Inventory PlayerInventory { get; set; }
	BankStorage Bank { get; set; }

	bool BulkArmed => BulkDeadline > Time.Now;

	const int PageSize = 50;

	public class BankRow
	{
		public bool IsUnique;
		public ItemId Id = ItemId.None;
		public int Count;
		public ItemInstance Inst;
		public int UniqueIndex = -1;
	}

	public class InvView
	{
		public bool IsEmpty = true;
		public bool IsUnique;
		public ItemId Id = ItemId.None;
		public int Count;
		public ItemInstance Unique;
		public int SlotIndex;
		public bool IsEquipped;
	}

	List<BankRow> AllBankRows { get; set; } = new();
	List<InvView> InventoryViews { get; set; } = new();

	int TotalBankRows => AllBankRows.Count( r => !IsRowDimmed( r ) );
	int PageCount => Math.Max( 1, ( FilteredRows().Count + PageSize - 1 ) / PageSize );
	int TotalSlots => PlayerInventory != null ? PlayerInventory.MaxSlots : 30;
	int UsedSlots => InventoryViews.Count( v => !v.IsEmpty );

	List<BankRow> FilteredRows()
	{
		if ( string.IsNullOrWhiteSpace( Search ) )
			return AllBankRows;

		return AllBankRows.Where( r => !IsRowDimmed( r ) ).ToList();
	}

	bool IsRowDimmed( BankRow r )
	{
		if ( string.IsNullOrWhiteSpace( Search ) )
			return false;

		string name = r.IsUnique
			? r.Inst.GetDisplayName()
			: ( ItemDatabase.Get( r.Id )?.Name ?? r.Id.ToString() );

		return !name.ToLower().Contains( Search.ToLower() );
	}

	bool IsDimmed( string name )
	{
		if ( string.IsNullOrWhiteSpace( Search ) )
			return false;

		return !name.ToLower().Contains( Search.ToLower() );
	}

	List<BankRow> GetPageRows()
	{
		var filtered = FilteredRows();
		int start = Page * PageSize;
		var page = new List<BankRow>();

		for ( int i = 0; i < PageSize; i++ )
		{
			int idx = start + i;
			page.Add( idx < filtered.Count ? filtered[idx] : null );
		}

		return page;
	}

	void RebuildBankRows()
	{
		AllBankRows.Clear();

		if ( Bank == null )
			return;

		foreach ( var kv in Bank.GetAllItems() )
		{
			AllBankRows.Add( new BankRow { IsUnique = false, Id = kv.Key, Count = kv.Value } );
		}

		var uniques = Bank.GetBankedUnique();
		for ( int i = 0; i < uniques.Count; i++ )
		{
			AllBankRows.Add( new BankRow { IsUnique = true, Inst = uniques[i], UniqueIndex = i, Id = uniques[i].ItemId } );
		}

		if ( SortMode == 1 )
			AllBankRows = AllBankRows.OrderBy( r => RowName( r ) ).ToList();
		else if ( SortMode == 2 )
			AllBankRows = AllBankRows.OrderByDescending( r => r.Count ).ThenBy( r => RowName( r ) ).ToList();
		else
			AllBankRows = AllBankRows.OrderBy( r => RowTypeKey( r ) ).ThenBy( r => RowName( r ) ).ToList();
	}

	string RowName( BankRow r )
	{
		return r.IsUnique ? r.Inst.GetDisplayName() : ( ItemDatabase.Get( r.Id )?.Name ?? r.Id.ToString() );
	}

	int RowTypeKey( BankRow r )
	{
		var def = ItemDatabase.Get( r.Id );
		return def != null ? (int)def.Type : 999;
	}

	List<InvView> GetInventoryViews()
	{
		return InventoryViews;
	}

	void RebuildInventoryViews()
	{
		InventoryViews.Clear();

		if ( PlayerInventory == null )
			return;

		for ( int i = 0; i < PlayerInventory.MaxSlots; i++ )
		{
			var view = new InvView { SlotIndex = i };
			var slot = PlayerInventory.GetSlot( i );

			if ( slot != null && !slot.IsEmpty )
			{
				view.IsEmpty = false;
				view.IsUnique = slot.IsUnique;

				if ( slot.IsUnique )
				{
					view.Unique = slot.Unique;
					view.Id = slot.Unique.ItemId;
				}
				else
				{
					view.Id = slot.ItemId;
					view.Count = slot.Count;
				}

				view.IsEquipped = IsSlotEquipped( i );
			}

			InventoryViews.Add( view );
		}
	}

	bool IsSlotEquipped( int slotIndex )
	{
		if ( PlayerInventory == null )
			return false;

		return PlayerInventory.IsSlotEquipped( slotIndex );
	}

	int ComputeAmount( int max )
	{
		if ( QuantityIndex == 5 )
			return max;

		int mode = QuantityIndex == 0 ? 1 : QuantityIndex == 1 ? 10 : QuantityIndex == 2 ? 100 : QuantityIndex == 3 ? 1000 : 10000;
		return Math.Min( mode, max );
	}

	string AmountLabel( int max )
	{
		if ( QuantityIndex == 5 )
			return $"All ({FmtCount( max )})";

		int mode = QuantityIndex == 0 ? 1 : QuantityIndex == 1 ? 10 : QuantityIndex == 2 ? 100 : QuantityIndex == 3 ? 1000 : 10000;
		return FmtCount( Math.Min( mode, max ) );
	}

	int TotalInvCount( ItemId id )
	{
		return PlayerInventory != null ? PlayerInventory.GetItemCount( id ) : 0;
	}

	void ClickBankRow( BankRow row )
	{
		if ( BankStation.ActiveBank == null || row == null )
			return;

		if ( row.IsUnique )
		{
			BankStation.ActiveBank.DoWithdrawUnique( row.UniqueIndex );
			return;
		}

		int amt = ComputeAmount( Bank != null ? Bank.GetItemCount( row.Id ) : 0 );
		if ( amt < 1 )
			return;

		BankStation.ActiveBank.DoWithdraw( row.Id, amt );
	}

	void ClickInvView( InvView view )
	{
		if ( BankStation.ActiveBank == null || view == null || view.IsEmpty )
			return;

		if ( view.IsEquipped )
		{
			GameLog.Add( "Unequip it first.", "#c86464" );
			return;
		}

		if ( view.IsUnique )
		{
			int idx = PlayerInventory.GetUniqueItems().IndexOf( view.Unique );
			if ( idx >= 0 )
				BankStation.ActiveBank.DoDepositUnique( idx );
			return;
		}

		int amt = ComputeAmount( TotalInvCount( view.Id ) );
		if ( amt < 1 )
			return;

		BankStation.ActiveBank.DoDeposit( view.Id, amt );
	}

	void ClickDepositAll()
	{
		if ( !BulkArmed )
		{
			BulkDeadline = Time.Now + 3f;
			return;
		}

		BulkDeadline = 0f;

		var totals = new Dictionary<ItemId, int>();
		foreach ( var v in InventoryViews )
		{
			if ( v.IsEmpty || v.IsUnique || v.IsEquipped )
				continue;
			if ( v.SlotIndex < Inventory.HotbarSize )
				continue;

			if ( totals.ContainsKey( v.Id ) )
				totals[v.Id] += v.Count;
			else
				totals[v.Id] = v.Count;
		}

		foreach ( var kv in totals )
			BankStation.ActiveBank?.DoDeposit( kv.Key, kv.Value );
	}

	void SetSort( int mode )
	{
		SortMode = mode;
		Page = 0;
	}

	void StepPage( int delta )
	{
		int next = Page + delta;
		if ( next < 0 ) next = 0;
		if ( next > PageCount - 1 ) next = PageCount - 1;
		Page = next;
	}

	void CloseBank()
	{
		Page = 0;
		Search = "";
		BulkDeadline = 0f;
		BankStation.Close();
	}

	List<string> InspectorLines( ItemDefinition def, int count )
	{
		var lines = new List<string>();

		if ( def == null )
			return lines;

		if ( count > 1 )
			lines.Add( $"x{FmtCount( count )}" );
		if ( def.Tier > 0 )
			lines.Add( $"Tier {def.Tier}" );
		if ( def.WeaponPower > 0 )
			lines.Add( $"Power {def.WeaponPower}" );
		if ( def.ArmorValue > 0 )
			lines.Add( $"Armor {def.ArmorValue}" );
		if ( def.BaseSellPrice > 0 )
			lines.Add( $"Sells {def.BaseSellPrice}g" );

		return lines;
	}

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		if ( id == ItemId.Gem ) return "/ItemIcons/FineGem.vtex";
		if ( id == ItemId.Ring ) return "/ItemIcons/FineRing.vtex";
		if ( id == ItemId.Amulet ) return "/ItemIcons/FineAmulet.vtex";

		return $"/ItemIcons/{id}.vtex";
	}

	string GetItemColor( ItemDefinition def )
	{
		if ( def == null ) return "#888";

		switch ( def.Type )
		{
			case ItemType.Tool: return "#8B6914";
			case ItemType.MeleeWeapon: return "#c0c0c0";
			case ItemType.RangedWeapon: return "#7a5230";
			case ItemType.MagicWeapon: return "#7a5aaa";
			case ItemType.Arrow: return "#9a7a5a";
			case ItemType.Shield: return "#6a7a8a";
			case ItemType.HeavyArmor: return "#8a8a9a";
			case ItemType.MediumArmor: return "#7a8a6a";
			case ItemType.LightArmor: return "#6a6a8a";
			case ItemType.Bar: return "#d4a030";
			case ItemType.Herb: return "#4a8a4a";
			case ItemType.Potion: return "#d44a4a";
			case ItemType.Resource: return "#6a8a6a";
			case ItemType.Ring: return "#d4aa40";
			case ItemType.Amulet: return "#40aad4";
			case ItemType.Misc: return "#8a8a6a";
			default: return "#888";
		}
	}

	string FmtCount( int n )
	{
		if ( n >= 1000000 ) return $"{n / 1000000}m";
		if ( n >= 10000 ) return $"{n / 1000}k";
		return n.ToString();
	}

	protected override int BuildHash()
	{
		if ( !IsOpen )
		{
			PlayerInventory = null;
			Bank = null;
			return 0;
		}

		PlayerInventory = PlayerHelper.GetLocalInventory();
		Bank = PlayerHelper.GetLocalPlayer()?.Components.Get<BankStorage>();

		RebuildBankRows();
		RebuildInventoryViews();

		int bankHash = 0;
		foreach ( var r in AllBankRows )
			bankHash = HashCode.Combine( bankHash, r.Id, r.Count, r.IsUnique );

		int invHash = 0;
		foreach ( var v in InventoryViews )
			invHash = HashCode.Combine( invHash, v.Id, v.Count, v.IsEmpty, v.IsEquipped );

		return ( IsOpen, QuantityIndex, Page, SortMode, Search, BulkArmed, bankHash, invHash ).GetHashCode();
	}
}