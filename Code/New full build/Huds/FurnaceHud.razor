@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="furn-backdrop" onclick="@(() => CloseStation())"></div>
		<div class="furn-popup">
			<div class="furn-header">
				<div class="furn-title">🔥 @StationName</div>
				<div class="furn-chips">
					<div class="furn-chip level">Smithing Lvl @Level</div>
				</div>
				<div class="furn-close" onclick="@(() => CloseStation())">✕</div>
			</div>

			<div class="furn-body">
				<div class="furn-nav">
					<div class="furn-nav-label">SMELTING</div>
					@foreach ( var recipe in StationRecipes() )
					{
						var recipeLocal = recipe;
						bool levelLocked = !MeetsRecipeLevel( recipeLocal );
						bool learned = PlayerInventory?.IsRecipeUnlocked( recipeLocal.Id ) ?? false;
						<div class="furn-row @(SelectedId == recipeLocal.Id ? "selected" : "") @(levelLocked || !learned ? "locked" : "")" onclick="@(() => SelectRecipe( recipeLocal.Id ))">
							<div class="furn-row-icon">
								<div class="furn-icon-glyph">❖</div>
								<img class="furn-row-img" src="@IconPath( recipeLocal.OutputItem )" />
							</div>
							<div class="furn-row-name">@recipeLocal.Name</div>
							@if ( levelLocked )
							{
								<div class="furn-row-lv">Lv @recipeLocal.LevelRequired</div>
							}
						</div>
					}
				</div>

				<div class="furn-circle-col">
					<div class="furn-ring-area">
						@if ( Selected == null )
						{
							<div class="furn-ring-outer dim"></div>
							<div class="furn-select-hint">Select a bar</div>
						}
						else
						{
							<div class="furn-ring-outer"></div>
							<div class="furn-ring-inner"></div>

							@foreach ( var line in GetLineVms() )
							{
								<div class="furn-line" style="@line.Style">
									@if ( line.Have )
									{
										<div class="furn-line-fill" style="background-color: @line.Color;"></div>
									}
									else
									{
										@for ( int d = 0; d < line.DashCount; d++ )
										{
											<div class="furn-line-dash" style="background-color: @line.Color;"></div>
										}
									}
								</div>
							}

							@foreach ( var node in GetNodeVms() )
							{
								<div class="furn-node @(node.Have ? "have" : "missing")" style="left: @node.LeftPct%; top: @node.TopPct%;">
									<div class="furn-icon-glyph">❖</div>
									<img class="furn-node-img" src="@IconPath( node.Item )" />
									<div class="furn-node-label @(node.LabelAbove ? "above" : "below")">
										<div class="furn-node-name">@node.Name</div>
										<div class="furn-node-count @(node.Have ? "ok" : "bad")">@node.OwnedCount/@node.NeededCount</div>
									</div>
								</div>
							}

							<div class="furn-center" style="@CenterStyle()">
								<div class="furn-center-inner"></div>
								<div class="furn-icon-glyph big">❖</div>
								<img class="furn-center-img" src="@IconPath( Selected.OutputItem )" />
							</div>
						}
					</div>
				</div>

				<div class="furn-info">
					@if ( Selected == null )
					{
						<div class="furn-info-empty">Pick a bar from the smelting list to see its recipe.</div>
					}
					else
					{
						<div class="furn-info-name">@Selected.Name</div>
						<div class="furn-info-stat">@StatText( Selected.OutputItem )</div>

						<div class="furn-info-divider"></div>

						<div class="furn-info-line">
							<div class="furn-il-label">Requires</div>
							<div class="furn-il-value @(MeetsLevel ? "" : "bad")">@Selected.SkillRequired Lv @Selected.LevelRequired</div>
						</div>
						<div class="furn-info-line">
							<div class="furn-il-label">In bag</div>
							<div class="furn-il-value">@OwnedOfSelected</div>
						</div>
						<div class="furn-info-line">
							<div class="furn-il-label">Can smelt</div>
							<div class="furn-il-value">@MaxCrafts</div>
						</div>
						<div class="furn-info-line">
							<div class="furn-il-label">Reward</div>
							<div class="furn-il-value">+@Selected.XpReward XP</div>
						</div>

						@if ( !RecipeLearned )
						{
							<div class="furn-info-missing">Recipe not learned yet.</div>
						}
						else if ( MissingNames.Count > 0 )
						{
							<div class="furn-info-missing">Missing: @(string.Join( ", ", MissingNames ))</div>
						}

						<div class="furn-spacer"></div>

						<div class="furn-craft @(CanCraft ? "" : "disabled")" onclick="@(() => OnCraft())">Smelt</div>
						<div class="furn-craft all @(CanCraft ? "" : "disabled")" onclick="@(() => OnCraftAll())">Smelt all</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	CraftingStation Station
	{
		get
		{
			var s = CraftingStation.ActiveStation;
			if ( s == null || s.Station != StationType.Furnace )
				return null;
			return s;
		}
	}

	bool IsOpen => Station != null;
	string StationName => Station?.StationName ?? "Furnace";

	Inventory PlayerInventory => PlayerHelper.GetLocalInventory();
	Skills PlayerSkills => PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );

	int Level => PlayerSkills?.GetLevel( SkillType.Smithing ) ?? 1;

	string SelectedId { get; set; }
	RecipeDefinition Selected => SelectedId != null ? RecipeDatabase.GetById( SelectedId ) : null;

	const float FxDuration = 0.6f;
	const float RingSize = 460f;
	const float RingRadius = 170f;
	const float NodeRadius = 35f;
	const float CenterRadius = 50f;

	RealTimeSince _fxSince = 999f;
	bool FxActive => (float)_fxSince < FxDuration;
	float FxPulse => FxActive ? MathF.Sin( MathF.PI * ( (float)_fxSince / FxDuration ) ) : 0f;

	public class NodeVm
	{
		public ItemId Item;
		public string Name;
		public int OwnedCount;
		public int NeededCount;
		public bool Have;
		public bool LabelAbove;
		public string LeftPct;
		public string TopPct;
	}

	public class LineVm
	{
		public bool Have;
		public string Color;
		public string Style;
		public int DashCount;
	}

	static string Num( float value )
	{
		return value.ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture );
	}

	string IconPath( ItemId id )
	{
		return $"/ItemIcons/{id}.vtex";
	}

	List<RecipeDefinition> StationRecipes()
	{
		var list = new List<RecipeDefinition>();
		foreach ( var recipe in RecipeDatabase.GetByStation( StationType.Furnace ) )
			list.Add( recipe );
		return list;
	}

	bool MeetsRecipeLevel( RecipeDefinition recipe )
	{
		return PlayerSkills?.MeetsRequirement( recipe.SkillRequired, recipe.LevelRequired ) ?? false;
	}

	static float SlotAngle( int index, int count )
	{
		float start = count == 3 ? MathF.PI / 2f : -MathF.PI / 2f;
		return start + index * ( MathF.PI * 2f / count );
	}

	List<NodeVm> GetNodeVms()
	{
		var nodes = new List<NodeVm>();
		var recipe = Selected;
		if ( recipe == null )
			return nodes;

		var inventory = PlayerInventory;
		int count = recipe.Ingredients.Length;

		for ( int i = 0; i < count; i++ )
		{
			var ing = recipe.Ingredients[i];
			var def = ItemDatabase.Get( ing.Item );

			float angle = SlotAngle( i, count );
			float ux = MathF.Cos( angle );
			float uy = MathF.Sin( angle );
			float x = RingSize / 2f + RingRadius * ux;
			float y = RingSize / 2f + RingRadius * uy;

			int have = inventory?.GetItemCount( ing.Item ) ?? 0;

			nodes.Add( new NodeVm
			{
				Item = ing.Item,
				Name = def != null ? def.Name : ing.Item.ToString(),
				OwnedCount = have,
				NeededCount = ing.Amount,
				Have = have >= ing.Amount,
				LabelAbove = uy < -0.01f,
				LeftPct = Num( x / RingSize * 100f ),
				TopPct = Num( y / RingSize * 100f )
			} );
		}

		return nodes;
	}

	List<LineVm> GetLineVms()
	{
		var lines = new List<LineVm>();
		var recipe = Selected;
		if ( recipe == null )
			return lines;

		var inventory = PlayerInventory;
		int count = recipe.Ingredients.Length;
		float center = RingSize / 2f;

		for ( int i = 0; i < count; i++ )
		{
			var ing = recipe.Ingredients[i];
			int have = inventory?.GetItemCount( ing.Item ) ?? 0;
			bool haveEnough = have >= ing.Amount;

			float angle = SlotAngle( i, count );
			float ux = MathF.Cos( angle );
			float uy = MathF.Sin( angle );

			float startDist = CenterRadius;
			float endDist = RingRadius - NodeRadius;
			float length = endDist - startDist;
			float midDist = ( startDist + endDist ) / 2f;

			float midX = center + ux * midDist;
			float midY = center + uy * midDist;
			float degrees = angle * 180f / MathF.PI;

			float height = haveEnough && FxActive ? 2f + FxPulse * 2f : 2f;

			lines.Add( new LineVm
			{
				Have = haveEnough,
				Color = haveEnough ? LerpLineColor( FxPulse ) : "#c86464",
				DashCount = haveEnough ? 0 : 4,
				Style = $"left: {Num( midX - length / 2f )}px; top: {Num( midY - height / 2f )}px; width: {Num( length )}px; height: {Num( height )}px; transform: rotate({Num( degrees )}deg);"
			} );
		}

		return lines;
	}

	static string LerpLineColor( float pulse )
	{
		int r = (int)( 0xe8 + ( 0xf0 - 0xe8 ) * pulse );
		int g = (int)( 0x78 + ( 0xc0 - 0x78 ) * pulse );
		int b = (int)( 0x38 + ( 0x40 - 0x38 ) * pulse );
		return $"#{r:x2}{g:x2}{b:x2}";
	}

	string CenterStyle()
	{
		if ( !FxActive )
			return "";

		return $"transform: scale({Num( 1f + 0.12f * FxPulse )});";
	}

	string StatText( ItemId id )
	{
		var def = ItemDatabase.Get( id );
		if ( def == null )
			return "";
		return $"Tier {def.Tier} smithing material";
	}

	bool MeetsLevel => Selected != null && ( PlayerSkills?.MeetsRequirement( Selected.SkillRequired, Selected.LevelRequired ) ?? false );
	bool RecipeLearned => Selected != null && ( PlayerInventory?.IsRecipeUnlocked( Selected.Id ) ?? false );
	int OwnedOfSelected => Selected != null ? PlayerInventory?.GetItemCount( Selected.OutputItem ) ?? 0 : 0;

	int MaxCrafts
	{
		get
		{
			var recipe = Selected;
			var inventory = PlayerInventory;
			if ( recipe == null || inventory == null )
				return 0;

			int min = int.MaxValue;
			foreach ( var ing in recipe.Ingredients )
			{
				if ( ing.Amount <= 0 )
					continue;

				int possible = inventory.GetItemCount( ing.Item ) / ing.Amount;
				if ( possible < min )
					min = possible;
			}

			return min == int.MaxValue ? 0 : min;
		}
	}

	List<string> MissingNames
	{
		get
		{
			var names = new List<string>();
			var recipe = Selected;
			var inventory = PlayerInventory;
			if ( recipe == null || inventory == null )
				return names;

			foreach ( var ing in recipe.Ingredients )
			{
				if ( inventory.GetItemCount( ing.Item ) >= ing.Amount )
					continue;

				var def = ItemDatabase.Get( ing.Item );
				names.Add( def != null ? def.Name : ing.Item.ToString() );
			}

			return names;
		}
	}

	bool CanCraft => Selected != null && RecipeLearned && MeetsLevel && MissingNames.Count == 0;

	void SelectRecipe( string recipeId )
	{
		SelectedId = recipeId;
	}

	void EnsureSelection()
	{
		if ( SelectedId != null && RecipeDatabase.GetById( SelectedId ) != null )
			return;

		string best = null;
		foreach ( var recipe in StationRecipes() )
		{
			if ( best == null || MeetsRecipeLevel( recipe ) )
				best = recipe.Id;
		}

		SelectedId = best;
	}

	void OnCraft()
	{
		var station = Station;
		if ( station == null || Selected == null || !CanCraft )
			return;

		if ( station.TryCraft( Selected.Id ) )
			PlayCraftFeedback();
	}

	void OnCraftAll()
	{
		var station = Station;
		if ( station == null || Selected == null || !CanCraft )
			return;

		if ( station.TryCraftAll( Selected.Id ) > 0 )
			PlayCraftFeedback();
	}

	void PlayCraftFeedback()
	{
		_fxSince = 0f;
		SoundLibrary.PlayReceiveItem();

		if ( Selected != null )
			ItemPickupEffect.Trigger( Selected.OutputItem );
	}

	void CloseStation()
	{
		CraftingStation.Close();
	}

	protected override int BuildHash()
	{
		if ( !IsOpen )
			return 0;

		EnsureSelection();

		var inventory = PlayerInventory;

		int countsHash = 0;
		foreach ( var recipe in RecipeDatabase.GetByStation( StationType.Furnace ) )
		{
			countsHash = HashCode.Combine(
				countsHash,
				inventory?.GetItemCount( recipe.OutputItem ) ?? 0,
				inventory?.IsRecipeUnlocked( recipe.Id ) ?? false );
		}

		int ingredientHash = 0;
		var selected = Selected;
		if ( selected != null && inventory != null )
		{
			foreach ( var ing in selected.Ingredients )
				ingredientHash = HashCode.Combine( ingredientHash, inventory.GetItemCount( ing.Item ) );
		}

		int fxBucket = FxActive ? (int)( (float)_fxSince * 30f ) : -1;

		return HashCode.Combine( IsOpen, SelectedId ?? "", Level, countsHash, ingredientHash, fxBucket );
	}
}
