@using System;
@using System.Collections.Generic;
@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	@foreach ( var marker in _markers )
	{
		<div class="marker @( marker.Pulse ? "pulse" : "" )"
			 style="left: @(marker.ScreenX)px; top: @(marker.ScreenY)px; color: @(marker.Color); text-shadow: 0 0 8px @(marker.Color);">
			!
		</div>
	}
</root>

@code
{
	struct MarkerDraw
	{
		public float ScreenX;
		public float ScreenY;
		public string Color;
		public bool Pulse;
	}

	List<MarkerDraw> _markers = new();

	protected override int BuildHash()
	{
		return _markers.Count;
	}

	protected override void OnUpdate()
	{
		_markers.Clear();

		var camera = Scene.Camera;
		if ( camera == null )
			return;

		foreach ( var quest in Scene.GetAllComponents<NpcInteract>() )
		{
			if ( !quest.ShouldShowMarker() )
				continue;

			var worldPos = quest.GetMarkerWorldPosition();
			if ( !TryProject( camera, worldPos, out float sx, out float sy ) )
				continue;

			_markers.Add( new MarkerDraw
			{
				ScreenX = sx,
				ScreenY = sy,
				Color = quest.GetMarkerColor(),
				Pulse = quest.IsMarkerPulsing()
			} );
		}

		foreach ( var shop in Scene.GetAllComponents<ShopStation>() )
		{
			if ( !shop.ShouldShowMarker() )
				continue;

			var worldPos = shop.GetMarkerWorldPosition();
			if ( !TryProject( camera, worldPos, out float sx, out float sy ) )
				continue;

			_markers.Add( new MarkerDraw
			{
				ScreenX = sx,
				ScreenY = sy,
				Color = shop.GetMarkerColor(),
				Pulse = false
			} );
		}
	}

	bool TryProject( CameraComponent camera, Vector3 worldPos, out float screenX, out float screenY )
	{
		screenX = 0;
		screenY = 0;

		var toPoint = worldPos - camera.WorldPosition;
		var forward = camera.WorldRotation.Forward;
		if ( Vector3.Dot( toPoint, forward ) <= 0f )
			return false;

		var screenPos = camera.PointToScreenNormal( worldPos );
		if ( screenPos.x < 0f || screenPos.x > 1f || screenPos.y < 0f || screenPos.y > 1f )
			return false;

		var panelSize = Panel.Box.Rect.Size;
		screenX = screenPos.x * panelSize.x;
		screenY = screenPos.y * panelSize.y;
		return true;
	}
}
