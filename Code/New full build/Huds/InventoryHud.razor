@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsUIOpen )
	{
		<div class="ui-backdrop" onclick="@OnBackdropClick"></div>
	}

	<div class="log-panel @(IsUIOpen ? "ui-open" : "") @(IsChatOpen ? "chat-open" : "")">
		<div class="log-tabs">
			<div class="log-tab @(LogTab == 0 ? "active" : "")" onclick="@(() => LogTab = 0)">All</div>
			<div class="log-tab @(LogTab == 1 ? "active" : "")" onclick="@(() => LogTab = 1)">Log</div>
			<div class="log-tab @(LogTab == 2 ? "active" : "")" onclick="@(() => LogTab = 2)">Chat</div>
		</div>

		@if ( LogTab == 0 )
		{
			<div class="chat-entries">
				@foreach ( var entry in GetCombinedFeed().AsEnumerable().Reverse() )
				{
					@if ( entry.IsChat )
					{
						<div class="chat-entry chat-msg">
							<div class="chat-sender">@entry.Sender</div>
							<div class="chat-text">@entry.Text</div>
						</div>
					}
					else
					{
						<div class="chat-entry" style="color: @entry.Color;">@entry.Text</div>
					}
				}
			</div>
		}

		@if ( LogTab == 1 )
		{
			<div class="chat-entries">
				@foreach ( var msg in GetVisibleMessages().AsEnumerable().Reverse() )
				{
					<div class="chat-entry" style="color: @msg.Color;">@msg.Text</div>
				}
			</div>
		}

		@if ( LogTab == 2 )
		{
			<div class="chat-entries">
				@foreach ( var msg in GetChatMessages().AsEnumerable().Reverse() )
				{
					@if ( !string.IsNullOrEmpty( msg.Sender ) )
					{
						<div class="chat-entry chat-msg">
							<div class="chat-sender">@msg.Sender</div>
							<div class="chat-text">@msg.Text</div>
						</div>
					}
					else
					{
						<div class="chat-entry chat-system" style="color: #f0c040;">@msg.Text</div>
					}
				}
			</div>
		}

		@if ( IsChatOpen )
		{
			<div class="chat-input-row">
				<TextEntry class="chat-input-field @(IsChatBlocked ? "chat-blocked" : "")" @ref="ChatInputRef" Value:bind="@ChatText" MaxLength="@(200)" onsubmit="@OnChatSubmit"></TextEntry>
			</div>
		}
	</div>

	<div class="side-panel @(IsUIOpen ? "ui-open" : "") @(ActiveTab == 0 ? "gear-expanded" : "") @(HudState.InventoryCollapsed ? "collapsed" : "")">

		<div class="health-section">
			<div class="health-bars">
			<div class="health-bar-container">
				<div class="health-bar-fill" style="width: @HealthPercent%;"></div>
				<div class="health-bar-text">@CurrentHealth / @MaxHealth HP</div>
				@if ( ActiveBuffs.Count > 0 || PotionCooldownRemaining > 0 )
				{
					<div class="buff-row">
						@foreach ( var buff in ActiveBuffs )
						{
							<div class="buff-icon" style="color: @GetBuffColor( buff.Type );">
								<div class="buff-timer">@((int)buff.Remaining)s</div>
								<div class="buff-tooltip">@buff.Type +@((int)buff.Percent)%</div>
							</div>
						}
						@if ( PotionCooldownRemaining > 0 )
						{
							<div class="buff-icon">
								<div class="buff-icon-symbol">🚫</div>
								<div class="buff-timer">@((int)PotionCooldownRemaining)s</div>
								<div class="buff-tooltip">Potion Cooldown</div>
							</div>
						}
					</div>
				}
			</div>
			<div class="mana-bar-container">
				<div class="mana-bar-fill" style="width: @ManaPercent%;"></div>
				<div class="mana-bar-text">@CurrentMana / @MaxMana MP @(IsDrinking ? "— Drinking..." : "")</div>
			</div>
			</div>
			<div class="collapse-lane">
				<div class="collapse-arrow" onclick="@(() => ToggleCollapse())">@(HudState.InventoryCollapsed ? "▲" : "▼")</div>
			</div>
			@if ( IsHealTicking )
			{
				<div class="healing-indicator">Healing...</div>
			}
		</div>

		<div class="tabs">
			<div class="tab @(ActiveTab == 0 ? "active" : "")" onclick="@(() => SelectTab( 0 ))">Gear</div>
			<div class="tab @(ActiveTab == 1 ? "active" : "")" onclick="@(() => SelectTab( 1 ))">Items</div>
			<div class="tab @(ActiveTab == 2 ? "active" : "")" onclick="@(() => SelectTab( 2 ))">Skills</div>
		</div>

		<div class="panel-content">

			@if ( ActiveTab == 1 )
			{
				<div class="inventory-grid">
					@for ( int i = 0; i < TotalSlots; i++ )
					{
						var slotIndex = i;
						var slotData = GetSlotData( slotIndex );
						bool isHotbar = slotIndex < Inventory.HotbarSize;
						bool isPickedFrom = PickedUpSlotIndex == slotIndex;

						@if ( slotData != null && slotData.IsUnique )
						{
							var inst = slotData.Unique;
							var def = ItemDatabase.Get( inst.ItemId );
							bool hasMagicBackground = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
							string color = hasMagicBackground ? "#a080d0" : GetItemColor( inst.ItemId, def );

							<div class="item-slot filled equippable @(isHotbar ? "hotbar" : "") @(isPickedFrom ? "picked-up" : "") @(IsRecentlyReceived( inst.ItemId ) ? "just-received" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
								<div class="item-icon" style="background: @color;">
									<img class="item-icon-img" src="@GetIconPath( inst.ItemId )" />
								</div>
								@if ( inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 ) )
								{
									<div class="item-enchant">@inst.GetShortStat()</div>
								}
								<div class="use-button equip-button"
									 onclick="@(() => OnUseButtonClick( slotIndex ))">⚡</div>
								<div class="item-tooltip">
									@inst.GetDisplayName()
									<div class="tooltip-hint">Click slot to move · Click ⚡ to equip</div>
								</div>
							</div>
						}
						else if ( slotData != null && slotData.IsStack )
						{
							bool isPotion = ItemDatabase.Get( slotData.ItemId )?.Type == ItemType.Potion;
							bool isArrow = ItemDatabase.Get( slotData.ItemId )?.Type == ItemType.Arrow;
							bool hasUseBtn = isPotion || isArrow;

							<div class="item-slot filled @(isPotion ? "potion-slot" : "") @(isHotbar ? "hotbar" : "") @(isPickedFrom ? "picked-up" : "") @(IsRecentlyReceived( slotData.ItemId ) ? "just-received" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
								<div class="item-icon" style="background: @slotData.Color;">
									<img class="item-icon-img" src="@GetIconPath( slotData.ItemId )" />
								</div>
								@if ( slotData.Count > 1 )
								{
									<div class="item-count">@slotData.Count</div>
								}
								@if ( hasUseBtn )
								{
									<div class="use-button @(isPotion ? "potion-button" : "arrow-button")"
										 onclick="@(() => OnUseButtonClick( slotIndex ))">@(isPotion ? "🍶" : "🏹")</div>
								}
								<div class="item-tooltip">
									@slotData.Name x@(slotData.Count)
									@if ( isPotion )
									{
										<div class="tooltip-hint">Click slot to move · Click 🍶 to drink</div>
									}
									else if ( isArrow )
									{
										<div class="tooltip-hint">Click slot to move · Click 🏹 to equip</div>
									}
									else
									{
										<div class="tooltip-hint">Click to pick up</div>
									}
								</div>
							</div>
						}
						else
						{
							<div class="item-slot @(isHotbar ? "hotbar" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
							</div>
						}
					}
				</div>
			}

			@if ( ActiveTab == 2 )
			{
				<div class="skills-list">
					@foreach ( var skill in SkillEntries )
					{
						<div class="skill-row @(skill.Level >= 50 ? "maxed" : "")">
							<div class="skill-level">@skill.Level</div>
							<div class="skill-icon-box">@skill.Icon</div>
							<div class="skill-name">@skill.Name</div>
							<div class="xp-bar">
								<div class="xp-fill @(skill.CssClass)-fill" style="width: @skill.XpPercent%;"></div>
							</div>
							<div class="skill-tooltip">
								<div class="skill-tooltip-name">@skill.Name</div>
								<div class="skill-tooltip-line">Level @skill.Level</div>
								<div class="skill-tooltip-line">XP: @skill.Xp / @skill.XpRequired</div>
								<div class="skill-tooltip-line skill-tooltip-remaining">@(skill.XpRequired - skill.Xp) XP to next level</div>
							</div>
						</div>
					}
				</div>
			}

			@if ( ActiveTab == 0 )
			{
				<div class="gear-tab">

					<div class="gear-top">
					<div class="equipment-tree">
						<div class="equip-col">
							@foreach ( var type in LeftColumn )
							{
								var e = GetEquip( type );
								bool filled = e != null && e.ItemName != null;
								<div class="equip-tree-slot @(filled ? "filled" : "")" onclick="@(() => OnEquipSlotClick( e ))">
									@if ( filled )
									{
										<div class="item-icon" style="background: @e.Color;">
											<img class="item-icon-img" src="@GetIconPath( e.ItemId )" />
										</div>
										@if ( !string.IsNullOrEmpty( e.EnchantStat ) )
										{
											<div class="eq-enchant">@e.EnchantStat</div>
										}
										<div class="equip-tree-tooltip">
											<div class="tt-name" style="color: @e.Color;">@e.ItemName</div>
											<div class="tt-hint">Click to unequip</div>
										</div>
									}
									else
									{
										<div class="equip-slot-empty">@GetSlotLabel( type )</div>
									}
								</div>
							}
						</div>

						<div class="terry-render">
							<img @ref="TerryImage" class="terry-image" />
						</div>

						<div class="equip-col">
							@foreach ( var type in RightColumn )
							{
								var e = GetEquip( type );
								bool filled = e != null && e.ItemName != null;
								<div class="equip-tree-slot @(filled ? "filled" : "")" onclick="@(() => OnEquipSlotClick( e ))">
									@if ( filled )
									{
										<div class="item-icon" style="background: @e.Color;">
											<img class="item-icon-img" src="@GetIconPath( e.ItemId )" />
										</div>
										@if ( !string.IsNullOrEmpty( e.EnchantStat ) )
										{
											<div class="eq-enchant">@e.EnchantStat</div>
										}
										<div class="equip-tree-tooltip">
											<div class="tt-name" style="color: @e.Color;">@e.ItemName</div>
											<div class="tt-hint">Click to unequip</div>
										</div>
									}
									else
									{
										<div class="equip-slot-empty">@GetSlotLabel( type )</div>
									}
								</div>
							}
						</div>
					</div>

					<div class="equippable-panel">
							<div class="section-label">Equippable items</div>
							<div class="equippable-grid">
								@foreach ( var entry in EquippableItems )
								{
									var ec = entry;
									<div class="equippable-slot @(ec.ReqMet ? "" : "locked")" onclick="@(() => OnEquippableItemClick( ec.SlotIndex ))">
										<div class="item-icon" style="background: @ec.Color;">
											<img class="item-icon-img" src="@GetIconPath( ec.ItemId )" />
										</div>
										@if ( !string.IsNullOrEmpty( ec.EnchantText ) )
										{
											<div class="eq-enchant">@ec.EnchantText</div>
										}
										<div class="eq-tooltip">
											<div class="tt-name" style="color: @ec.Color;">@ec.Name</div>
											<div class="tt-sub">@ec.TypeLabel — @ec.SlotLabel</div>
											@if ( !string.IsNullOrEmpty( ec.ReqLabel ) )
											{
												<div class="tt-req @(ec.ReqMet ? "met" : "unmet")">@ec.ReqLabel</div>
											}
											@if ( !string.IsNullOrEmpty( ec.PrimaryStatLabel ) )
											{
												<div class="tt-stat-row">
													<span>@ec.PrimaryStatLabel @ec.PrimaryStatValue</span>
													@if ( ec.HasCompare )
													{
														<span class="tt-delta @(ec.CompareDelta >= 0 ? "pos" : "neg")">@(ec.CompareDelta >= 0 ? "+" : "")@ec.CompareDelta vs equipped</span>
													}
												</div>
											}
											@if ( !string.IsNullOrEmpty( ec.EnchantText ) )
											{
												<div class="tt-enchant">@ec.EnchantText</div>
											}
											<div class="tt-sell">Sell @ec.SellPrice g</div>
											<div class="tt-hint">Click to equip</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>

					<div class="gear-bottom">
						<div class="gear-bottom-left">
							<div class="appearance-strip">
								<div class="section-label">Appearance</div>
								<div class="cosmetic-row">
									<div class="cosmetic-slot active"><span class="wip-badge">WIP</span></div>
									<div class="cosmetic-slot dimmed"></div>
									<div class="cosmetic-slot dimmed"></div>
									<div class="cosmetic-slot dimmed"></div>
									<div class="cosmetic-note">Cosmetic overrides — coming soon</div>
								</div>
							</div>

							<div class="enchant-box">
								<div class="section-label">Enchantments</div>
								<div class="enchant-list">
									@if ( EnchantLines.Count > 0 )
									{
										@foreach ( var en in EnchantLines )
										{
											<div class="stat-row"><span class="stat-key">@en.Name</span><span class="stat-val stat-ench">+@en.Percent%</span></div>
										}
									}
									else
									{
										<div class="enchant-empty">No active enchantments</div>
									}
								</div>
							</div>
						</div>

						<div class="stats-panel">
							<div class="section-label">Stats</div>
							<div class="stat-block">
								<div class="stat-group-title">Combat</div>
								<div class="stat-row"><span class="stat-key">Attack / Defence</span><span class="stat-val">@StatAttack / @StatDefence</span></div>
								<div class="stat-row"><span class="stat-key">Archery / Magic</span><span class="stat-val">@StatArchery / @StatMagic</span></div>

								<div class="stat-group-title">Offense</div>
								<div class="stat-row"><span class="stat-key">Weapon power</span><span class="stat-val">@StatWeaponText</span></div>

								<div class="stat-group-title">Defense</div>
								<div class="stat-row"><span class="stat-key">Armor rating</span><span class="stat-val">@StatArmor</span></div>
								<div class="stat-row"><span class="stat-key">Damage reduction</span><span class="stat-val">@StatArmorReductionPct%</span></div>

								@if ( ManaRegenPenaltyPct > 0 || RangedDrawPenaltyPct > 0 )
								{
									<div class="stat-group-title">Penalties</div>
									@if ( ManaRegenPenaltyPct > 0 )
									{
										<div class="stat-row"><span class="stat-key">Mana regen</span><span class="stat-val stat-pen">-@ManaRegenPenaltyPct%</span></div>
									}
									@if ( RangedDrawPenaltyPct > 0 )
									{
										<div class="stat-row"><span class="stat-key">Ranged draw</span><span class="stat-val stat-pen">-@RangedDrawPenaltyPct%</span></div>
									}
								}
							</div>
						</div>
					</div>

				</div>
			}

		</div>
	</div>

	@if ( ShowUnequipConfirm )
	{
		<div class="modal-overlay">
			<div class="confirm-modal">
				<div class="confirm-title">Inventory full</div>
				<div class="confirm-text">@ConfirmItemName will be sent to your bank.</div>
				<div class="confirm-buttons">
					<div class="confirm-btn yes" onclick="@OnConfirmUnequipYes">Yes</div>
					<div class="confirm-btn no" onclick="@OnConfirmUnequipNo">No</div>
				</div>
			</div>
		</div>
	}

	@if ( PickedUpSlotIndex >= 0 && PickedUpGhost != null )
	{
		<div class="pickup-ghost" style="left: @(CursorXPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(CursorYPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: @PickedUpGhost.Color;">
			<img class="pickup-ghost-img" src="@GetIconPath( PickedUpGhost.ItemId )" />
			@if ( PickedUpGhost.Count > 1 )
			{
				<div class="pickup-ghost-count">@PickedUpGhost.Count</div>
			}
		</div>
	}
</root>

@code
{
	static readonly EquipSlot[] LeftColumn = { EquipSlot.Head, EquipSlot.Amulet, EquipSlot.Weapon, EquipSlot.Legs };
	static readonly EquipSlot[] RightColumn = { EquipSlot.Chest, EquipSlot.Ammo, EquipSlot.Shield, EquipSlot.Ring };

	int ActiveTab { get; set; } = 1;

	void SelectTab( int tab )
	{
		ActiveTab = tab;
		HudState.InventoryCollapsed = false;
	}

	void ToggleCollapse()
	{
		HudState.InventoryCollapsed = !HudState.InventoryCollapsed;
		if ( HudState.InventoryCollapsed )
			ActiveTab = 1;
	}
	int LogTab { get; set; } = 0;

	public static bool GearTabExpanded { get; private set; }

	Sandbox.UI.Image TerryImage { get; set; }
	bool _hasInitialized = false;

	int PickedUpSlotIndex { get; set; } = -1;
	GhostDisplay PickedUpGhost { get; set; }
	float CursorXPercent { get; set; } = 0;
	float CursorYPercent { get; set; } = 0;

	bool _suppressNextSlotClick = false;

	EquipSlot ConfirmUnequipSlot { get; set; } = EquipSlot.None;
	bool ShowUnequipConfirm { get; set; }
	string ConfirmItemName { get; set; } = "";

	bool IsUIOpen => PlayerGatherResource.UIOpen;

	TextEntry ChatInputRef { get; set; }
	string ChatText { get; set; } = "";

	bool IsChatOpen
	{
		get
		{
			var gm = GameManager.Instance;
			return gm != null && gm.ChatOpen;
		}
	}

	System.Collections.Generic.List<GameManager.ChatMessage> GetChatMessages()
	{
		var gm = GameManager.Instance;
		if ( gm == null )
			return new();

		return gm.ChatMessages;
	}

	public class FeedEntry
	{
		public bool IsChat;
		public string Text;
		public string Color;
		public string Sender;
		public float CreatedValue;
		public long Sequence;
	}

	List<FeedEntry> GetCombinedFeed()
	{
		var feed = new List<FeedEntry>();

		foreach ( var msg in GameLog.Messages )
		{
			feed.Add( new FeedEntry
			{
				IsChat = false,
				Text = msg.Text,
				Color = msg.Color,
				Sender = null,
				CreatedValue = (float)msg.Created,
				Sequence = msg.Sequence
			} );
		}

		var chats = GetChatMessages();
		foreach ( var msg in chats )
		{
			if ( string.IsNullOrEmpty( msg.Sender ) )
				continue;

			feed.Add( new FeedEntry
			{
				IsChat = true,
				Text = msg.Text,
				Color = null,
				Sender = msg.Sender,
				CreatedValue = (float)msg.Created,
				Sequence = msg.Sequence
			} );
		}

		feed.Sort( ( a, b ) =>
		{
			int cmp = b.CreatedValue.CompareTo( a.CreatedValue );
			if ( cmp != 0 )
				return cmp;

			cmp = a.IsChat.CompareTo( b.IsChat );
			if ( cmp != 0 )
				return cmp;

			return a.Sequence.CompareTo( b.Sequence );
		} );

		return feed;
	}

	void OnChatSubmit()
	{
		var gm = GameManager.Instance;
		if ( gm == null )
			return;

		if ( !string.IsNullOrWhiteSpace( ChatText ) )
		{
			bool sent = gm.SendChat( ChatText );
			if ( !sent )
				return;
		}

		ChatText = "";
		gm.CloseChat();
	}

	bool IsChatBlocked
	{
		get
		{
			var gm = GameManager.Instance;
			return gm != null && gm.TimeSinceChatBlocked < 0.6f;
		}
	}

	int CurrentHealth { get; set; }
	int MaxHealth { get; set; } = 100;
	int HealthPercent { get; set; } = 100;
	int CurrentMana { get; set; }
	int MaxMana { get; set; }
	int ManaPercent { get; set; }
	bool IsDrinking { get; set; }
	bool IsHealTicking { get; set; }
	float PotionCooldownRemaining { get; set; }
	List<ActiveBuff> ActiveBuffs { get; set; } = new();

	List<SlotData> CachedSlots { get; set; } = new();
	List<SkillDisplay> SkillEntries { get; set; } = new();
	List<EquipSlotDisplay> EquipmentSlots { get; set; } = new();
	List<EquippableEntry> EquippableItems { get; set; } = new();

	int StatAttack { get; set; }
	int StatDefence { get; set; }
	int StatArchery { get; set; }
	int StatMagic { get; set; }
	bool HasWeapon { get; set; }
	int StatWeaponPower { get; set; }
	string StatWeaponText { get; set; } = "—";
	string StatStyle { get; set; } = "—";
	int StatArmor { get; set; }
	int StatArmorReductionPct { get; set; }
	int ManaRegenPenaltyPct { get; set; }
	int RangedDrawPenaltyPct { get; set; }
	List<EnchantLine> EnchantLines { get; set; } = new();

	int TotalSlots { get; set; } = 30;

	public class SlotData
	{
		public bool IsStack;
		public bool IsUnique;
		public ItemId ItemId;
		public int Count;
		public string Name;
		public string Color;
		public ItemInstance Unique;
	}

	public class GhostDisplay
	{
		public ItemId ItemId;
		public int Count;
		public string Color;
	}

	public class SkillDisplay
	{
		public string Name;
		public string Icon;
		public string CssClass;
		public int Level;
		public int Xp;
		public int XpRequired;
		public int XpPercent;
	}

	public class EquipSlotDisplay
	{
		public string Label;
		public string ItemName;
