	void RefreshData()
	{
		CachedSlots.Clear();
		SkillEntries.Clear();
		EquipmentSlots.Clear();
		EquippableItems.Clear();
		EnchantLines.Clear();
		ActiveBuffs.Clear();

		var inventory = PlayerHelper.GetLocalInventory();
		var skills = PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );
		var health = PlayerHelper.GetLocalPlayer()?.Components.Get<PlayerHealth>();
		var potions = PlayerHelper.GetLocalPlayer()?.Components.Get<PotionSystem>();
		var mana = PlayerHelper.GetLocalPlayer()?.Components.Get<ManaSystem>();

		if ( health != null )
		{
			CurrentHealth = health.CurrentHealth;
			MaxHealth = health.MaxHealth;
			HealthPercent = MaxHealth > 0 ? (int)( ( (float)CurrentHealth / MaxHealth ) * 100f ) : 0;
		}

		if ( mana != null )
		{
			CurrentMana = mana.CurrentMana;
			MaxMana = mana.MaxMana;
			ManaPercent = MaxMana > 0 ? (int)( ( (float)CurrentMana / MaxMana ) * 100f ) : 0;
		}
		else
		{
			CurrentMana = 0;
			MaxMana = 0;
			ManaPercent = 0;
		}

		if ( potions != null )
		{
			IsDrinking = potions.IsDrinking;
			IsHealTicking = potions.IsHealTicking;
			PotionCooldownRemaining = potions.PotionCooldownRemaining;

			foreach ( var buff in potions.GetActiveBuffs() )
				ActiveBuffs.Add( buff );
		}
		else
		{
			IsDrinking = false;
			IsHealTicking = false;
			PotionCooldownRemaining = 0f;
		}

		if ( inventory != null )
		{
			TotalSlots = inventory.MaxSlots;

			var rawSlots = inventory.GetSlots();
			for ( int i = 0; i < inventory.MaxSlots; i++ )
			{
				var src = rawSlots[i];
				var data = new SlotData();

				if ( src.IsUnique )
				{
					data.IsUnique = true;
					data.Unique = src.Unique;
					data.ItemId = src.Unique.ItemId;
					data.Count = 1;
					var def = ItemDatabase.Get( src.Unique.ItemId );
					data.Name = def != null ? def.Name : src.Unique.ItemId.ToString();
					bool srcMagic = src.Unique.IsEnchanted || ( src.Unique.IsSocketable && src.Unique.SocketsUsed > 0 );
					data.Color = srcMagic ? "#a080d0" : GetItemColor( src.Unique.ItemId, def );
				}
				else if ( src.IsStack )
				{
					data.IsStack = true;
					data.ItemId = src.ItemId;
					data.Count = src.Count;
					var def = ItemDatabase.Get( src.ItemId );
					data.Name = def != null ? def.Name : src.ItemId.ToString();
					data.Color = GetItemColor( src.ItemId, def );
				}

				CachedSlots.Add( data );

				if ( src.IsUnique )
				{
					var inst = src.Unique;
					var def = ItemDatabase.Get( inst.ItemId );
					if ( def != null && def.Slot != EquipSlot.None )
						EquippableItems.Add( BuildEquippableEntry( i, inst, def, inventory, skills ) );
				}
			}

			EquipSlot[] equipSlots = { EquipSlot.Weapon, EquipSlot.Shield, EquipSlot.Head, EquipSlot.Chest, EquipSlot.Legs, EquipSlot.Ring, EquipSlot.Amulet, EquipSlot.Ammo };
			foreach ( var slot in equipSlots )
			{
				if ( slot == EquipSlot.Ammo )
				{
					var ammoId = inventory.GetEquippedAmmoId();
					if ( ammoId != ItemId.None )
					{
						var ammoDef = ItemDatabase.Get( ammoId );
						int ammoCount = inventory.GetEquippedAmmoCount();
						EquipmentSlots.Add( new EquipSlotDisplay
						{
							Label = GetSlotLabel( slot ),
							ItemName = ammoDef != null ? $"{ammoDef.Name} x{ammoCount}" : ammoId.ToString(),
							Color = GetItemColor( ammoId, ammoDef ),
							Slot = slot,
							EnchantStat = "",
							ItemId = ammoId
						} );
					}
					else
					{
						EquipmentSlots.Add( new EquipSlotDisplay
						{
							Label = GetSlotLabel( slot ),
							ItemName = null,
							Color = null,
							Slot = slot,
							EnchantStat = "",
							ItemId = ItemId.None
						} );
					}
					continue;
				}

				var equippedUnique = inventory.GetEquippedUnique( slot );
				if ( equippedUnique != null )
				{
					var uDef = ItemDatabase.Get( equippedUnique.ItemId );
					bool eqMagic = equippedUnique.IsEnchanted || ( equippedUnique.IsSocketable && equippedUnique.SocketsUsed > 0 );
					string color = eqMagic ? "#a080d0" : GetItemColor( equippedUnique.ItemId, uDef );
					string baseName = uDef != null ? uDef.Name : equippedUnique.ItemId.ToString();

					EquipmentSlots.Add( new EquipSlotDisplay
					{
						Label = GetSlotLabel( slot ),
						ItemName = baseName,
						Color = color,
						Slot = slot,
						EnchantStat = ( slot == EquipSlot.Ring || slot == EquipSlot.Amulet ) ? "" : equippedUnique.GetShortStat(),
						ItemId = equippedUnique.ItemId
					} );
					continue;
				}

				EquipmentSlots.Add( new EquipSlotDisplay
				{
					Label = GetSlotLabel( slot ),
					ItemName = null,
					Color = null,
					Slot = slot,
					EnchantStat = "",
					ItemId = ItemId.None
				} );
			}

			BuildStats( inventory, skills );

			if ( PickedUpSlotIndex >= 0 )
			{
				if ( PickedUpSlotIndex >= inventory.MaxSlots )
				{
					ClearPickup();
				}
				else
				{
					var heldSlot = inventory.GetSlot( PickedUpSlotIndex );
					if ( heldSlot == null || heldSlot.IsEmpty )
						ClearPickup();
					else
						RefreshGhost( inventory );
				}
			}
		}

		if ( skills != null )
		{
			SkillType[] allSkills = { SkillType.Woodcutting, SkillType.Mining, SkillType.Enchanting, SkillType.Smithing, SkillType.Crafting, SkillType.Attack, SkillType.Defence, SkillType.Archery, SkillType.Magic };

			foreach ( var skill in allSkills )
			{
				int level = skills.GetLevel( skill );
				int xp = skills.GetXp( skill );
				int required = skills.GetXpRequired( skill );
				int percent = required > 0 ? (int)( ( (float)xp / required ) * 100f ) : 0;

				SkillEntries.Add( new SkillDisplay
				{
					Name = skill.ToString(),
					Icon = GetSkillIcon( skill ),
					CssClass = GetSkillCss( skill ),
					Level = level,
					Xp = xp,
					XpRequired = required,
					XpPercent = percent
				} );
			}
		}
	}

	EquippableEntry BuildEquippableEntry( int slotIndex, ItemInstance inst, ItemDefinition def, Inventory inventory, Skills skills )
	{
		var entry = new EquippableEntry();
		entry.SlotIndex = slotIndex;
		entry.ItemId = inst.ItemId;
		entry.Instance = inst;
		entry.Name = inst.GetDisplayName();

		bool magic = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
		entry.Color = magic ? "#a080d0" : GetItemColor( inst.ItemId, def );
		entry.TypeLabel = GetTypeLabel( def.Type );
		entry.SlotLabel = GetSlotLabel( def.Slot );
		entry.ReqLabel = def.LevelRequired > 0 ? $"Requires {def.SkillRequired} {def.LevelRequired}" : "";
		entry.ReqMet = skills == null || skills.CanEquip( def );
		entry.SellPrice = def.BaseSellPrice;
		entry.EnchantText = inst.GetShortStat();

		if ( def.WeaponPower > 0f )
		{
			entry.PrimaryStatLabel = "Weapon power";
			entry.PrimaryStatValue = (int)def.WeaponPower;

			var eqId = inventory.GetEquipped( def.Slot );
			if ( eqId != ItemId.None )
			{
				var eqDef = ItemDatabase.Get( eqId );
				entry.HasCompare = true;
				entry.CompareDelta = (int)( def.WeaponPower - ( eqDef != null ? eqDef.WeaponPower : 0f ) );
			}
		}
		else if ( def.ArmorValue > 0f )
		{
			entry.PrimaryStatLabel = "Armor";
			entry.PrimaryStatValue = (int)def.ArmorValue;

			var eqId = inventory.GetEquipped( def.Slot );
			if ( eqId != ItemId.None )
			{
				var eqDef = ItemDatabase.Get( eqId );
				entry.HasCompare = true;
				entry.CompareDelta = (int)( def.ArmorValue - ( eqDef != null ? eqDef.ArmorValue : 0f ) );
			}
		}

		return entry;
	}

	void BuildStats( Inventory inventory, Skills skills )
	{
		if ( skills != null )
		{
			StatAttack = skills.GetLevel( SkillType.Attack );
			StatDefence = skills.GetLevel( SkillType.Defence );
			StatArchery = skills.GetLevel( SkillType.Archery );
			StatMagic = skills.GetLevel( SkillType.Magic );
		}

		var wdef = inventory.GetEquippedWeaponDef();
		HasWeapon = wdef != null;
		StatStyle = wdef != null ? CombatTriangle.GetStyleFromWeapon( wdef ).ToString() : "—";

		if ( wdef == null )
		{
			StatWeaponPower = 0;
			StatWeaponText = "—";
		}
		else if ( wdef.Type == ItemType.RangedWeapon )
		{
			int basePower = (int)wdef.WeaponPower;
			int arrowPower = (int)inventory.GetArrowPower();
			StatWeaponPower = basePower + arrowPower;
			StatWeaponText = arrowPower > 0
				? $"{StatWeaponPower} · {StatStyle} ({basePower} + {arrowPower} arrow)"
				: $"{basePower} · {StatStyle}";
		}
		else
		{
			StatWeaponPower = (int)wdef.WeaponPower;
			StatWeaponText = $"{StatWeaponPower} · {StatStyle}";
		}

		float armor = CombatTriangle.GetEffectiveArmorValue( inventory );
		if ( armor < 0f )
			armor = 0f;
		StatArmor = (int)armor;
		StatArmorReductionPct = (int)System.MathF.Round( armor / ( armor + 100f ) * 100f );

		var pen = CombatTriangle.GetEquippedArmorPenalties( inventory );
		ManaRegenPenaltyPct = (int)( pen.ManaRegenPenalty * 100f );
		RangedDrawPenaltyPct = (int)( pen.RangedDrawPenalty * 100f );

		foreach ( EnchantmentType t in System.Enum.GetValues( typeof( EnchantmentType ) ) )
		{
			if ( t == EnchantmentType.None )
				continue;

			float b = inventory.GetEnchantmentBonus( t );
			if ( b > 0f )
				EnchantLines.Add( new EnchantLine { Name = t.ToString(), Percent = (int)b } );
		}
	}

	bool ShouldDropPickup()
	{
		if ( !IsUIOpen )
			return true;

		if ( ShopStation.ActiveShop != null || ShopStation.ShowingChoice )
			return true;
		if ( BankStation.ActiveBank != null )
			return true;
		if ( CraftingStation.ActiveStation != null )
			return true;
		if ( EnchantingStation.ActiveStation != null )
			return true;
		if ( TeleportStone.ActiveStone != null )
			return true;
		if ( NpcInteract.ActiveNpc != null )
			return true;
		if ( JournalStation.IsOpen )
			return true;
		if ( LeaderboardStation.IsOpen )
			return true;
		if ( SpellbookStation.IsOpen )
			return true;
		if ( MinimapState.IsFullMapOpen )
			return true;
		if ( WelcomeHudState.IsOpen )
			return true;

		return false;
	}

	protected override void OnUpdate()
	{
		GearTabExpanded = ActiveTab == 0;

		TerryPreviewRenderer.Instance?.SetActive( ActiveTab == 0 );
		if ( ActiveTab == 0 && TerryImage != null )
		{
			var terryTex = TerryPreviewRenderer.PreviewTexture;
			if ( terryTex != null )
				TerryImage.Texture = terryTex;
		}

		if ( GameLog.FocusAllTabRequested )
		{
			LogTab = 0;
			GameLog.ConsumeFocusAllTabRequest();
		}

		StateHasChanged();

		if ( PickedUpSlotIndex >= 0 )
		{
			var mp = Mouse.Position;
			float sw = Screen.Width;
			float sh = Screen.Height;
			if ( sw > 0f && sh > 0f )
			{
				CursorXPercent = ( mp.x / sw ) * 100f;
				CursorYPercent = ( mp.y / sh ) * 100f;
			}

			if ( ShouldDropPickup() )
				ClearPickup();
		}

		if ( !IsUIOpen && ShowUnequipConfirm )
			OnConfirmUnequipNo();

		if ( IsChatOpen && ChatInputRef != null )
			ChatInputRef.Focus();

		if ( IsChatOpen && ( Input.Pressed( "menu" ) || Input.Pressed( "attack1" ) ) )
		{
			var gm = GameManager.Instance;
			if ( gm != null )
				gm.CloseChat();
			return;
		}

		if ( Input.Pressed( "Chat" ) )
		{
			if ( LogTab == 1 )
				LogTab = 0;
		}
	}

	protected override int BuildHash()
	{
		RefreshData();

		if ( !_hasInitialized )
		{
			var player = PlayerHelper.GetLocalPlayer();
			if ( player != null && CurrentHealth > 0 )
				_hasInitialized = true;
			else
				return ( Time.Now, _hasInitialized ).GetHashCode();
		}

		int skillHash = 0;
		foreach ( var s in SkillEntries )
			skillHash += s.Level * 1000 + s.Xp;

		int buffHash = 0;
		foreach ( var b in ActiveBuffs )
			buffHash += (int)b.Type * 100 + (int)b.Remaining;

		int slotHash = 0;
		for ( int i = 0; i < CachedSlots.Count; i++ )
		{
			var slot = CachedSlots[i];
			if ( slot.IsUnique )
				slotHash = HashCode.Combine( slotHash, slot.ItemId, (int)( slot.Unique.EnchantmentPercent * 10 ), i, 1 );
			else if ( slot.IsStack )
				slotHash = HashCode.Combine( slotHash, slot.ItemId, slot.Count, i, 0 );
			else
				slotHash = HashCode.Combine( slotHash, i, -1 );
		}

		int gearHash = HashCode.Combine( EquippableItems.Count, EnchantLines.Count, StatAttack, StatDefence, StatArchery, StatMagic, StatArmor, StatWeaponPower );
		foreach ( var e in EquipmentSlots )
			gearHash = HashCode.Combine( gearHash, (int)e.Slot, e.ItemName ?? "", e.EnchantStat ?? "" );

		int chatCount = GameManager.Instance != null ? GameManager.Instance.ChatMessages.Count : 0;

		return (
			TotalSlots,
			slotHash,
			skillHash,
			buffHash,
			CurrentHealth,
			MaxHealth,
			CurrentMana,
			MaxMana,
			IsDrinking,
			IsHealTicking,
			(int)PotionCooldownRemaining,
			gearHash,
			PlayerGatherResource.UIOpen,
			GameLog.Messages.Count,
			chatCount,
			LogTab,
			IsChatOpen,
			PickedUpSlotIndex,
			ActiveTab,
			ShowUnequipConfirm,
			(int)CursorXPercent,
			(int)CursorYPercent,
			HudState.InventoryCollapsed
		).GetHashCode();
	}
}
