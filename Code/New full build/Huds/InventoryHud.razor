@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsUIOpen )
	{
		<div class="ui-backdrop" onclick="@OnBackdropClick"></div>
	}

	<div class="log-panel @(IsUIOpen ? "ui-open" : "") @(IsChatOpen ? "chat-open" : "")">
		<div class="log-tabs">
			<div class="log-tab @(LogTab == 0 ? "active" : "")" onclick="@(() => LogTab = 0)">All</div>
			<div class="log-tab @(LogTab == 1 ? "active" : "")" onclick="@(() => LogTab = 1)">Log</div>
			<div class="log-tab @(LogTab == 2 ? "active" : "")" onclick="@(() => LogTab = 2)">Chat</div>
		</div>

		@if ( LogTab == 0 )
		{
			<div class="chat-entries">
				@foreach ( var entry in GetCombinedFeed().AsEnumerable().Reverse() )
				{
					@if ( entry.IsChat )
					{
						<div class="chat-entry">
							<span class="chat-sender">@entry.Sender:</span>
							<span style="color: #e8e8e8;"> @entry.Text</span>
						</div>
					}
					else
					{
						<div class="chat-entry" style="color: @entry.Color;">@entry.Text</div>
					}
				}
			</div>
		}

		@if ( LogTab == 1 )
		{
			<div class="chat-entries">
				@foreach ( var msg in GetVisibleMessages().AsEnumerable().Reverse() )
				{
					<div class="chat-entry" style="color: @msg.Color;">@msg.Text</div>
				}
			</div>
		}

		@if ( LogTab == 2 )
		{
			<div class="chat-entries">
				@foreach ( var msg in GetChatMessages().AsEnumerable().Reverse() )
				{
					@if ( !string.IsNullOrEmpty( msg.Sender ) )
					{
						<div class="chat-entry">
							<span class="chat-sender">@msg.Sender:</span>
							<span style="color: #e8e8e8;"> @msg.Text</span>
						</div>
					}
					else
					{
						<div class="chat-entry" style="color: #f0c040;">@msg.Text</div>
					}
				}
			</div>
		}

		@if ( IsChatOpen )
		{
			<div class="chat-input-row">
				<TextEntry class="chat-input-field" @ref="ChatInputRef" Value:bind="@ChatText" onsubmit="@OnChatSubmit"></TextEntry>
			</div>
		}
	</div>

	<div class="side-panel @(IsUIOpen ? "ui-open" : "")">

		<div class="health-section">
			<div class="health-bar-container">
				<div class="health-bar-fill" style="width: @HealthPercent%;"></div>
				<div class="health-bar-text">@CurrentHealth / @MaxHealth HP</div>
			</div>
			<div class="mana-bar-container">
				<div class="mana-bar-fill" style="width: @ManaPercent%;"></div>
				<div class="mana-bar-text">@CurrentMana / @MaxMana MP @(IsDrinking ? "— Drinking..." : "")</div>
			</div>
			@if ( ActiveBuffs.Count > 0 || ManaSicknessRemaining > 0 || PotionCooldownRemaining > 0 )
			{
				<div class="buff-row">
					@foreach ( var buff in ActiveBuffs )
					{
						<div class="buff-icon" style="background: @GetBuffColor( buff.Type );">
							<div class="buff-timer">@((int)buff.Remaining)s</div>
							<div class="buff-tooltip">@buff.Type +@((int)buff.Percent)%</div>
						</div>
					}
					@if ( ManaSicknessRemaining > 0 )
					{
						<div class="buff-icon mana-sickness-icon">
							<div class="buff-icon-symbol">💧</div>
							<div class="buff-timer">@((int)ManaSicknessRemaining)s</div>
							<div class="buff-tooltip">Mana Sickness — -25% magic damage</div>
						</div>
					}
					@if ( PotionCooldownRemaining > 0 )
					{
						<div class="buff-icon potion-cooldown-icon">
							<div class="buff-icon-symbol">🚫</div>
							<div class="buff-timer">@((int)PotionCooldownRemaining)s</div>
							<div class="buff-tooltip">Potion Cooldown</div>
						</div>
					}
				</div>
			}
			@if ( IsHealTicking )
			{
				<div class="healing-indicator">Healing...</div>
			}
		</div>

		<div class="tabs">
			<div class="tab @(ActiveTab == 0 ? "active" : "")" onclick="@(() => ActiveTab = 0)">Gear</div>
			<div class="tab @(ActiveTab == 1 ? "active" : "")" onclick="@(() => ActiveTab = 1)">Items</div>
			<div class="tab @(ActiveTab == 2 ? "active" : "")" onclick="@(() => ActiveTab = 2)">Skills</div>
		</div>

		<div class="panel-content">

			@if ( ActiveTab == 1 )
			{
				<div class="inventory-grid">
					@for ( int i = 0; i < TotalSlots; i++ )
					{
						var slotIndex = i;
						var slotData = GetSlotData( slotIndex );
						bool isHotbar = slotIndex < HotbarSize;
						bool isPickedFrom = PickedUpSlotIndex == slotIndex;
						bool isEquipped = slotData != null && slotData.IsEquipped;
						string equipBadge = slotData != null ? slotData.EquipBadge : "";

						@if ( slotData != null && slotData.IsUnique )
						{
							var inst = slotData.Unique;
							var def = ItemDatabase.Get( inst.ItemId );
							bool hasMagicBackground = inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 );
							string color = hasMagicBackground ? "#a080d0" : GetItemColor( inst.ItemId, def );

							<div class="item-slot filled equippable @(isHotbar ? "hotbar" : "") @(isPickedFrom ? "picked-up" : "") @(isEquipped ? "is-equipped" : "") @(IsRecentlyReceived( inst.ItemId ) ? "just-received" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
								@if ( isEquipped )
								{
									<div class="equipped-badge">@equipBadge</div>
								}
								<div class="item-icon" style="background: @color;">
									<img class="item-icon-img" src="@GetIconPath( inst.ItemId )" />
								</div>
								@if ( inst.IsEnchanted || ( inst.IsSocketable && inst.SocketsUsed > 0 ) )
								{
									<div class="item-enchant">@inst.GetShortStat()</div>
								}
								<div class="use-button equip-button"
									 onclick="@(() => OnUseButtonClick( slotIndex ))">⚡</div>
								<div class="item-tooltip">
									@inst.GetDisplayName()
									<div class="tooltip-hint">Click slot to move · Click ⚡ to @(isEquipped ? "unequip" : "equip")</div>
								</div>
							</div>
						}
						else if ( slotData != null && slotData.IsStack )
						{
							bool isPotion = ItemDatabase.Get( slotData.ItemId )?.Type == ItemType.Potion;
							bool isArrow = ItemDatabase.Get( slotData.ItemId )?.Type == ItemType.Arrow;
							bool hasUseBtn = isPotion || isArrow;

							<div class="item-slot filled @(isPotion ? "potion-slot" : "") @(isHotbar ? "hotbar" : "") @(isPickedFrom ? "picked-up" : "") @(isEquipped ? "is-equipped" : "") @(IsRecentlyReceived( slotData.ItemId ) ? "just-received" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
								@if ( isEquipped )
								{
									<div class="equipped-badge">@equipBadge</div>
								}
								<div class="item-icon" style="background: @slotData.Color;">
									<img class="item-icon-img" src="@GetIconPath( slotData.ItemId )" />
								</div>
								@if ( slotData.Count > 1 )
								{
									<div class="item-count">@slotData.Count</div>
								}
								@if ( hasUseBtn )
								{
									<div class="use-button @(isPotion ? "potion-button" : "arrow-button")"
										 onclick="@(() => OnUseButtonClick( slotIndex ))">@(isPotion ? "🍶" : "🏹")</div>
								}
								<div class="item-tooltip">
									@slotData.Name x@(slotData.Count)
									@if ( isPotion )
									{
										<div class="tooltip-hint">Click slot to move · Click 🍶 to drink</div>
									}
									else if ( isArrow )
									{
										<div class="tooltip-hint">Click slot to move · Click 🏹 to @(isEquipped ? "unequip" : "equip")</div>
									}
									else
									{
										<div class="tooltip-hint">Click to pick up</div>
									}
								</div>
							</div>
						}
						else
						{
							<div class="item-slot @(isHotbar ? "hotbar" : "")"
								 onclick="@(() => OnSlotLeftClick( slotIndex ))">
								@if ( isHotbar )
								{
									<div class="hotbar-key">@(slotIndex + 1)</div>
								}
							</div>
						}
					}
				</div>
			}

			@if ( ActiveTab == 2 )
			{
				<div class="skills-list">
					@foreach ( var skill in SkillEntries )
					{
						<div class="skill-row">
							<div class="skill-level">@skill.Level</div>
							<div class="skill-icon-box">@skill.Icon</div>
							<div class="skill-name">@skill.Name</div>
							<div class="xp-bar">
								<div class="xp-fill @(skill.CssClass)-fill" style="width: @skill.XpPercent%;"></div>
							</div>
							<div class="skill-tooltip">
								<div class="skill-tooltip-name">@skill.Name</div>
								<div class="skill-tooltip-line">Level @skill.Level</div>
								<div class="skill-tooltip-line">XP: @skill.Xp / @skill.XpRequired</div>
								<div class="skill-tooltip-line skill-tooltip-remaining">@(skill.XpRequired - skill.Xp) XP to next level</div>
							</div>
						</div>
					}
				</div>
			}

			@if ( ActiveTab == 0 )
			{
				<div class="equipped-panel">
					@foreach ( var slot in EquipmentSlots )
					{
						<div class="equip-slot-row" onclick="@(() => OnEquipSlotClick( slot ))">
							<div class="equip-label">@slot.Label</div>
							@if ( slot.ItemName != null )
							{
								<div class="equip-slot filled clickable">
									<div class="item-icon" style="background: @slot.Color;">
										<img class="item-icon-img" src="@GetIconPath( slot.ItemId )" />
									</div>
									<div class="equip-name">@slot.ItemName</div>
									@if ( !string.IsNullOrEmpty( slot.EnchantStat ) )
									{
										<div class="equip-enchant">@slot.EnchantStat</div>
									}
								</div>
							}
							else
							{
								<div class="equip-slot">
									<div class="equip-name empty">— empty —</div>
								</div>
							}
						</div>
					}
				</div>
			}

		</div>
	</div>

	@if ( PickedUpSlotIndex >= 0 && PickedUpGhost != null )
	{
		<div class="pickup-ghost" style="left: @(CursorXPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(CursorYPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: @PickedUpGhost.Color;">
			<img class="pickup-ghost-img" src="@GetIconPath( PickedUpGhost.ItemId )" />
			@if ( PickedUpGhost.Count > 1 )
			{
				<div class="pickup-ghost-count">@PickedUpGhost.Count</div>
			}
		</div>
	}
</root>

@code
{
	const int HotbarSize = 5;

	int ActiveTab { get; set; } = 1;
	int LogTab { get; set; } = 0;
	bool _hasInitialized = false;

	int PickedUpSlotIndex { get; set; } = -1;
	GhostDisplay PickedUpGhost { get; set; }
	float CursorXPercent { get; set; } = 0;
	float CursorYPercent { get; set; } = 0;

	bool _suppressNextSlotClick = false;

	bool IsUIOpen => PlayerGatherResource.UIOpen;

	TextEntry ChatInputRef { get; set; }
	string ChatText { get; set; } = "";

	bool IsChatOpen
	{
		get
		{
			var gm = GameManager.Instance;
			return gm != null && gm.ChatOpen;
		}
	}

	System.Collections.Generic.List<GameManager.ChatMessage> GetChatMessages()
	{
		var gm = GameManager.Instance;
		if ( gm == null )
			return new();

		return gm.ChatMessages;
	}

	public class FeedEntry
	{
		public bool IsChat;
		public string Text;
		public string Color;
		public string Sender;
		public float CreatedValue;
		public long Sequence;
	}

	List<FeedEntry> GetCombinedFeed()
	{
		var feed = new List<FeedEntry>();

		foreach ( var msg in GameLog.Messages )
		{
			feed.Add( new FeedEntry
			{
				IsChat = false,
				Text = msg.Text,
				Color = msg.Color,
				Sender = null,
				CreatedValue = (float)msg.Created,
				Sequence = msg.Sequence
			} );
		}

		var chats = GetChatMessages();
		foreach ( var msg in chats )
		{
			if ( string.IsNullOrEmpty( msg.Sender ) )
				continue;

			feed.Add( new FeedEntry
			{
				IsChat = true,
				Text = msg.Text,
				Color = null,
				Sender = msg.Sender,
				CreatedValue = (float)msg.Created,
				Sequence = msg.Sequence
			} );
		}

		feed.Sort( ( a, b ) =>
		{
			int cmp = b.CreatedValue.CompareTo( a.CreatedValue );
			if ( cmp != 0 )
				return cmp;

			cmp = a.IsChat.CompareTo( b.IsChat );
			if ( cmp != 0 )
				return cmp;

			return a.Sequence.CompareTo( b.Sequence );
		} );

		return feed;
	}

	void OnChatSubmit()
	{
		var gm = GameManager.Instance;
		if ( gm == null )
			return;

		if ( !string.IsNullOrWhiteSpace( ChatText ) )
			gm.SendChat( ChatText );

		ChatText = "";
		gm.CloseChat();
	}

	int CurrentHealth { get; set; }
	int MaxHealth { get; set; } = 100;
	int HealthPercent { get; set; } = 100;
	int CurrentMana { get; set; }
	int MaxMana { get; set; }
	int ManaPercent { get; set; }
	bool IsDrinking { get; set; }
	bool IsHealTicking { get; set; }
	float ManaSicknessRemaining { get; set; }
	float PotionCooldownRemaining { get; set; }
	List<ActiveBuff> ActiveBuffs { get; set; } = new();

	List<SlotData> CachedSlots { get; set; } = new();
	List<SkillDisplay> SkillEntries { get; set; } = new();
	List<EquipSlotDisplay> EquipmentSlots { get; set; } = new();

	int TotalSlots { get; set; } = 30;

	public class SlotData
	{
		public bool IsStack;
		public bool IsUnique;
		public ItemId ItemId;
		public int Count;
		public string Name;
		public string Color;
		public ItemInstance Unique;
		public bool IsEquipped;
		public string EquipBadge;
	}

	public class GhostDisplay
	{
		public ItemId ItemId;
		public int Count;
		public string Color;
	}

	public class SkillDisplay
	{
		public string Name;
		public string Icon;
		public string CssClass;
		public int Level;
		public int Xp;
		public int XpRequired;
		public int XpPercent;
	}

	public class EquipSlotDisplay
	{
		public string Label;
		public string ItemName;
		public string Color;
		public EquipSlot Slot;
		public string EnchantStat;
		public ItemId ItemId;
	}

	string GetIconPath( ItemId id )
	{
		if ( id == ItemId.None )
			return "";

		return $"/ItemIcons/{id}.vtex";
	}

	bool IsRecentlyReceived( ItemId id )
	{
		return ItemPickupEffect.IsRecentlyReceived( id );
	}

	SlotData GetSlotData( int index )
	{
		if ( index < 0 || index >= CachedSlots.Count )
			return null;

		return CachedSlots[index];
	}

	string GetBadgeForEquipSlot( EquipSlot slot )
	{
		switch ( slot )
		{
			case EquipSlot.Weapon: return "⚔";
			case EquipSlot.Shield: return "🛡";
			case EquipSlot.Head: return "⛑";
			case EquipSlot.Chest: return "🎽";
			case EquipSlot.Legs: return "👖";
			case EquipSlot.Ring: return "💍";
			case EquipSlot.Amulet: return "📿";
			case EquipSlot.Ammo: return "🏹";
			default: return "★";
		}
	}

	void OnSlotLeftClick( int slotIndex )
	{
		if ( _suppressNextSlotClick )
		{
			_suppressNextSlotClick = false;
			return;
		}

		var inventory = PlayerHelper.GetLocalInventory();
		if ( inventory == null )
			return;

		if ( PickedUpSlotIndex < 0 )
		{
			var slot = inventory.GetSlot( slotIndex );
			if ( slot == null || slot.IsEmpty )
				return;

			PickedUpSlotIndex = slotIndex;
			RefreshGhost( inventory );
			return;
		}

		if ( PickedUpSlotIndex == slotIndex )
		{
			ClearPickup();
			return;
		}

		inventory.SwapSlots( PickedUpSlotIndex, slotIndex );
		ClearPickup();
	}

	void OnUseButtonClick( int slotIndex )
	{
		_suppressNextSlotClick = true;

		var inventory = PlayerHelper.GetLocalInventory();
		if ( inventory == null )
			return;

		if ( PickedUpSlotIndex >= 0 )
			ClearPickup();

		var slot = inventory.GetSlot( slotIndex );
		if ( slot == null || slot.IsEmpty )
			return;

		if ( slot.IsUnique )
		{
			if ( inventory.IsSlotEquipped( slotIndex ) )
			{
				var equipType = inventory.GetEquippedSlotTypeAt( slotIndex );
				if ( equipType != EquipSlot.None )
					inventory.UnequipUnique( equipType );
			}
			else
			{
				inventory.EquipUniqueAtSlot( slotIndex );
			}
			return;
		}

		var def = ItemDatabase.Get( slot.ItemId );
		if ( def == null )
			return;

		if ( def.Type == ItemType.Potion )
		{
			var potionSystem = PlayerHelper.GetLocalPlayer()?.Components.Get<PotionSystem>();
			if ( potionSystem != null )
				potionSystem.TryDrinkPotionFromSlot( slotIndex );
			return;
		}

		if ( def.Type == ItemType.Arrow )
		{
			if ( inventory.GetEquippedAmmoSlotIndex() == slotIndex )
				inventory.UnequipAmmo();
			else
				inventory.EquipAmmoFromSlot( slotIndex );
			return;
		}
	}

	void ClearPickup()
	{
		PickedUpSlotIndex = -1;
		PickedUpGhost = null;
	}

	void OnBackdropClick()
	{
		if ( PickedUpSlotIndex >= 0 )
		{
			ClearPickup();
			return;
		}

		if ( ShopStation.ActiveShop != null || ShopStation.ShowingChoice ) return;
		if ( BankStation.ActiveBank != null ) return;
		if ( CraftingStation.ActiveStation != null ) return;
		if ( EnchantingStation.ActiveStation != null ) return;
		if ( TeleportStone.ActiveStone != null ) return;
		if ( NpcInteract.ActiveNpc != null ) return;
		if ( JournalStation.IsOpen ) return;
		if ( LeaderboardStation.IsOpen ) return;
		if ( SpellbookStation.IsOpen ) return;
		if ( MinimapState.IsFullMapOpen ) return;
		if ( WelcomeHudState.IsOpen ) return;

		PlayerGatherResource.ForceCloseUI();
	}

	void RefreshGhost( Inventory inventory )
	{
		if ( PickedUpSlotIndex < 0 )
		{
			PickedUpGhost = null;
			return;
		}

		var slot = inventory.GetSlot( PickedUpSlotIndex );
		if ( slot == null || slot.IsEmpty )
		{
			ClearPickup();
			return;
		}

		if ( slot.IsUnique )
		{
			var def = ItemDatabase.Get( slot.Unique.ItemId );
			bool ghostMagic = slot.Unique.IsEnchanted || ( slot.Unique.IsSocketable && slot.Unique.SocketsUsed > 0 );
			string color = ghostMagic ? "#a080d0" : GetItemColor( slot.Unique.ItemId, def );
			PickedUpGhost = new GhostDisplay
			{
				ItemId = slot.Unique.ItemId,
				Count = 1,
				Color = color
			};
			return;
		}

		var sdef = ItemDatabase.Get( slot.ItemId );
		PickedUpGhost = new GhostDisplay
		{
			ItemId = slot.ItemId,
			Count = slot.Count,
			Color = GetItemColor( slot.ItemId, sdef )
		};
	}

	void OnEquipSlotClick( EquipSlotDisplay slot )
	{
		if ( slot == null || slot.ItemName == null )
			return;

		var inventory = PlayerHelper.GetLocalInventory();
		if ( inventory == null )
			return;

		inventory.Unequip( slot.Slot );
	}

	string GetBuffColor( BuffType type )
	{
		switch ( type )
		{
			case BuffType.Attack: return "#c83030";
			case BuffType.Defence: return "#3060c8";
			case BuffType.Archery: return "#6a9830";
			case BuffType.Magic: return "#7830c8";
			case BuffType.AllDamage: return "#c9a84c";
			default: return "#888";
		}
	}

	List<GameLog.LogMessage> GetVisibleMessages()
	{
		return GameLog.Messages;
	}

	string GetItemColor( ItemId id, ItemDefinition def )
	{
		if ( def == null ) return "#888";

		switch ( def.Type )
		{
			case ItemType.Resource:
				if ( def.Name.Contains( "Log" ) ) return "#8B5E3C";
				if ( def.Name.Contains( "Ore" ) ) return "#b87333";
				if ( def.Name.Contains( "Stick" ) ) return "#a08050";
				if ( def.Name.Contains( "Rock" ) ) return "#7a7a8a";
				if ( def.Name.Contains( "Coal" ) ) return "#444";
				if ( def.Name.Contains( "Gem" ) ) return "#8ae";
				if ( def.Name.Contains( "Rune" ) ) return "#a080d0";
				return "#9a8";
			case ItemType.Bar: return "#d4a030";
			case ItemType.Herb: return "#5a9e4a";
			case ItemType.Tool: return "#8B6914";
			case ItemType.MeleeWeapon: return "#c0c0c0";
			case ItemType.RangedWeapon: return "#7a5230";
			case ItemType.MagicWeapon: return "#7a5aaa";
			case ItemType.Arrow: return "#9a7a5a";
			case ItemType.Shield: return "#6a7a8a";
			case ItemType.HeavyArmor: return "#8a8a9a";
			case ItemType.MediumArmor: return "#8a7a6a";
			case ItemType.LightArmor: return "#6a5a8a";
			case ItemType.Ring: return "#d4aa40";
			case ItemType.Amulet: return "#40aad4";
			case ItemType.Potion: return "#d44a4a";
			case ItemType.Misc:
				if ( id == ItemId.GoldCoin ) return "#f0c040";
				if ( id == ItemId.Nugget ) return "#f0c040";
				return "#888";
			default: return "#888";
		}
	}

	string GetSkillIcon( SkillType skill )
	{
		switch ( skill )
		{
			case SkillType.Woodcutting: return "🪓";
			case SkillType.Mining: return "⛏";
			case SkillType.Enchanting: return "🔮";
			case SkillType.Smithing: return "🔨";
			case SkillType.Crafting: return "🧵";
			case SkillType.Attack: return "⚔️";
			case SkillType.Defence: return "🛡";
			case SkillType.Archery: return "🏹";
			case SkillType.Magic: return "✨";
			default: return "?";
		}
	}

	string GetSkillCss( SkillType skill )
	{
		switch ( skill )
		{
			case SkillType.Woodcutting: return "wood";
			case SkillType.Mining: return "mine";
			case SkillType.Enchanting: return "enchant";
			case SkillType.Smithing: return "smith";
			case SkillType.Crafting: return "craft";
			case SkillType.Attack: return "attack";
			case SkillType.Defence: return "defence";
			case SkillType.Archery: return "archery";
			case SkillType.Magic: return "magic";
			default: return "combat";
		}
	}

	string GetSlotLabel( EquipSlot slot )
	{
		switch ( slot )
		{
			case EquipSlot.Weapon: return "Weapon";
			case EquipSlot.Shield: return "Shield";
			case EquipSlot.Head: return "Head";
			case EquipSlot.Chest: return "Chest";
			case EquipSlot.Legs: return "Legs";
			case EquipSlot.Ring: return "Ring";
			case EquipSlot.Amulet: return "Amulet";
			case EquipSlot.Ammo: return "Ammo";
			default: return "?";
		}
	}

	void RefreshData()
	{
		CachedSlots.Clear();
		SkillEntries.Clear();
		EquipmentSlots.Clear();
		ActiveBuffs.Clear();

		var inventory = PlayerHelper.GetLocalInventory();
		var skills = PlayerHelper.GetSkills( PlayerHelper.GetLocalPlayer() );
		var health = PlayerHelper.GetLocalPlayer()?.Components.Get<PlayerHealth>();
		var potions = PlayerHelper.GetLocalPlayer()?.Components.Get<PotionSystem>();
		var mana = PlayerHelper.GetLocalPlayer()?.Components.Get<ManaSystem>();

		if ( health != null )
		{
			CurrentHealth = health.CurrentHealth;
			MaxHealth = health.MaxHealth;
			HealthPercent = MaxHealth > 0 ? (int)( ( (float)CurrentHealth / MaxHealth ) * 100f ) : 0;
		}

		if ( mana != null )
		{
			CurrentMana = mana.CurrentMana;
			MaxMana = mana.MaxMana;
			ManaPercent = MaxMana > 0 ? (int)( ( (float)CurrentMana / MaxMana ) * 100f ) : 0;
			ManaSicknessRemaining = mana.ManaSicknessRemaining;
		}
		else
		{
			CurrentMana = 0;
			MaxMana = 0;
			ManaPercent = 0;
			ManaSicknessRemaining = 0f;
		}

		if ( potions != null )
		{
			IsDrinking = potions.IsDrinking;
			IsHealTicking = potions.IsHealTicking;
			PotionCooldownRemaining = potions.PotionCooldownRemaining;

			foreach ( var buff in potions.GetActiveBuffs() )
				ActiveBuffs.Add( buff );
		}
		else
		{
			IsDrinking = false;
			IsHealTicking = false;
			PotionCooldownRemaining = 0f;
		}

		if ( inventory != null )
		{
			TotalSlots = inventory.MaxSlots;

			var rawSlots = inventory.GetSlots();
			for ( int i = 0; i < inventory.MaxSlots; i++ )
			{
				var src = rawSlots[i];
				var data = new SlotData();

				if ( src.IsUnique )
				{
					data.IsUnique = true;
					data.Unique = src.Unique;
					data.ItemId = src.Unique.ItemId;
					data.Count = 1;
					var def = ItemDatabase.Get( src.Unique.ItemId );
					data.Name = def != null ? def.Name : src.Unique.ItemId.ToString();
					bool srcMagic = src.Unique.IsEnchanted || ( src.Unique.IsSocketable && src.Unique.SocketsUsed > 0 );
					data.Color = srcMagic ? "#a080d0" : GetItemColor( src.Unique.ItemId, def );
				}
				else if ( src.IsStack )
				{
					data.IsStack = true;
					data.ItemId = src.ItemId;
					data.Count = src.Count;
					var def = ItemDatabase.Get( src.ItemId );
					data.Name = def != null ? def.Name : src.ItemId.ToString();
					data.Color = GetItemColor( src.ItemId, def );
				}

				if ( inventory.IsSlotEquipped( i ) )
				{
					data.IsEquipped = true;
					var equipType = inventory.GetEquippedSlotTypeAt( i );
					data.EquipBadge = GetBadgeForEquipSlot( equipType );
				}

				CachedSlots.Add( data );
			}

			EquipSlot[] equipSlots = { EquipSlot.Weapon, EquipSlot.Shield, EquipSlot.Head, EquipSlot.Chest, EquipSlot.Legs, EquipSlot.Ring, EquipSlot.Amulet, EquipSlot.Ammo };
			foreach ( var slot in equipSlots )
			{
				if ( slot == EquipSlot.Ammo )
				{
					var ammoId = inventory.GetEquippedAmmoId();
					if ( ammoId != ItemId.None )
					{
						var ammoDef = ItemDatabase.Get( ammoId );
						int ammoCount = inventory.GetEquippedAmmoCount();
						EquipmentSlots.Add( new EquipSlotDisplay
						{
							Label = GetSlotLabel( slot ),
							ItemName = ammoDef != null ? $"{ammoDef.Name} x{ammoCount}" : ammoId.ToString(),
							Color = GetItemColor( ammoId, ammoDef ),
							Slot = slot,
							EnchantStat = "",
							ItemId = ammoId
						} );
					}
					else
					{
						EquipmentSlots.Add( new EquipSlotDisplay
						{
							Label = GetSlotLabel( slot ),
							ItemName = null,
							Color = null,
							Slot = slot,
							EnchantStat = "",
							ItemId = ItemId.None
						} );
					}
					continue;
				}

				var equippedUnique = inventory.GetEquippedUnique( slot );
				if ( equippedUnique != null )
				{
					var uDef = ItemDatabase.Get( equippedUnique.ItemId );
					bool eqMagic = equippedUnique.IsEnchanted || ( equippedUnique.IsSocketable && equippedUnique.SocketsUsed > 0 );
					string color = eqMagic ? "#a080d0" : GetItemColor( equippedUnique.ItemId, uDef );
					string baseName = uDef != null ? uDef.Name : equippedUnique.ItemId.ToString();

					EquipmentSlots.Add( new EquipSlotDisplay
					{
						Label = GetSlotLabel( slot ),
						ItemName = baseName,
						Color = color,
						Slot = slot,
						EnchantStat = equippedUnique.GetShortStat(),
						ItemId = equippedUnique.ItemId
					} );
					continue;
				}

				EquipmentSlots.Add( new EquipSlotDisplay
				{
					Label = GetSlotLabel( slot ),
					ItemName = null,
					Color = null,
					Slot = slot,
					EnchantStat = "",
					ItemId = ItemId.None
				} );
			}

			if ( PickedUpSlotIndex >= 0 )
			{
				if ( PickedUpSlotIndex >= inventory.MaxSlots )
				{
					ClearPickup();
				}
				else
				{
					var heldSlot = inventory.GetSlot( PickedUpSlotIndex );
					if ( heldSlot == null || heldSlot.IsEmpty )
						ClearPickup();
					else
						RefreshGhost( inventory );
				}
			}
		}

		if ( skills != null )
		{
			SkillType[] allSkills = { SkillType.Woodcutting, SkillType.Mining, SkillType.Enchanting, SkillType.Smithing, SkillType.Crafting, SkillType.Attack, SkillType.Defence, SkillType.Archery, SkillType.Magic };

			foreach ( var skill in allSkills )
			{
				int level = skills.GetLevel( skill );
				int xp = skills.GetXp( skill );
				int required = skills.GetXpRequired( skill );
				int percent = required > 0 ? (int)( ( (float)xp / required ) * 100f ) : 0;

				SkillEntries.Add( new SkillDisplay
				{
					Name = skill.ToString(),
					Icon = GetSkillIcon( skill ),
					CssClass = GetSkillCss( skill ),
					Level = level,
					Xp = xp,
					XpRequired = required,
					XpPercent = percent
				} );
			}
		}
	}

	bool ShouldDropPickup()
	{
		if ( !IsUIOpen )
			return true;

		if ( ShopStation.ActiveShop != null || ShopStation.ShowingChoice )
			return true;
		if ( BankStation.ActiveBank != null )
			return true;
		if ( CraftingStation.ActiveStation != null )
			return true;
		if ( EnchantingStation.ActiveStation != null )
			return true;
		if ( TeleportStone.ActiveStone != null )
			return true;
		if ( NpcInteract.ActiveNpc != null )
			return true;
		if ( JournalStation.IsOpen )
			return true;
		if ( LeaderboardStation.IsOpen )
			return true;
		if ( SpellbookStation.IsOpen )
			return true;
		if ( MinimapState.IsFullMapOpen )
			return true;
		if ( WelcomeHudState.IsOpen )
			return true;

		return false;
	}

	protected override void OnUpdate()
	{
		StateHasChanged();

		if ( PickedUpSlotIndex >= 0 )
		{
			var mp = Mouse.Position;
			float sw = Screen.Width;
			float sh = Screen.Height;
			if ( sw > 0f && sh > 0f )
			{
				CursorXPercent = ( mp.x / sw ) * 100f;
				CursorYPercent = ( mp.y / sh ) * 100f;
			}

			if ( ShouldDropPickup() )
				ClearPickup();
		}

		if ( IsChatOpen && ChatInputRef != null )
			ChatInputRef.Focus();

		if ( IsChatOpen && ( Input.Pressed( "menu" ) || Input.Pressed( "attack1" ) ) )
		{
			var gm = GameManager.Instance;
			if ( gm != null )
				gm.CloseChat();
			return;
		}

		if ( Input.Pressed( "Chat" ) )
		{
			if ( LogTab == 1 )
				LogTab = 0;
		}
	}

	protected override int BuildHash()
	{
		RefreshData();

		if ( !_hasInitialized )
		{
			var player = PlayerHelper.GetLocalPlayer();
			if ( player != null && CurrentHealth > 0 )
				_hasInitialized = true;
			else
				return ( Time.Now, _hasInitialized ).GetHashCode();
		}

		int skillHash = 0;
		foreach ( var s in SkillEntries )
			skillHash += s.Level * 1000 + s.Xp;

		int buffHash = 0;
		foreach ( var b in ActiveBuffs )
			buffHash += (int)b.Type * 100 + (int)b.Remaining;

		int slotHash = 0;
		for ( int i = 0; i < CachedSlots.Count; i++ )
		{
			var slot = CachedSlots[i];
			int eq = slot.IsEquipped ? 1 : 0;
			if ( slot.IsUnique )
				slotHash = HashCode.Combine( slotHash, slot.ItemId, (int)( slot.Unique.EnchantmentPercent * 10 ), i, 1, eq );
			else if ( slot.IsStack )
				slotHash = HashCode.Combine( slotHash, slot.ItemId, slot.Count, i, 0, eq );
			else
				slotHash = HashCode.Combine( slotHash, i, -1 );
		}

		int chatCount = GameManager.Instance != null ? GameManager.Instance.ChatMessages.Count : 0;

		return (
			TotalSlots,
			slotHash,
			skillHash,
			buffHash,
			CurrentHealth,
			MaxHealth,
			CurrentMana,
			MaxMana,
			IsDrinking,
			IsHealTicking,
			(int)ManaSicknessRemaining,
			(int)PotionCooldownRemaining,
			EquipmentSlots.Count > 0 ? EquipmentSlots[0].ItemName ?? "" : "",
			PlayerGatherResource.UIOpen,
			GameLog.Messages.Count,
			chatCount,
			LogTab,
			IsChatOpen,
			PickedUpSlotIndex,
			(int)CursorXPercent,
			(int)CursorYPercent
		).GetHashCode();
	}
}
