	{
		if ( def == null ) return "#888";

		switch ( def.Type )
		{
			case ItemType.Resource:
				if ( def.Name.Contains( "Log" ) ) return "#8B5E3C";
				if ( def.Name.Contains( "Ore" ) ) return "#b87333";
				if ( def.Name.Contains( "Stick" ) ) return "#a08050";
				if ( def.Name.Contains( "Rock" ) ) return "#7a7a8a";
				if ( def.Name.Contains( "Coal" ) ) return "#444";
				if ( def.Name.Contains( "Gem" ) ) return "#8ae";
				if ( def.Name.Contains( "Rune" ) ) return "#a080d0";
				return "#9a8";
			case ItemType.Bar: return "#d4a030";
			case ItemType.Herb: return "#5a9e4a";
			case ItemType.Tool: return "#8B6914";
			case ItemType.MeleeWeapon: return "#c0c0c0";
			case ItemType.RangedWeapon: return "#7a5230";
			case ItemType.MagicWeapon: return "#7a5aaa";
			case ItemType.Arrow: return "#9a7a5a";
			case ItemType.Shield: return "#6a7a8a";
			case ItemType.HeavyArmor: return "#8a8a9a";
			case ItemType.MediumArmor: return "#8a7a6a";
			case ItemType.LightArmor: return "#6a5a8a";
			case ItemType.Ring: return "#d4aa40";
			case ItemType.Amulet: return "#40aad4";
			case ItemType.Potion: return "#d44a4a";
			case ItemType.Misc:
				if ( id == ItemId.GoldCoin ) return "#f0c040";
				if ( id == ItemId.Nugget ) return "#f0c040";
				return "#888";
			default: return "#888";
