@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@inherits PanelComponent

<root>
	@if ( IsOpen )
	{
		<div class="menag-backdrop" onclick="@(() => Close())"></div>
		<div class="menag-popup">
			<div class="menag-header">
				<div class="menag-title">Menagerie</div>
				<div class="menag-close" onclick="@(() => Close())">✕</div>
			</div>

			@if ( ShowColorPicker )
			{
				<div class="menag-picker">
					<div class="menag-picker-label">Slime Color</div>
					<div class="color-picker-row">
						<div class="color-wheel-wrap" @ref="WheelPanel" onclick="@(() => OnWheelClick())">
							<img class="color-wheel-img" src="/UI/PetColorWheel.vtex" />
							<div class="color-wheel-cursor" style="left: @(CursorXPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; top: @(CursorYPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
						</div>
						<div class="color-value-bar" @ref="ValuePanel" onclick="@(() => OnValueClick())">
							<div class="color-value-marker" style="top: @(((1f - Val) * 100f).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
							@for ( int i = 0; i < 24; i++ )
							{
								<div class="color-value-band" style="background-color: @(BandColor( i ));"></div>
							}
						</div>
					</div>
					<div class="color-preview-row">
						<div class="color-preview" style="background-color: @(ToHex( ComposedColor ));"></div>
						<div class="color-buttons">
							<div class="color-btn" onclick="@(() => ApplyColor())">Apply</div>
							<div class="color-btn" onclick="@(() => ApplyRandom())">Random</div>
							<div class="color-btn" onclick="@(() => ShowColorPicker = false)">Back</div>
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="menag-book">
					<div class="menag-page left">
						@if ( SelectedPet != PetKind.None )
						{
							var def = PetDatabase.Get( SelectedPet );
							var tint = ResolvedPetColor();
							string bodyHex = ToHex( tint );
							string domeHex = ToHex( Color.Lerp( tint, Color.White, 0.35f ) );

							<div class="menag-name-row">
								<div class="menag-pet-name">@def.Name</div>
							</div>

							<div class="menag-portrait">
								<div class="menag-blob">
									<div class="menag-blob-body" style="background-color: @bodyHex;"></div>
									<div class="menag-blob-dome" style="background-color: @domeHex;"></div>
									<div class="menag-blob-shine"></div>
									<div class="menag-blob-eye l"></div>
									<div class="menag-blob-eye r"></div>
								</div>
							</div>

							<div class="menag-lore">"@def.Lore"</div>

							<div class="menag-detail"><div class="menag-dl">Trait</div><div class="menag-dv">Rideable mount</div></div>
							<div class="menag-detail"><div class="menag-dl">Found</div><div class="menag-dv">@def.FoundText</div></div>
							<div class="menag-detail"><div class="menag-dl">Riding</div><div class="menag-dv">Press E to mount</div></div>

							@if ( PetColorState.IsUnlocked() )
							{
								<div class="menag-detail"><div class="menag-dl">Color</div>
									<div class="menag-color-cell">
										<div class="menag-swatch" style="background-color: @bodyHex;"></div>
										<div class="menag-color-btn" onclick="@(() => ShowColorPicker = true)">Change color</div>
									</div>
								</div>
							}

							<div class="menag-spacer"></div>

							@if ( ActivePet == SelectedPet )
							{
								<div class="menag-action dismiss" onclick="@(() => Unsummon())">Dismiss</div>
							}
							else
							{
								<div class="menag-action summon" onclick="@(() => Summon( SelectedPet ))">Summon</div>
							}
						}
					</div>

					<div class="menag-gutter"></div>

					<div class="menag-page right">
						<div class="menag-list-label">COMPANIONS</div>

						@foreach ( var kind in OwnedPets )
						{
							var kindLocal = kind;
							var rdef = PetDatabase.Get( kindLocal );
							bool isActive = ActivePet == kindLocal;
							bool isSelected = SelectedPet == kindLocal;
							string glyphHex = kindLocal == PetKind.Slime ? ToHex( ResolvedPetColor() ) : rdef.IconColor;

							<div class="menag-row @(isSelected ? "selected" : "")" onclick="@(() => SelectPet( kindLocal ))">
								<div class="menag-row-blob" style="background-color: @glyphHex;"></div>
								<div class="menag-row-info">
									<div class="menag-row-name">@rdef.Name</div>
									<div class="menag-row-status @(isActive ? "active" : "")">@(isActive ? "Active companion" : "Resting")</div>
								</div>
							</div>
						}

						<div class="menag-spacer"></div>

						<div class="menag-footer">@OwnedPets.Count of @PetDatabase.AllPets.Length companions discovered</div>
					</div>
				</div>
			}
		</div>
	}
</root>

@code
{
	bool IsOpen => PetsStation.IsOpen;

	PetKind ActivePet => PetManager.Local != null ? PetManager.Local.ActiveSlot : PetKind.None;

	List<PetKind> OwnedPets => PetManager.Local != null ? PetManager.Local.Library : new List<PetKind>();

	PetKind SelectedPet { get; set; } = PetKind.None;

	bool ShowColorPicker { get; set; }
	float Hue { get; set; } = 120f;
	float Sat { get; set; } = 0.8f;
	float Val { get; set; } = 1f;

	Sandbox.UI.Panel WheelPanel { get; set; }
	Sandbox.UI.Panel ValuePanel { get; set; }

	Color ComposedColor => HsvToRgb( Hue, Sat, Val );

	float CursorXPct => 50f + MathF.Cos( Hue * MathF.PI / 180f ) * Sat * 50f;
	float CursorYPct => 50f + MathF.Sin( Hue * MathF.PI / 180f ) * Sat * 50f;

	Color ResolvedPetColor()
	{
		var overrideColor = PetColorState.GetColor();
		if ( overrideColor != null )
			return overrideColor.Value;

		var slime = PetManager.Local?.ActiveSlime?.Components.Get<PetSlime>();
		if ( slime != null )
			return PetDatabase.SlimeColorByIndex( slime.ColorIndex, 1f );

		return new Color( 0.22f, 0.85f, 0.29f );
	}

	void SelectPet( PetKind kind )
	{
		SelectedPet = kind;
	}

	void OnWheelClick()
	{
		if ( WheelPanel == null )
			return;

		var rect = WheelPanel.Box.Rect;
		if ( rect.Width <= 0f || rect.Height <= 0f )
			return;

		var mp = Mouse.Position;
		float dx = ( mp.x - rect.Left ) / rect.Width - 0.5f;
		float dy = ( mp.y - rect.Top ) / rect.Height - 0.5f;

		float r = MathF.Sqrt( dx * dx + dy * dy ) / 0.5f;
		if ( r > 1f ) r = 1f;

		Hue = ( MathF.Atan2( dy, dx ) * 180f / MathF.PI + 360f ) % 360f;
		Sat = r;
	}

	void OnValueClick()
	{
		if ( ValuePanel == null )
			return;

		var rect = ValuePanel.Box.Rect;
		if ( rect.Height <= 0f )
			return;

		var mp = Mouse.Position;
		float relY = ( mp.y - rect.Top ) / rect.Height;
		if ( relY < 0f ) relY = 0f;
		if ( relY > 1f ) relY = 1f;

		Val = 1f - relY;
	}

	void ApplyColor()
	{
		PetColorState.SetColor( ComposedColor );
		PetManager.Local?.ReapplyColor();
		ShowColorPicker = false;
	}

	void ApplyRandom()
	{
		PetColorState.SetColor( null );
		PetManager.Local?.ReapplyColor();
		ShowColorPicker = false;
	}

	static Color HsvToRgb( float hue, float sat, float val )
	{
		float c = val * sat;
		float hp = hue / 60f;
		float x = c * ( 1f - MathF.Abs( hp % 2f - 1f ) );
		float r = 0f, g = 0f, b = 0f;
		if ( hp < 1f ) { r = c; g = x; }
		else if ( hp < 2f ) { r = x; g = c; }
		else if ( hp < 3f ) { g = c; b = x; }
		else if ( hp < 4f ) { g = x; b = c; }
		else if ( hp < 5f ) { r = x; b = c; }
		else { r = c; b = x; }
		float m = val - c;
		return new Color( r + m, g + m, b + m );
	}

	static string ToHex( Color c )
	{
		return $"#{(int)( c.r * 255f ):X2}{(int)( c.g * 255f ):X2}{(int)( c.b * 255f ):X2}";
	}

	static string BandColor( int i )
	{
		return ToHex( Color.Lerp( Color.White, Color.Black, i / 23f ) );
	}

	void Summon( PetKind kind )
	{
		PetManager.Local?.Summon( kind );
	}

	void Unsummon()
	{
		PetManager.Local?.Unsummon();
	}

	void Close()
	{
		ShowColorPicker = false;
		PetsStation.Close();
	}

	protected override int BuildHash()
	{
		var owned = OwnedPets;
		if ( SelectedPet == PetKind.None || !owned.Contains( SelectedPet ) )
			SelectedPet = ActivePet != PetKind.None ? ActivePet : ( owned.Count > 0 ? owned[0] : PetKind.None );

		return HashCode.Combine(
			HashCode.Combine( PetsStation.IsOpen, SelectedPet, ActivePet, owned.Count ),
			HashCode.Combine( PetColorState.IsUnlocked(), ToHex( ResolvedPetColor() ) ),
			HashCode.Combine( ShowColorPicker, (int)( Hue * 10f ), (int)( Sat * 1000f ), (int)( Val * 1000f ) )
		);
	}
}
