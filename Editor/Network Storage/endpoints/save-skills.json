{
  "slug": "save-skills",
  "name": "Save Skills",
  "method": "POST",
  "description": "Writes the skills collection (level/xp per skill)",
  "enabled": true,
  "input": {
    "type": "object",
    "properties": {
      "entries": { "type": "object" }
    },
    "required": ["entries"]
  },
  "steps": [
    {
      "id": "save",
      "type": "write",
      "collection": "skills",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "entries", "value": "{{input.entries}}" }
      ]
    }
  ],
  "response": {
    "status": 200,
    "body": { "ok": true }
  }
}
