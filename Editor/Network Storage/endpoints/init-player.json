{
  "slug": "init-player",
  "name": "Initialize Player",
  "method": "POST",
  "description": "Create the first-time player row across all 8 collections with default values",
  "enabled": true,
  "input": {
    "type": "object",
    "properties": {
      "playerName": { "type": "string" }
    },
    "required": []
  },
  "steps": [
    {
      "id": "save_players",
      "type": "write",
      "collection": "players",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "version", "value": 1 },
        { "op": "set", "path": "savedAt", "value": "" },
        { "op": "set", "path": "playerName", "value": "{{input.playerName}}" },
        { "op": "set", "path": "currency", "value": 0 },
        { "op": "set", "path": "currentMana", "value": -1 },
        { "op": "set", "path": "totalLevel", "value": 0 },
        { "op": "set", "path": "totalGold", "value": 0 },
        { "op": "set", "path": "totalKills", "value": 0 },
        { "op": "set", "path": "nodesMined", "value": 0 },
        { "op": "set", "path": "inventoryExpansions", "value": 0 },
        { "op": "set", "path": "equippedAmmoId", "value": "None" },
        { "op": "set", "path": "equippedAmmoQty", "value": 0 },
        { "op": "set", "path": "equippedAmmoSlotIndex", "value": 0 }
      ]
    },
    {
      "id": "save_skills",
      "type": "write",
      "collection": "skills",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "entries", "value": {} }
      ]
    },
    {
      "id": "save_inventory",
      "type": "write",
      "collection": "inventory",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "slots", "value": [] }
      ]
    },
    {
      "id": "save_equipment",
      "type": "write",
      "collection": "equipment",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "equipped", "value": {} },
        { "op": "set", "path": "equippedSlotIndices", "value": {} }
      ]
    },
    {
      "id": "save_bank",
      "type": "write",
      "collection": "bank",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "stackables", "value": {} }
      ]
    },
    {
      "id": "save_bank_unique",
      "type": "write",
      "collection": "bank_unique",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "items", "value": [] }
      ]
    },
    {
      "id": "save_progression",
      "type": "write",
      "collection": "progression",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "recipes", "value": [] },
        { "op": "set", "path": "stones", "value": [] },
        { "op": "set", "path": "quests", "value": [] },
        { "op": "set", "path": "discoveredQuests", "value": [] },
        { "op": "set", "path": "unlockedSpells", "value": [] },
        { "op": "set", "path": "chestClaims", "value": {} }
      ]
    },
    {
      "id": "save_kills",
      "type": "write",
      "collection": "kills",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "counts", "value": {} }
      ]
    }
  ],
  "response": {
    "status": 200,
    "body": { "ok": true, "initialized": true }
  }
}
