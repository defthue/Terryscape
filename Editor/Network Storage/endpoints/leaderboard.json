{
  "slug": "leaderboard",
  "name": "Leaderboard",
  "method": "GET",
  "description": "Returns the global leaderboard record containing every player's summary entry",
  "enabled": true,
  "steps": [
    { "id": "board", "type": "read", "collection": "leaderboard_global", "key": "default" }
  ],
  "response": {
    "status": 200,
    "body": {
      "ok": true,
      "entriesByPlayer": "{{board.entriesByPlayer}}"
    }
  }
}
