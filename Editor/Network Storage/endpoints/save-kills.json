{
  "slug": "save-kills",
  "name": "Save Kills",
  "method": "POST",
  "description": "Writes the per-monster kill counts",
  "enabled": true,
  "input": {
    "type": "object",
    "properties": {
      "counts": { "type": "object" }
    },
    "required": ["counts"]
  },
  "steps": [
    {
      "id": "save",
      "type": "write",
      "collection": "kills",
      "key": "{{steamId}}_default",
      "ops": [
        { "op": "set", "path": "counts", "value": "{{input.counts}}" }
      ]
    }
  ],
  "response": {
    "status": 200,
    "body": { "ok": true }
  }
}
